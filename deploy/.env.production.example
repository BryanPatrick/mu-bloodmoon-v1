NODE_ENV=production
REAL_MONEY_PAYMENTS_ENABLED=false
NUXT_PUBLIC_REAL_MONEY_PAYMENTS_ENABLED=false

# Public URLs
WEB_PUBLIC_URL=https://seu-dominio.com
API_PUBLIC_URL=https://api.seu-dominio.com
NUXT_PUBLIC_API_BASE=https://api.seu-dominio.com/api
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Runtime ports inside the VPS
API_PORT=3333
PORT=3000

# MySQL/MariaDB
MYSQL_USER=bloodmoon
MYSQL_PASSWORD=troque-esta-senha
MYSQL_DATABASE=bloodmoon_portal
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
DATABASE_URL=mysql://bloodmoon:troque-esta-senha@mysql:3306/bloodmoon_portal

# Redis container
REDIS_URL=redis://redis:6379

# Authentication
JWT_ACCESS_SECRET=troque-por-um-segredo-longo
JWT_REFRESH_SECRET=troque-por-outro-segredo-longo
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
TWO_FACTOR_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria-exclusiva
SESSION_TTL_HOURS=24
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=seu-dominio.com,www.seu-dominio.com
TURNSTILE_TIMEOUT_MS=5000
TRUST_PROXY_HOPS=1
AUTH_RATE_RECOVERY_IP_LIMIT=10
AUTH_RATE_RECOVERY_IP_WINDOW_MS=900000
AUTH_RATE_RECOVERY_SUBJECT_LIMIT=3
AUTH_RATE_RECOVERY_SUBJECT_WINDOW_MS=900000
AUTH_PASSWORD_RESET_TTL_MINUTES=30
# Password recovery emails cannot be delivered until a transactional-email
# provider is approved and wired into MailTransportService -- see
# docs/handoff/auth-recovery-provider-blocker.md.

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/opt/bloodmoon/storage
COMMUNITY_MEDIA_DIR=/home/USUARIO/bloodmoon-storage/community-media
GUILD_MEDIA_DIR=/home/USUARIO/bloodmoon-storage/guild-media

# MU bridge: keep disabled until the real game database integration is audited.
MU_DATABASE_PROVIDER=sqlserver
MU_DATABASE_URL=sqlserver://user:password@host:1433;database=MuOnline;encrypt=false
MU_BRIDGE_ENABLED=false
MU_BRIDGE_WORKER_CONCURRENCY=1
MU_BRIDGE_LOCK_TIMEOUT_SECONDS=60

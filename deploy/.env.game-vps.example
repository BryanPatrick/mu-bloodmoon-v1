NODE_ENV=production

# Public URLs on the game VPS
WEB_PUBLIC_URL=https://mubloodmoon.com.br
API_PUBLIC_URL=http://127.0.0.1:3333
NUXT_PUBLIC_API_BASE=/api

# Runtime ports bound locally on the VPS
API_PORT=3333
PORT=3000

# Target mode
# Keep this explicit so deploy scripts and future code know this is not the old PostgreSQL VPS plan.
PORTAL_DATABASE_MODE=game_sqlserver

# SQL Server used by the MU server.
# Never expose this port publicly. Prefer localhost/private network on the same VPS.
MU_DATABASE_PROVIDER=sqlserver
MU_DATABASE_URL=sqlserver://user:password@127.0.0.1:1433;database=MuOnline;encrypt=false;trustServerCertificate=true

# Temporary portal database setting.
# The current Prisma schema is still PostgreSQL-based and must be migrated before this can point to SQL Server.
DATABASE_URL=postgresql://not-used-in-game-vps-plan

# Auth secrets for the new portal/API layer.
JWT_ACCESS_SECRET=troque-por-um-segredo-longo
JWT_REFRESH_SECRET=troque-por-outro-segredo-longo
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Storage on the game VPS
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=C:/BloodMoon/storage

# MU bridge
# Start disabled until we validate tables, procedures, locks and backups on the real VPS.
MU_BRIDGE_ENABLED=false
MU_BRIDGE_WORKER_CONCURRENCY=1
MU_BRIDGE_LOCK_TIMEOUT_SECONDS=60

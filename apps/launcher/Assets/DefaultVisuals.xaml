<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ImageBrush x:Key="Brush.DefaultEditorialEnvironment"
              ImageSource="pack://application:,,,/Assets/Defaults/editorial-environment.png"
              Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
  <ImageBrush x:Key="Brush.DefaultEditorialEnvironmentMuted"
              ImageSource="pack://application:,,,/Assets/Defaults/editorial-environment.png"
              Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" Opacity="0.12" />
  <ImageBrush x:Key="Brush.DefaultEditorialCard"
              ImageSource="pack://application:,,,/Assets/Defaults/editorial-card.png"
              Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
</ResourceDictionary>

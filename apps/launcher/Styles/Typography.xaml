<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Part AT/K—the four CMS font tokens map here to real local font
    resources. The CMS only ever sends the token name (FONT_TOKENS in
    slot-registry.ts: DISPLAY/SERIF/UI/COMPACT); it never sends a font
    family or a file. Georgia and Segoe UI are the two families already in
    use across the pre-existing dialogs (MainWindow.xaml)—DISPLAY/SERIF
    both map to Georgia (bold vs regular) rather than introducing a third
    family with no precedent in the app.
  -->
  <FontFamily x:Key="Font.Display">Georgia</FontFamily>
  <FontFamily x:Key="Font.Serif">Georgia</FontFamily>
  <FontFamily x:Key="Font.Ui">Segoe UI Semibold</FontFamily>
  <FontFamily x:Key="Font.Compact">Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Consolas</FontFamily>

  <!-- Base sizes for the FONT_SIZE_TOKENS axis (SM/MD/LG/XL/DISPLAY). -->
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.Sm">11</sys:Double>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.Md">13</sys:Double>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.Lg">16</sys:Double>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.Xl">22</sys:Double>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.Display">30</sys:Double>
</ResourceDictionary>

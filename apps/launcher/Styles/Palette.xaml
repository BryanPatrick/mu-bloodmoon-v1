<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Launcher Phase L3—Part AU's central style system, color layer.
    Every value here is EXTENDED FROM, not invented instead of, the colors
    already hardcoded across MainWindow.xaml and Assets/Placeholders.xaml
    before this phase (dark obsidian backgrounds #050505/#0B0908/#241F1D,
    crimson accents #B7131B/#D71920/#E12626, warm borders #4A4440/#7E3B2D,
    graduated muted text #F0E4D6 down to #746B64). GOLD/PURPLE/WARNING are
    the only genuinely new colors—the CMS's COLOR_TOKENS registry
    (apps/api .../launcher-studio/slot-registry.ts) already names them and
    nothing in the pre-existing app did, so they're chosen to sit
    consistently inside the same restrained, desaturated-metal palette,
    not as a guess at final brand art. Revisit once real reference
    screenshots/brand guide are available (docs/launcher/
    wpf-cms-binding.md's known-gap note).
  -->

  <!-- Backgrounds -->
  <Color x:Key="Color.BackgroundVoid">#050505</Color>
  <Color x:Key="Color.BackgroundShell">#0B0908</Color>
  <Color x:Key="Color.BackgroundPanel">#0F0C0A</Color>
  <Color x:Key="Color.BackgroundSurface">#170F0C</Color>
  <Color x:Key="Color.BackgroundSurfaceAlt">#241F1D</Color>

  <!-- Borders -->
  <Color x:Key="Color.BorderSubtle">#3E3733</Color>
  <Color x:Key="Color.BorderStrong">#4A4440</Color>
  <Color x:Key="Color.BorderWarm">#5E3028</Color>
  <Color x:Key="Color.BorderCrimson">#7E3B2D</Color>

  <!-- Text -->
  <Color x:Key="Color.TextPrimary">#F0E4D6</Color>
  <Color x:Key="Color.TextSecondary">#D7C1AA</Color>
  <Color x:Key="Color.TextMuted">#A69584</Color>
  <Color x:Key="Color.TextFaint">#746B64</Color>

  <!-- Brand / semantic accents -->
  <Color x:Key="Color.Crimson">#D71920</Color>
  <Color x:Key="Color.CrimsonDeep">#B7131B</Color>
  <Color x:Key="Color.CrimsonGlow">#E12626</Color>
  <Color x:Key="Color.Gold">#C9A227</Color>
  <Color x:Key="Color.Purple">#6B4C8A</Color>
  <Color x:Key="Color.Success">#63C879</Color>
  <Color x:Key="Color.Warning">#D98B3D</Color>
  <Color x:Key="Color.Danger">#CE5346</Color>

  <!-- Brushes (what XAML actually binds to) -->
  <SolidColorBrush x:Key="Brush.BackgroundVoid" Color="{StaticResource Color.BackgroundVoid}" />
  <SolidColorBrush x:Key="Brush.BackgroundShell" Color="{StaticResource Color.BackgroundShell}" />
  <SolidColorBrush x:Key="Brush.BackgroundPanel" Color="{StaticResource Color.BackgroundPanel}" />
  <SolidColorBrush x:Key="Brush.BackgroundSurface" Color="{StaticResource Color.BackgroundSurface}" />
  <SolidColorBrush x:Key="Brush.BackgroundSurfaceAlt" Color="{StaticResource Color.BackgroundSurfaceAlt}" />

  <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
  <SolidColorBrush x:Key="Brush.BorderWarm" Color="{StaticResource Color.BorderWarm}" />
  <SolidColorBrush x:Key="Brush.BorderCrimson" Color="{StaticResource Color.BorderCrimson}" />

  <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
  <SolidColorBrush x:Key="Brush.TextFaint" Color="{StaticResource Color.TextFaint}" />

  <SolidColorBrush x:Key="Brush.Crimson" Color="{StaticResource Color.Crimson}" />
  <SolidColorBrush x:Key="Brush.CrimsonDeep" Color="{StaticResource Color.CrimsonDeep}" />
  <SolidColorBrush x:Key="Brush.CrimsonGlow" Color="{StaticResource Color.CrimsonGlow}" />
  <SolidColorBrush x:Key="Brush.Gold" Color="{StaticResource Color.Gold}" />
  <SolidColorBrush x:Key="Brush.Purple" Color="{StaticResource Color.Purple}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />

  <!-- Crimson internal glow (Part: "selected page: deep crimson internal
       illumination")—a soft radial-ish glow via a layered brush, used
       behind the active nav item / active page indicator. -->
  <RadialGradientBrush x:Key="Brush.CrimsonGlowField" Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
    <GradientStop Offset="0" Color="#33D71920" />
    <GradientStop Offset="1" Color="#00D71920" />
  </RadialGradientBrush>
</ResourceDictionary>

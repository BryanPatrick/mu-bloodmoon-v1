<Window x:Class="BloodMoon.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BloodMoon Launcher"
        MinWidth="1024"
        MinHeight="600"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        Background="{StaticResource Brush.BackgroundVoid}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged">
  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="60" />
      <RowDefinition Height="*" />
      <RowDefinition Height="40" />
    </Grid.RowDefinitions>

    <!-- TOP FRAME: logo/drag area + window controls (Part: "preserve top frame; logo area; global window controls"). -->
    <Grid Grid.Row="0" Background="{StaticResource Brush.BackgroundShell}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0"
              Style="{StaticResource HotspotButton}"
              HorizontalContentAlignment="Left"
              ToolTip="Arraste para mover o launcher"
              PreviewMouseLeftButtonDown="DragArea_MouseLeftButtonDown">
        <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
          <Image x:Name="BrandLogoImage" Width="28" Height="28" Stretch="Uniform" />
          <TextBlock Text="BLOOD MOON"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource Brush.TextPrimary}"
                     FontFamily="{StaticResource Font.Display}"
                     FontWeight="Bold"
                     FontSize="{StaticResource FontSize.Lg}" />
        </StackPanel>
      </Button>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Width="48" Height="60" Style="{StaticResource HotspotButton}" ToolTip="Minimizar" Click="MinimizeButton_Click">
          <TextBlock Text="—" Foreground="{StaticResource Brush.TextMuted}" FontSize="14" />
        </Button>
        <Button Width="48" Height="60" Style="{StaticResource HotspotButton}" ToolTip="Fechar" Click="CloseButton_Click">
          <TextBlock Text="✕" Foreground="{StaticResource Brush.TextMuted}" FontSize="14" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- BODY: fixed-width nav rail + expandable page host (Part J: WIDE hands extra space to content, not the nav). -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavColumn" Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Background="{StaticResource Brush.BackgroundShell}">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,12,0,0">
          <ToggleButton x:Name="NavHome" Tag="Home" Content="INÍCIO" Style="{StaticResource NavItem}" IsChecked="True" Click="Nav_Click" />
          <ToggleButton x:Name="NavAccount" Tag="Account" Content="CONTA" Style="{StaticResource NavItem}" Click="Nav_Click" />
          <ToggleButton x:Name="NavNews" Tag="News" Content="NOTÍCIAS" Style="{StaticResource NavItem}" Click="Nav_Click" />
          <ToggleButton x:Name="NavEvents" Tag="Events" Content="EVENTOS" Style="{StaticResource NavItem}" Click="Nav_Click" />
          <ToggleButton x:Name="NavRanking" Tag="Ranking" Content="RANKING" Style="{StaticResource NavItem}" Click="Nav_Click" />
          <ToggleButton x:Name="NavStore" Tag="Store" Content="LOJA" Style="{StaticResource NavItem}" Click="Nav_Click" />
          <ToggleButton x:Name="NavSettings" Tag="Settings" Content="CONFIGURAÇÕES" Style="{StaticResource NavItem}" Click="Nav_Click" />
        </StackPanel>

        <Border Grid.Row="1" Margin="12" Padding="10" Background="{StaticResource Brush.BackgroundSurface}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1">
          <DockPanel>
            <Button x:Name="AccountActionButton" DockPanel.Dock="Bottom" Margin="0,8,0,0" Content="ENTRAR" Style="{StaticResource LauncherTextButton}" HorizontalAlignment="Left" Click="AccountActionButton_Click" />
            <StackPanel>
              <TextBlock x:Name="AccountGreetingText" Foreground="{StaticResource Brush.TextSecondary}" FontFamily="{StaticResource Font.Serif}" FontSize="13" Text="Entre com sua conta" />
              <TextBlock x:Name="AccountEmailText" Margin="0,3,0,0" Foreground="{StaticResource Brush.TextFaint}" FontSize="10" TextWrapping="Wrap" Text="Use a mesma conta do portal." />
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>

      <ContentControl x:Name="PageHost" Grid.Column="1" />
    </Grid>

    <!-- BOTTOM: updater/status bar (Part: "preserve bottom updater/status area"). -->
    <Grid Grid.Row="2" Background="{StaticResource Brush.BackgroundShell}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0" Margin="16,0" VerticalAlignment="Center">
        <TextBlock x:Name="ProgressStatusText" Foreground="{StaticResource Brush.TextSecondary}" FontFamily="{StaticResource Font.Compact}" FontSize="11" Text="Cliente pronto" VerticalAlignment="Center" />
        <TextBlock x:Name="ProgressDetailText" Margin="10,0,0,0" Foreground="{StaticResource Brush.TextFaint}" FontFamily="{StaticResource Font.Mono}" FontSize="9" TextTrimming="CharacterEllipsis" Text="Aguardando verificação" VerticalAlignment="Center" />
      </DockPanel>
      <Border Grid.Column="1" Height="8" Margin="0,0,16,0" VerticalAlignment="Center" Background="{StaticResource Brush.BackgroundSurface}" BorderBrush="{StaticResource Brush.BorderWarm}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ProgressFillColumn" Width="0*" />
            <ColumnDefinition x:Name="ProgressRemainderColumn" Width="100*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource Brush.Crimson}" />
        </Grid>
      </Border>
      <TextBlock Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextFaint}" FontFamily="{StaticResource Font.Compact}" FontSize="10" Text="© 2026 MU Online - Blood Moon" />
    </Grid>

    <!-- Toast -->
    <Border x:Name="Toast"
            Grid.Row="0" Grid.RowSpan="2"
            VerticalAlignment="Top" HorizontalAlignment="Center"
            Margin="0,70,0,0"
            Padding="16,11"
            Background="{StaticResource Brush.BackgroundPanel}"
            BorderBrush="{StaticResource Brush.BorderCrimson}"
            BorderThickness="1"
            Visibility="Collapsed">
      <TextBlock x:Name="ToastText" Foreground="{StaticResource Brush.TextPrimary}" FontFamily="{StaticResource Font.Ui}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480" />
    </Border>

    <!-- Login overlay -->
    <Grid x:Name="LoginOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#D8000000" Visibility="Collapsed">
      <Border Width="420" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource Brush.BackgroundPanel}" BorderBrush="{StaticResource Brush.BorderCrimson}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel>
            <StackPanel>
              <TextBlock Text="CONTA BLOODMOON" Foreground="{StaticResource Brush.TextPrimary}" FontFamily="{StaticResource Font.Display}" FontSize="20" FontWeight="Bold" />
              <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Brush.TextFaint}" FontSize="11" Text="Use a mesma conta do portal." />
            </StackPanel>
            <Button DockPanel.Dock="Right" Width="30" Height="28" Content="✕" Style="{StaticResource DialogButton}" Click="CloseLoginButton_Click" />
          </DockPanel>
          <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="USUÁRIO" Style="{StaticResource LauncherLabel}" />
            <TextBox x:Name="LoginUsernameBox" Margin="0,6,0,0" Height="34" Padding="10,7" />
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="SENHA" Style="{StaticResource LauncherLabel}" />
            <PasswordBox x:Name="LoginPasswordBox" Margin="0,6,0,0" Height="34" Padding="10,7" />
          </StackPanel>
          <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="CÓDIGO 2FA (SE ATIVO)" Style="{StaticResource LauncherLabel}" />
            <TextBox x:Name="LoginTotpBox" Margin="0,6,0,0" Height="34" Padding="10,7" MaxLength="6" />
          </StackPanel>
          <Button Grid.Row="4" Margin="0,20,0,0" Content="ENTRAR" Style="{StaticResource PrimaryButton}" Click="LoginButton_Click" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

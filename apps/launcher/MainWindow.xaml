<Window x:Class="BloodMoon.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Blood Moon Launcher" Width="1180" Height="700" MinWidth="1180" MinHeight="700" MaxWidth="1180" MaxHeight="700"
 WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="{StaticResource Brush.BackgroundVoid}"
 Loaded="Window_Loaded" Closing="Window_Closing" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" Background="{StaticResource Brush.BackgroundVoid}">
  <Grid x:Name="RootGrid">
   <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>

   <!-- TOP FRAME: only this non-interactive surface starts window drag. -->
   <Grid Grid.Row="0" Background="{StaticResource Brush.BackgroundShell}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,1,1" PreviewMouseLeftButtonDown="DragArea_MouseLeftButtonDown">
     <StackPanel Orientation="Horizontal" Margin="16,0,10,0" VerticalAlignment="Center">
      <Image x:Name="BrandLogoImage" Width="32" Height="32" Stretch="Uniform"/>
      <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
       <TextBlock Text="BLOOD MOON" Foreground="{StaticResource Brush.TextPrimary}" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" FontSize="16"/>
       <TextBlock Text="MU ONLINE" Margin="1,-1,0,0" Foreground="{StaticResource Brush.Crimson}" FontFamily="{StaticResource Font.Compact}" FontSize="8"/>
      </StackPanel>
     </StackPanel>
    </Border>
    <Border Grid.Column="1" BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,0,1" PreviewMouseLeftButtonDown="DragArea_MouseLeftButtonDown">
     <TextBlock x:Name="PageTitleText" Text="INÍCIO" Margin="18,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" FontFamily="{StaticResource Font.Compact}" FontSize="11"/>
    </Border>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Width="48" Height="55" Style="{StaticResource HotspotButton}" ToolTip="Minimizar" Click="MinimizeButton_Click"><TextBlock Text="—" Foreground="{StaticResource Brush.TextMuted}" FontSize="14"/></Button>
     <Button Width="47" Height="55" Style="{StaticResource HotspotButton}" ToolTip="Fechar" Click="CloseButton_Click"><TextBlock Text="✕" Foreground="{StaticResource Brush.TextMuted}" FontSize="14"/></Button>
    </StackPanel>
   </Grid>

   <!-- Stable approved HUD regions. Page changes only replace PageHost. -->
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
    <Grid Grid.Column="0" Background="{StaticResource Brush.BackgroundShell}">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,10,0,0">
      <ToggleButton x:Name="NavHome" Tag="Home" Content="INÍCIO" Style="{StaticResource NavItem}" IsChecked="True" Click="Nav_Click"/>
      <ToggleButton x:Name="NavAccount" Tag="Account" Content="CONTA" Style="{StaticResource NavItem}" Click="Nav_Click"/>
      <ToggleButton x:Name="NavNews" Tag="News" Content="NOTÍCIAS" Style="{StaticResource NavItem}" Click="Nav_Click"/>
      <ToggleButton x:Name="NavEvents" Tag="Events" Content="EVENTOS" Style="{StaticResource NavItem}" Click="Nav_Click"/>
      <ToggleButton x:Name="NavRanking" Tag="Ranking" Content="RANKING" Style="{StaticResource NavItem}" Click="Nav_Click"/>
      <ToggleButton x:Name="NavStore" Tag="Store" Content="LOJA" Style="{StaticResource NavItem}" Click="Nav_Click"/>
      <ToggleButton x:Name="NavSettings" Tag="Settings" Content="CONFIGURAÇÕES" Style="{StaticResource NavItem}" Click="Nav_Click"/>
     </StackPanel>
     <Border Grid.Row="2" Margin="12,8,12,0" Padding="11" Background="#25100D" BorderBrush="{StaticResource Brush.BorderCrimson}" BorderThickness="1">
      <StackPanel>
       <TextBlock Text="OPEN BETA" Foreground="{StaticResource Brush.Crimson}" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" FontSize="13"/>
       <TextBlock x:Name="OpenBetaDatesText" Text="01.09 — 15.09.2026" Margin="0,4,0,0" Foreground="{StaticResource Brush.TextPrimary}" FontFamily="{StaticResource Font.Mono}" FontSize="10"/>
       <TextBlock x:Name="OpenBetaSummaryText" Text="Participe da validação do Blood Moon." Margin="0,5,0,0" Foreground="{StaticResource Brush.TextMuted}" FontSize="9" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <StackPanel Grid.Row="3" Margin="12,10,12,12">
      <TextBlock Text="COMUNIDADE" Foreground="{StaticResource Brush.TextFaint}" FontFamily="{StaticResource Font.Compact}" FontSize="8"/>
      <ItemsControl x:Name="ShellSocialItems" Margin="0,6,0,0">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding Url}" Style="{StaticResource LauncherTextButton}" Padding="5" Margin="0,0,5,5" FontSize="8" Click="ShellExternalLink_Click"/></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button x:Name="AccountActionButton" Content="ENTRAR" Style="{StaticResource LauncherTextButton}" HorizontalAlignment="Stretch" Click="AccountActionButton_Click"/>
      <TextBlock x:Name="AccountGreetingText" Margin="0,5,0,0" Foreground="{StaticResource Brush.TextSecondary}" FontSize="9" Text="Entre com sua conta" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="AccountEmailText" Margin="0,2,0,0" Foreground="{StaticResource Brush.TextFaint}" FontSize="8" Text="Use a mesma conta do portal." TextTrimming="CharacterEllipsis"/>
     </StackPanel>
    </Grid>
    <Border Grid.Column="1" Background="{StaticResource Brush.BackgroundVoid}" BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1,0"><ContentControl x:Name="PageHost"/></Border>
    <Grid Grid.Column="2" Background="{StaticResource Brush.BackgroundShell}">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="10,12">
      <TextBlock Text="UTILIDADES" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextFaint}" FontFamily="{StaticResource Font.Compact}" FontSize="7"/>
      <Button Content="CONTA" Tag="Account" Margin="0,10,0,0" Height="44" FontSize="8" Style="{StaticResource LauncherTextButton}" Click="UtilityNavigation_Click"/>
      <Button Content="ARQUIVOS" Margin="0,8,0,0" Height="44" FontSize="8" Style="{StaticResource LauncherTextButton}" Click="VerifyUtility_Click"/>
      <Button Content="AJUDA" Tag="support" Margin="0,8,0,0" Height="44" FontSize="8" Style="{StaticResource LauncherTextButton}" Click="UtilityExternal_Click"/>
      <Button Content="SITE" Tag="site" Margin="0,8,0,0" Height="44" FontSize="8" Style="{StaticResource LauncherTextButton}" Click="UtilityExternal_Click"/>
      <Button Content="WIKI" Tag="wiki" Margin="0,8,0,0" Height="44" FontSize="8" Style="{StaticResource LauncherTextButton}" Click="UtilityExternal_Click"/>
     </StackPanel>
     <TextBlock Grid.Row="1" Text="v1.1.0" Margin="0,0,0,14" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextFaint}" FontFamily="{StaticResource Font.Mono}" FontSize="8"/>
    </Grid>
   </Grid>

   <!-- Real updater progress only; never simulated. -->
   <Grid Grid.Row="2" Background="{StaticResource Brush.BackgroundShell}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,1,1,0"><TextBlock x:Name="ContentVersionText" Text="CONTEÚDO —" Margin="14,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextFaint}" FontFamily="{StaticResource Font.Mono}" FontSize="8" TextTrimming="CharacterEllipsis"/></Border>
    <DockPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
     <TextBlock x:Name="ProgressStatusText" Foreground="{StaticResource Brush.TextSecondary}" FontFamily="{StaticResource Font.Compact}" FontSize="10" Text="VERIFICANDO ATUALIZAÇÕES" VerticalAlignment="Center"/>
     <TextBlock x:Name="ProgressDetailText" Margin="10,0,0,0" Foreground="{StaticResource Brush.TextFaint}" FontFamily="{StaticResource Font.Mono}" FontSize="8" TextTrimming="CharacterEllipsis" Text="Aguardando manifesto seguro" VerticalAlignment="Center"/>
    </DockPanel>
    <Border Grid.Column="2" Height="8" Margin="0,0,16,0" VerticalAlignment="Center" Background="{StaticResource Brush.BackgroundSurface}" BorderBrush="{StaticResource Brush.BorderWarm}" BorderThickness="1">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="ProgressFillColumn" Width="0*"/><ColumnDefinition x:Name="ProgressRemainderColumn" Width="100*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource Brush.Crimson}"/></Grid>
    </Border>
    <Border Grid.Column="3" BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1,1,0,0"/>
   </Grid>

   <Border x:Name="Toast" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,68,0,0" Padding="16,11" Background="{StaticResource Brush.BackgroundPanel}" BorderBrush="{StaticResource Brush.BorderCrimson}" BorderThickness="1" Visibility="Collapsed" Panel.ZIndex="10"><TextBlock x:Name="ToastText" Foreground="{StaticResource Brush.TextPrimary}" FontFamily="{StaticResource Font.Ui}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480"/></Border>
   <Grid x:Name="LoginOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#E6050505" Visibility="Collapsed" Panel.ZIndex="20">
    <Border Width="410" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource Brush.BackgroundPanel}" BorderBrush="{StaticResource Brush.BorderCrimson}" BorderThickness="1">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel><StackPanel><TextBlock Text="CONTA BLOOD MOON" Foreground="{StaticResource Brush.TextPrimary}" FontFamily="{StaticResource Font.Display}" FontSize="19" FontWeight="Bold"/><TextBlock Margin="0,4,0,0" Foreground="{StaticResource Brush.TextFaint}" FontSize="10" Text="Use a mesma conta do portal."/></StackPanel><Button DockPanel.Dock="Right" Width="30" Height="28" Content="✕" Style="{StaticResource DialogButton}" Click="CloseLoginButton_Click"/></DockPanel>
      <StackPanel Grid.Row="1" Margin="0,18,0,0"><TextBlock Text="USUÁRIO" Style="{StaticResource LauncherLabel}"/><TextBox x:Name="LoginUsernameBox" Margin="0,6,0,0" Height="34" Padding="10,7"/></StackPanel>
      <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="SENHA" Style="{StaticResource LauncherLabel}"/><PasswordBox x:Name="LoginPasswordBox" Margin="0,6,0,0" Height="34" Padding="10,7"/></StackPanel>
      <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="CÓDIGO 2FA (SE ATIVO)" Style="{StaticResource LauncherLabel}"/><TextBox x:Name="LoginTotpBox" Margin="0,6,0,0" Height="34" Padding="10,7" MaxLength="6"/></StackPanel>
      <Button Grid.Row="4" Margin="0,18,0,0" Content="ENTRAR" Style="{StaticResource PrimaryButton}" Click="LoginButton_Click"/>
     </Grid>
    </Border>
   </Grid>
  </Grid>
 </Border>
</Window>

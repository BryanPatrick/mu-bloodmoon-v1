<Application x:Class="BloodMoon.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
   <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <!-- Launcher Foundation phase: neutral local placeholders for
           missing remote images (Part W). -->
      <ResourceDictionary Source="Assets/Placeholders.xaml" />
      <!-- Launcher Phase L3 (Part AU): centralized color/typography/
           control resources. Palette must load before Controls (Controls
           references Brush.*/Font.*/FontSize.* keys via StaticResource,
           which resolves at parse time in merge order). -->
      <ResourceDictionary Source="Styles/Palette.xaml" />
      <ResourceDictionary Source="Styles/Typography.xaml" />
      <ResourceDictionary Source="Styles/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>
   </ResourceDictionary>
  </Application.Resources>
</Application>

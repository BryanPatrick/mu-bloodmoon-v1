<Application x:Class="BloodMoon.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
   <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <!-- Launcher Foundation phase: neutral local placeholders for
           missing remote images (Part W). Additive: merged alongside the
           existing styles below, nothing here replaces them. -->
      <ResourceDictionary Source="Assets/Placeholders.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="HotspotButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#221F0707" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="#66B21E1E" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#553A0606" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DialogButton" TargetType="Button">
      <Setter Property="Foreground" Value="#E8D8C8" />
      <Setter Property="Background" Value="#24110E" />
      <Setter Property="BorderBrush" Value="#7E3B2D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="FontFamily" Value="Segoe UI Semibold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="LauncherTextButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Background" Value="#160E0C" />
      <Setter Property="BorderBrush" Value="#5E3028" />
    </Style>

    <Style x:Key="LauncherSectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#D7C1AA" />
      <Setter Property="FontFamily" Value="Georgia" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="LauncherLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#A69584" />
      <Setter Property="FontFamily" Value="Segoe UI Semibold" />
      <Setter Property="FontSize" Value="10" />
    </Style>
   </ResourceDictionary>
  </Application.Resources>
</Application>

<UserControl x:Class="BloodMoon.Launcher.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{StaticResource Brush.BackgroundVoid}" Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <RadioButton x:Name="TabJogo" Content="JOGO" GroupName="SettingsTab" Style="{StaticResource BmTabItem}" IsChecked="True" Checked="Tab_Changed" />
      <RadioButton x:Name="TabLauncher" Content="LAUNCHER" GroupName="SettingsTab" Style="{StaticResource BmTabItem}" Checked="Tab_Changed" />
      <RadioButton x:Name="TabAtualizacao" Content="ATUALIZAÇÃO" GroupName="SettingsTab" Style="{StaticResource BmTabItem}" Checked="Tab_Changed" />
      <RadioButton x:Name="TabAudio" Content="ÁUDIO" GroupName="SettingsTab" Style="{StaticResource BmTabItem}" Checked="Tab_Changed" />
      <RadioButton x:Name="TabDesempenho" Content="DESEMPENHO" GroupName="SettingsTab" Style="{StaticResource BmTabItem}" Checked="Tab_Changed" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <Grid MaxWidth="640" HorizontalAlignment="Left">
        <!-- JOGO -->
        <StackPanel x:Name="PanelJogo">
          <StackPanel Orientation="Horizontal">
            <StackPanel Margin="0,0,20,0" Width="220">
              <TextBlock Text="RESOLUÇÃO DO JOGO" Style="{StaticResource LauncherLabel}" />
              <ComboBox x:Name="GameResolutionCombo" Margin="0,8,0,0" Style="{StaticResource BmComboBox}">
                <ComboBoxItem Content="800 x 600" /><ComboBoxItem Content="1024 x 768" /><ComboBoxItem Content="1280 x 1024" />
                <ComboBoxItem Content="1360 x 768" /><ComboBoxItem Content="1440 x 900" /><ComboBoxItem Content="1600 x 900" />
                <ComboBoxItem Content="1680 x 1050" /><ComboBoxItem Content="1920 x 1080" />
              </ComboBox>
            </StackPanel>
            <StackPanel Width="220">
              <TextBlock Text="IDIOMA" Style="{StaticResource LauncherLabel}" />
              <ComboBox x:Name="LanguageCombo" Margin="0,8,0,0" Style="{StaticResource BmComboBox}">
                <ComboBoxItem Content="Português (BR)" Tag="Por" /><ComboBoxItem Content="English" Tag="Eng" /><ComboBoxItem Content="Español" Tag="Spn" />
              </ComboBox>
            </StackPanel>
          </StackPanel>
          <CheckBox x:Name="WindowModeCheck" Margin="0,18,0,0" Style="{StaticResource BmToggle}" Content="Executar em modo janela" />

          <Border Margin="0,24,0,0" Padding="14" BorderBrush="{StaticResource Brush.BorderCrimson}" BorderThickness="1">
            <DockPanel>
              <Button x:Name="AccountActionButton" DockPanel.Dock="Right" Content="ENTRAR" Style="{StaticResource LauncherTextButton}" VerticalAlignment="Center" Click="AccountAction_Click" />
              <StackPanel>
                <TextBlock x:Name="AccountGreetingText" Foreground="{StaticResource Brush.TextPrimary}" FontFamily="{StaticResource Font.Serif}" FontSize="15" />
                <TextBlock x:Name="AccountEmailText" Margin="0,4,0,0" Foreground="{StaticResource Brush.TextFaint}" FontSize="11" />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>

        <!-- LAUNCHER (viewport/resolution profiles, Part L) -->
        <StackPanel x:Name="PanelLauncher" Visibility="Collapsed">
          <TextBlock Text="RESOLUÇÃO DO LAUNCHER" Style="{StaticResource LauncherLabel}" />
          <ComboBox x:Name="ViewportCombo" Width="260" Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource BmComboBox}" SelectionChanged="ViewportCombo_SelectionChanged" />
          <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Brush.TextFaint}" FontSize="10" TextWrapping="Wrap" Text="Números reais de resolução -- não rótulos de tamanho. WIDE dá prioridade ao conteúdo central; MAXIMIZADO usa o espaço disponível da tela." />
          <CheckBox x:Name="StartWithWindowsCheck" Margin="0,20,0,0" Style="{StaticResource BmToggle}" Content="Iniciar com o Windows" />
          <CheckBox x:Name="MinimizeToTrayCheck" Margin="0,12,0,0" Style="{StaticResource BmToggle}" Content="Minimizar para a bandeja" />
          <CheckBox x:Name="CloseAfterGameStartsCheck" Margin="0,12,0,0" Style="{StaticResource BmToggle}" Content="Fechar o launcher ao iniciar o jogo" />
          <CheckBox x:Name="UiAnimationsCheck" Margin="0,12,0,0" Style="{StaticResource BmToggle}" Content="Animações de interface" />
        </StackPanel>

        <!-- ATUALIZAÇÃO -->
        <StackPanel x:Name="PanelAtualizacao" Visibility="Collapsed">
          <TextBlock x:Name="InstalledVersionText" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="VERIFICAR ARQUIVOS" Margin="0,0,10,0" Style="{StaticResource DialogButton}" Click="Verify_Click" />
            <Button Content="BACKUP" Margin="0,0,10,0" Style="{StaticResource DialogButton}" Click="Backup_Click" />
            <Button Content="RESTAURAR" Style="{StaticResource DialogButton}" Click="Rollback_Click" />
          </StackPanel>
        </StackPanel>

        <!-- ÁUDIO -->
        <StackPanel x:Name="PanelAudio" Visibility="Collapsed">
          <CheckBox x:Name="MusicCheck" Style="{StaticResource BmToggle}" Content="Música" />
          <CheckBox x:Name="SoundCheck" Margin="0,12,0,0" Style="{StaticResource BmToggle}" Content="Efeitos sonoros" />
          <TextBlock Text="VOLUME" Style="{StaticResource LauncherLabel}" Margin="0,20,0,0" />
          <Slider x:Name="VolumeSlider" Width="240" HorizontalAlignment="Left" Minimum="0" Maximum="10" Margin="0,8,0,0" />
        </StackPanel>

        <!-- DESEMPENHO -->
        <StackPanel x:Name="PanelDesempenho" Visibility="Collapsed">
          <TextBlock Text="QUALIDADE GRÁFICA" Style="{StaticResource LauncherLabel}" />
          <ComboBox x:Name="QualityCombo" Width="220" Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource BmComboBox}">
            <ComboBoxItem Content="Baixa" /><ComboBoxItem Content="Média" /><ComboBoxItem Content="Alta" />
          </ComboBox>
          <CheckBox x:Name="PerformanceModeCheck" Margin="0,18,0,0" Style="{StaticResource BmToggle}" Content="Modo desempenho (reduz efeitos visuais)" />
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Button Content="APLICAR" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Click="Apply_Click" />
  </Grid>
</UserControl>

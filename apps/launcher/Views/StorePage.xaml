<UserControl x:Class="BloodMoon.Launcher.Views.StorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{StaticResource Brush.BackgroundVoid}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.6*" />
      <ColumnDefinition Width="1*" />
    </Grid.ColumnDefinitions>

    <!-- LEFT: banner + product grid -->
    <ScrollViewer Grid.Column="0" Margin="24,20,12,20" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border x:Name="BannerBorder" Style="{StaticResource Card}" Padding="0" MinHeight="80" />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <TextBlock Text="MOEDAS:" Style="{StaticResource LauncherLabel}" VerticalAlignment="Center" />
          <ItemsControl x:Name="CurrencyIcons" Margin="8,0,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="26" Height="26" Margin="0,0,6,0" Background="{StaticResource Brush.BackgroundSurfaceAlt}" ToolTip="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <ItemsControl x:Name="ProductGrid" Margin="0,14,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Margin="0,0,10,10" Cursor="Hand" MouseLeftButtonUp="ProductCard_Click">
                <StackPanel>
                  <Border Height="96" Background="{StaticResource Brush.BackgroundSurfaceAlt}" />
                  <TextBlock Text="{Binding Name}" Margin="0,8,0,0" Foreground="{StaticResource Brush.TextPrimary}" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Short}" Margin="0,3,0,0" Foreground="{StaticResource Brush.TextMuted}" FontSize="10" TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis" />
                  <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Brush.Gold}" FontSize="12" FontWeight="Bold">
                    <Run Text="{Binding Price}" /><Run Text=" " /><Run Text="{Binding Currency}" />
                  </TextBlock>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="NoProductsText" Margin="0,10,0,0" Foreground="{StaticResource Brush.TextFaint}" FontSize="11" Visibility="Collapsed" Text="Nenhum produto disponível no momento." />
      </StackPanel>
    </ScrollViewer>

    <!-- RIGHT: detail panel + cart + terms -->
    <ScrollViewer Grid.Column="1" Margin="12,20,24,20" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="ITEM SELECIONADO" Style="{StaticResource LauncherLabel}" />
            <TextBlock x:Name="SelectedNameText" Margin="0,6,0,0" Foreground="{StaticResource Brush.TextPrimary}" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
            <TextBlock x:Name="SelectedDescriptionText" Margin="0,4,0,0" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" TextWrapping="Wrap" />
            <TextBlock x:Name="SelectedPriceText" Margin="0,8,0,0" Foreground="{StaticResource Brush.Gold}" FontSize="14" FontWeight="Bold" />
            <Button x:Name="AddToCartButton" Content="ADICIONAR AO CARRINHO" Margin="0,10,0,0" Style="{StaticResource DialogButton}" HorizontalAlignment="Stretch" IsEnabled="False" Click="AddToCart_Click" />
          </StackPanel>
        </Border>

        <Border Margin="0,12,0,0" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="CARRINHO" Style="{StaticResource LauncherSectionTitle}" />
            <ItemsControl x:Name="CartItems" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding LineTotalLabel}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="6,0" />
                    <Button Grid.Column="2" Content="✕" Width="22" Height="22" Style="{StaticResource LauncherTextButton}" Padding="0" Click="RemoveCartItem_Click" Tag="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyCartText" Margin="0,6,0,0" Foreground="{StaticResource Brush.TextFaint}" FontSize="11" Text="Carrinho vazio." />
            <Border Height="1" Margin="0,10" Background="{StaticResource Brush.BorderSubtle}" />
            <TextBlock x:Name="CartTotalText" Foreground="{StaticResource Brush.TextPrimary}" FontSize="13" FontWeight="Bold" />

            <CheckBox x:Name="TermsCheckBox" Margin="0,14,0,0" Style="{StaticResource BmToggle}" Checked="TermsCheckBox_Changed" Unchecked="TermsCheckBox_Changed">
              <TextBlock TextWrapping="Wrap">
                <Run Text="Li e concordo com os " />
                <Hyperlink Click="TermsLink_Click"><Run Text="Termos de Compra" /></Hyperlink>
              </TextBlock>
            </CheckBox>
            <TextBlock x:Name="TermsContentText" Margin="0,8,0,0" Foreground="{StaticResource Brush.TextFaint}" FontSize="10" TextWrapping="Wrap" Visibility="Collapsed" MaxHeight="140" />

            <Button x:Name="CheckoutButton" Content="FINALIZAR COMPRA" Margin="0,14,0,0" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" IsEnabled="False" Click="Checkout_Click" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

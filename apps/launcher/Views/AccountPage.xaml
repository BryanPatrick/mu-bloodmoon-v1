<UserControl x:Class="BloodMoon.Launcher.Views.AccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{StaticResource Brush.BackgroundVoid}">
    <Grid x:Name="SignedOutPanel" Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Entre na sua conta para ver este conteúdo." Foreground="{StaticResource Brush.TextMuted}" FontSize="14" />
        <Button Content="ENTRAR" Margin="0,14,0,0" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="Login_Click" />
      </StackPanel>
    </Grid>

    <Grid x:Name="ContentPanel" Margin="24,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="1.6*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>

      <!-- LEFT: character list -->
      <Border Grid.Column="0" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="PERSONAGENS" Style="{StaticResource LauncherSectionTitle}" />
          <ItemsControl x:Name="CharacterItems" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource TableRow}">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" Background="{StaticResource Brush.BackgroundSurfaceAlt}" />
                    <StackPanel Margin="10,0,0,0">
                      <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.TextPrimary}" FontSize="13" FontWeight="Bold" />
                      <TextBlock Foreground="{StaticResource Brush.TextMuted}" FontSize="10">
                        <Run Text="{Binding CurrentClass}" /><Run Text=" · Lvl " /><Run Text="{Binding Level}" /><Run Text=" · Reset " /><Run Text="{Binding Reset}" />
                      </TextBlock>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="NoCharactersText" Margin="0,10,0,0" Foreground="{StaticResource Brush.TextFaint}" FontSize="11" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <!-- CENTER: selected character -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock x:Name="SelectedNameText" Foreground="{StaticResource Brush.TextPrimary}" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" FontSize="22" />
          <TextBlock x:Name="SelectedClassText" Margin="0,2,0,0" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" />

          <UniformGrid Columns="4" Margin="0,16,0,0">
            <StackPanel Margin="0,0,8,10"><TextBlock Text="LEVEL" Style="{StaticResource LauncherLabel}" /><TextBlock x:Name="LevelText" Foreground="{StaticResource Brush.TextPrimary}" FontSize="16" FontWeight="Bold" /></StackPanel>
            <StackPanel Margin="0,0,8,10"><TextBlock Text="MASTER LEVEL" Style="{StaticResource LauncherLabel}" /><TextBlock x:Name="MasterLevelText" Foreground="{StaticResource Brush.TextPrimary}" FontSize="16" FontWeight="Bold" /></StackPanel>
            <StackPanel Margin="0,0,8,10"><TextBlock Text="RESET" Style="{StaticResource LauncherLabel}" /><TextBlock x:Name="ResetText" Foreground="{StaticResource Brush.TextPrimary}" FontSize="16" FontWeight="Bold" /></StackPanel>
            <StackPanel Margin="0,0,0,10"><TextBlock Text="MASTER RESET" Style="{StaticResource LauncherLabel}" /><TextBlock x:Name="MasterResetText" Foreground="{StaticResource Brush.TextPrimary}" FontSize="16" FontWeight="Bold" /></StackPanel>
          </UniformGrid>

          <TextBlock Text="ATRIBUTOS" Style="{StaticResource LauncherLabel}" Margin="0,10,0,0" />
          <UniformGrid Columns="4" Margin="0,8,0,0">
            <StackPanel><TextBlock Text="FORÇA" Style="{StaticResource LauncherLabel}" /><TextBlock x:Name="StrengthText" Foreground="{StaticResource Brush.TextSecondary}" FontSize="14" /></StackPanel>
            <StackPanel><TextBlock Text="AGILIDADE" Style="{StaticResource LauncherLabel}" /><TextBlock x:Name="AgilityText" Foreground="{StaticResource Brush.TextSecondary}" FontSize="14" /></StackPanel>
            <StackPanel><TextBlock Text="VITALIDADE" Style="{StaticResource LauncherLabel}" /><TextBlock x:Name="VitalityText" Foreground="{StaticResource Brush.TextSecondary}" FontSize="14" /></StackPanel>
            <StackPanel><TextBlock Text="ENERGIA" Style="{StaticResource LauncherLabel}" /><TextBlock x:Name="EnergyText" Foreground="{StaticResource Brush.TextSecondary}" FontSize="14" /></StackPanel>
          </UniformGrid>
          <StackPanel x:Name="CommandPanel" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock Text="COMANDO" Style="{StaticResource LauncherLabel}" />
            <TextBlock x:Name="CommandText" Foreground="{StaticResource Brush.TextSecondary}" FontSize="14" />
          </StackPanel>

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"><TextBlock Text="LOCALIZAÇÃO" Style="{StaticResource LauncherLabel}" /><TextBlock x:Name="LocationText" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" /></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="PK" Style="{StaticResource LauncherLabel}" /><TextBlock x:Name="PkText" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" /></StackPanel>
          </Grid>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"><TextBlock Text="GUILD" Style="{StaticResource LauncherLabel}" /><TextBlock x:Name="GuildText" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" /></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="VIP" Style="{StaticResource LauncherLabel}" /><TextBlock x:Name="VipText" Foreground="{StaticResource Brush.Gold}" FontSize="12" /></StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- RIGHT: ranking + guild -->
      <Grid Grid.Column="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="12" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="RANKING PESSOAL" Style="{StaticResource LauncherSectionTitle}" />
            <ItemsControl x:Name="PersonalRankingItems" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RankingType}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="{Binding Position}" Foreground="{StaticResource Brush.Gold}" FontSize="12" FontWeight="Bold" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoRankingText" Margin="0,6,0,0" Foreground="{StaticResource Brush.TextFaint}" FontSize="11" />
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="GUILDA" Style="{StaticResource LauncherSectionTitle}" />
            <Border x:Name="GuildEmblemHost" Width="48" Height="48" Margin="0,10,0,0" Background="{StaticResource Brush.BackgroundSurfaceAlt}" HorizontalAlignment="Left" />
            <TextBlock x:Name="GuildNameText" Margin="0,8,0,0" Foreground="{StaticResource Brush.TextPrimary}" FontSize="14" FontWeight="Bold" />
            <TextBlock x:Name="GuildRoleText" Margin="0,2,0,0" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" />
            <TextBlock x:Name="GuildMasterText" Margin="0,6,0,0" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" />
            <TextBlock x:Name="GuildScoreText" Margin="0,4,0,0" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>

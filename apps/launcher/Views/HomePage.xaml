<UserControl x:Class="BloodMoon.Launcher.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{StaticResource Brush.BackgroundVoid}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid Margin="24,20,24,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="HeroColumn" Width="2*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="16" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HERO (Part O—major adaptive region, expands in WIDE). -->
        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource Card}" MinHeight="260" Padding="0">
          <Grid>
            <Border x:Name="HeroImageHost" Background="{StaticResource Brush.BackgroundSurfaceAlt}" />
            <StackPanel VerticalAlignment="Bottom" Margin="24">
              <TextBlock x:Name="HeroTitleText" Foreground="{StaticResource Brush.TextPrimary}" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" FontSize="28" TextWrapping="Wrap" />
              <TextBlock x:Name="HeroSubtitleText" Margin="0,6,0,0" Foreground="{StaticResource Brush.TextSecondary}" FontFamily="{StaticResource Font.Compact}" FontSize="13" TextWrapping="Wrap" />
              <Button x:Name="HeroCtaButton" Margin="0,14,0,0" HorizontalAlignment="Left" Style="{StaticResource DialogButton}" Click="HeroCta_Click" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- CHARACTER SUMMARY / JOGAR -->
        <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="PERSONAGEM" Style="{StaticResource LauncherLabel}" />
            <StackPanel x:Name="CharacterSummaryPanel" Margin="0,10,0,0">
              <TextBlock x:Name="CharacterNameText" Foreground="{StaticResource Brush.TextPrimary}" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" FontSize="18" />
              <TextBlock x:Name="CharacterDetailText" Margin="0,3,0,0" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" />
            </StackPanel>
            <TextBlock x:Name="ServerStatusText" Margin="0,16,0,0" Foreground="{StaticResource Brush.Success}" FontFamily="{StaticResource Font.Ui}" FontSize="12" />
            <TextBlock x:Name="ServerStatusDetailText" Margin="0,3,0,0" Foreground="{StaticResource Brush.TextFaint}" FontSize="10" TextWrapping="Wrap" />
            <Button x:Name="PlayButton" Margin="0,16,0,0" Content="JOGAR" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Click="PlayButton_Click" />
          </StackPanel>
        </Border>

        <!-- CAMPAIGN + EVENTS -->
        <Border Grid.Column="0" Grid.Row="2" x:Name="CampaignBorder" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock x:Name="CampaignVersionText" Style="{StaticResource LauncherLabel}" />
            <TextBlock x:Name="CampaignTitleText" Margin="0,4,0,0" Foreground="{StaticResource Brush.TextPrimary}" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" FontSize="16" />
            <TextBlock x:Name="CampaignSubtitleText" Margin="0,3,0,0" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Grid Grid.Column="2" Grid.Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="EVENTO ATIVO" Style="{StaticResource LauncherLabel}" />
              <TextBlock x:Name="ActiveEventText" Margin="0,4,0,0" Foreground="{StaticResource Brush.TextPrimary}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="PRÓXIMO EVENTO" Style="{StaticResource LauncherLabel}" />
              <TextBlock x:Name="NextEventText" Margin="0,4,0,0" Foreground="{StaticResource Brush.TextPrimary}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>

    <!-- NEWS + SOCIALS + UTILITIES -->
    <Grid Grid.Row="1" Margin="24,0,24,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <TextBlock Text="NOTÍCIAS" Style="{StaticResource LauncherSectionTitle}" />
            <Button DockPanel.Dock="Right" Content="VER TODAS →" Style="{StaticResource LauncherTextButton}" HorizontalAlignment="Right" Click="NewsButton_Click" />
          </DockPanel>
          <ItemsControl x:Name="NewsItems" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Height="26">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="78" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Title}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding PublishedAt, StringFormat={}{0:dd/MM/yyyy}}" Foreground="{StaticResource Brush.TextFaint}" FontSize="10" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="REDES SOCIAIS" Style="{StaticResource LauncherLabel}" />
          <ItemsControl x:Name="SocialItems" Margin="0,8,0,10">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" Style="{StaticResource LauncherTextButton}" Margin="0,0,0,6" HorizontalAlignment="Stretch" Click="SocialItem_Click" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="UTILITÁRIOS" Style="{StaticResource LauncherLabel}" />
          <UniformGrid Rows="1" Margin="0,8,0,0">
            <Button Content="SUPORTE" Style="{StaticResource LauncherTextButton}" Margin="0,0,4,0" Click="Utility_Click" Tag="support" />
            <Button Content="SITE" Style="{StaticResource LauncherTextButton}" Margin="4,0,4,0" Click="Utility_Click" Tag="site" />
            <Button Content="WIKI" Style="{StaticResource LauncherTextButton}" Margin="4,0,0,0" Click="Utility_Click" Tag="wiki" />
          </UniformGrid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>

{
  "name": "@blood-moon/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "check": "node scripts/check-api-structure.mjs && node scripts/check-security-structure.mjs && node scripts/check-observability-structure.mjs && node scripts/check-roadmap-structure.mjs && node scripts/check-store-structure.mjs && node scripts/check-marketplace-structure.mjs && node scripts/check-community-structure.mjs && node scripts/check-admin-tasks-structure.mjs && node scripts/check-admin-reports-structure.mjs && node scripts/check-guilds-structure.mjs && tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && node dist/apps/api/src/main.js",
    "worker:game-bridge": "node scripts/process-game-bridge-jobs.mjs",
    "worker:marketplace-expirations": "node scripts/process-marketplace-expirations.mjs",
    "db:seed:test": "node --env-file-if-exists=.env scripts/seed-test-accounts.mjs",
    "check:security:integration": "node scripts/check-auth-integration.mjs",
    "start": "node dist/apps/api/src/main.js",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:beta:critical": "jest --config ./test/jest-e2e.json --runInBand --testPathPatterns=\"(portal-critical|password-recovery|error-handling)\\.e2e-spec\\.ts$\"",
    "test:beta:community": "jest --config ./test/jest-e2e.json --runInBand --testPathPatterns=\"community-.*\\.e2e-spec\\.ts$\"",
    "test:beta": "npm run test:beta:critical && npm run test:beta:community"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "^5.0.0",
    "@types/multer": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "exceljs": "^4.4.0",
    "helmet": "^7.0.0",
    "nodemailer": "^9.0.5",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.4.22",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "prisma": "^5.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.0.0"
  }
}

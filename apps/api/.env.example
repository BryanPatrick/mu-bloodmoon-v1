NODE_ENV=development
API_PORT=3333
API_PUBLIC_URL=http://localhost:3333
WEB_PUBLIC_URL=http://localhost:3000

DATABASE_URL=mysql://bloodmoon:bloodmoon@localhost:53306/bloodmoon_portal
REDIS_URL=redis://localhost:56379

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
TWO_FACTOR_ENCRYPTION_KEY=change-me-with-at-least-32-random-characters
SESSION_TTL_HOURS=24
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=localhost
TURNSTILE_TIMEOUT_MS=5000
# Configure only when the API is behind a known reverse proxy.
TRUST_PROXY_HOPS=0
AUTH_RATE_LOGIN_IP_LIMIT=20
AUTH_RATE_LOGIN_IP_WINDOW_MS=300000
AUTH_RATE_LOGIN_SUBJECT_LIMIT=10
AUTH_RATE_LOGIN_SUBJECT_WINDOW_MS=900000
AUTH_RATE_REGISTER_IP_LIMIT=10
AUTH_RATE_REGISTER_IP_WINDOW_MS=3600000
AUTH_RATE_REGISTER_SUBJECT_LIMIT=3
AUTH_RATE_REGISTER_SUBJECT_WINDOW_MS=3600000
AUTH_RATE_RECOVERY_IP_LIMIT=10
AUTH_RATE_RECOVERY_IP_WINDOW_MS=900000
AUTH_RATE_RECOVERY_SUBJECT_LIMIT=3
AUTH_RATE_RECOVERY_SUBJECT_WINDOW_MS=900000
AUTH_PASSWORD_RESET_TTL_MINUTES=30

# Development only. Never configure these variables in production.
TEST_ACCOUNT_PASSWORD=
TEST_ACCOUNT_PERSONAL_ID=

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# Community media pipeline. MEDIA_STORAGE_PROVIDER selects local disk (default)
# or Cloudflare R2 -- the R2_* variables below are only read/required when it
# is set to "r2". COMMUNITY_MEDIA_DIR/GUILD_MEDIA_DIR are the existing,
# publicly-served directories (unchanged); MEDIA_QUARANTINE_DIR/MEDIA_REMOVED_DIR
# are new and are never served.
MEDIA_STORAGE_PROVIDER=local
COMMUNITY_MEDIA_DIR=./storage/community-media
GUILD_MEDIA_DIR=./storage/guild-media
MEDIA_QUARANTINE_DIR=./storage/media-quarantine
MEDIA_REMOVED_DIR=./storage/media-removed
# Required only when MEDIA_STORAGE_PROVIDER=r2. Never commit real values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Mercado Pago (Checkout Transparente / Orders API, wallet recharge only --
# credits the portal's own AccountCurrency wallet, never the MU game server).
# Test/sandbox credentials only. ACCESS_TOKEN and WEBHOOK_SECRET are
# server-side only and are required in production; PUBLIC_KEY is currently
# unused (no card/Bricks frontend flow in this etapa).
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ENABLED=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_TIMEOUT_MS=15000

# Asaas production-readiness only. All switches remain OFF. Set the exact
# production URL only with ASAAS_ENVIRONMENT=production. Never commit values.
ASAAS_ENABLED=false
ASAAS_ENVIRONMENT=disabled
ASAAS_BASE_URL=
ASAAS_FRONTEND_ENABLED=false
ASAAS_PAYMENT_CREATION_ENABLED=false
ASAAS_WEBHOOK_PROCESSING_ENABLED=false
ASAAS_RECONCILIATION_ENABLED=false
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
BILLING_PII_KEY_B64=

# Durable Asaas operational gate evaluation and outbound delivery are
# independent opt-ins. Missing flags mean false; missing destination means
# events remain stored but no email is attempted.
ASAAS_OPERATIONAL_ALERTS_ENABLED=false
ASAAS_OPERATIONAL_ALERT_INTERVAL_MS=60000
ASAAS_PROVIDER_5XX_ALERT_THRESHOLD=5
ASAAS_PROVIDER_5XX_ALERT_WINDOW_MS=300000
ASAAS_INVALID_WEBHOOK_AUTH_ALERT_THRESHOLD=5
ASAAS_INVALID_WEBHOOK_AUTH_ALERT_WINDOW_MS=300000
ASAAS_RECONCILE_REQUIRED_ALERT_AGE_MS=900000
ASAAS_MANUAL_REVIEW_ALERT_AGE_MS=1800000
ALERT_SWEEP_ENABLED=false
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=

MU_DATABASE_PROVIDER=sqlserver
MU_DATABASE_URL=sqlserver://user:password@localhost:1433;database=MuOnline;encrypt=false
MU_BRIDGE_ENABLED=false
MU_BRIDGE_WORKER_CONCURRENCY=1
MU_BRIDGE_LOCK_TIMEOUT_SECONDS=60

# Game Data Platform (Phase 1/2D) -- server-to-server only, read scope
# distinct from the Agent's write scope. Absent config means
# GameDataClient degrades to bridgeStatus=UNKNOWN, never a crash, never
# fake data (see apps/api/src/modules/game-data/game-data.env.ts). Never
# expose either value to the frontend/Nuxt public runtime config.
GAME_DATA_WORKER_URL=
GAME_DATA_API_READ_SECRET=
GAME_COMMAND_PORTAL_CLIENT_ID=apps-api-command
GAME_COMMAND_PORTAL_SECRET=
GAME_COMMAND_ENVIRONMENT=production
GAME_COMMAND_SERVER_ID=bloodmoon-s6
GAME_CREDENTIAL_ACTIVE_KEY_VERSION=v1
GAME_CREDENTIAL_KEYS_JSON=

NODE_ENV=development
API_PORT=3333
API_PUBLIC_URL=http://localhost:3333
WEB_PUBLIC_URL=http://localhost:3000

DATABASE_URL=mysql://bloodmoon:bloodmoon@localhost:53306/bloodmoon_portal
REDIS_URL=redis://localhost:56379

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
TWO_FACTOR_ENCRYPTION_KEY=change-me-with-at-least-32-random-characters
SESSION_TTL_HOURS=24
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=localhost
TURNSTILE_TIMEOUT_MS=5000
# Configure only when the API is behind a known reverse proxy.
TRUST_PROXY_HOPS=0
AUTH_RATE_LOGIN_IP_LIMIT=20
AUTH_RATE_LOGIN_IP_WINDOW_MS=300000
AUTH_RATE_LOGIN_SUBJECT_LIMIT=10
AUTH_RATE_LOGIN_SUBJECT_WINDOW_MS=900000
AUTH_RATE_REGISTER_IP_LIMIT=10
AUTH_RATE_REGISTER_IP_WINDOW_MS=3600000
AUTH_RATE_REGISTER_SUBJECT_LIMIT=3
AUTH_RATE_REGISTER_SUBJECT_WINDOW_MS=3600000
AUTH_RATE_RECOVERY_IP_LIMIT=10
AUTH_RATE_RECOVERY_IP_WINDOW_MS=900000
AUTH_RATE_RECOVERY_SUBJECT_LIMIT=3
AUTH_RATE_RECOVERY_SUBJECT_WINDOW_MS=900000
AUTH_PASSWORD_RESET_TTL_MINUTES=30

# Development only. Never configure these variables in production.
TEST_ACCOUNT_PASSWORD=
TEST_ACCOUNT_PERSONAL_ID=

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

MU_DATABASE_PROVIDER=sqlserver
MU_DATABASE_URL=sqlserver://user:password@localhost:1433;database=MuOnline;encrypt=false
MU_BRIDGE_ENABLED=false
MU_BRIDGE_WORKER_CONCURRENCY=1
MU_BRIDGE_LOCK_TIMEOUT_SECONDS=60

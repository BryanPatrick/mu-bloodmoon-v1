model MarketplaceEconomyConfig {
  id                   String   @id @default("default")
  publicationFee       Int      @default(0)
  // DEPRECATED (Open Beta P0 audit, Phase 12): superseded by the three
  // per-currency fields below. Kept, not dropped, so the existing admin
  // API contract (marketplace-admin.service.ts) doesn't break -- but
  // marketplace.service.ts's fee calculation no longer reads this field.
  // Do not wire new behavior to it.
  saleFeePercent       Int      @default(5)
  // Per-currency P2P transaction tax, replacing saleFeePercent (Open Beta
  // P0). wcoinTaxPercent honors the decided 10% WC economic sink via the
  // fixed-point accumulator (wallet-ledger.service.ts) -- goblinPoint/
  // huntPoint stay at their pre-existing 5% rate, explicitly preserved
  // per instruction ("do NOT raise GP/HP to 10% in this phase").
  wcoinTaxPercent       Int      @default(10)
  goblinPointTaxPercent Int      @default(5)
  huntPointTaxPercent   Int      @default(5)
  listingDurationHours Int      @default(168)
  maxListings          Int      @default(10)
  // DEAD FIELD (Open Beta P0 audit, Phase 12): confirmed never read by
  // any fee-calculation code in marketplace.service.ts -- grepped across
  // the whole module, zero references outside this model definition and
  // the admin CRUD endpoint that lets it be set. Not activated. Not
  // wired to VIP tiers. Left in place (not dropped) only because the
  // admin API already exposes it and dropping it is a separate, later
  // decision -- do not build new behavior on top of it without first
  // confirming that's actually intended.
  vipDiscountPercent   Int      @default(0)
  acceptedCurrencies   Json
  minimumPrice         Int      @default(1)
  maximumPrice         Int      @default(1000000)
  cooldownMinutes      Int      @default(0)
  allowedCategories    Json?
  updatedBy            String?  @db.VarChar(191)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ===================================================================
// Open Beta P0 foundation -- wallet ledger (Parts C/D/E of the Economy
// audit, "WC ledger" in product decisions). Currency-aware by design: the
// real fee code already applies uniformly across WCOIN/GOBLIN_POINT/
// HUNT_POINT, so a WC-only ledger would leave GP/HP movements exactly as
// untraceable as they are today. Every AccountCurrency balance mutation
// this phase touches (marketplace purchase/sale, recharge credit) writes
// exactly one row here, inside the same Prisma transaction as the
// balance change itself -- see wallet-ledger.service.ts.
// ===================================================================

enum WalletTransactionType {
  WC_PURCHASE_CREDIT
  PLAYER_MARKET_PURCHASE
  PLAYER_DIRECT_TRANSFER
  SERVER_REWARD
  BUG_HUNTER_REWARD
  ADMIN_ADJUSTMENT
  PAYMENT_REVERSAL
  REFUND
  SYSTEM_CORRECTION
  // Not in the phase spec's suggested list, added for real ledger
  // completeness: a ShopProduct purchase (the official Blood Moon store,
  // commerce.service.ts) spends WC/GP/HP too, but is bought FROM the
  // platform, not another player -- never P2P-taxed, same as
  // WC_PURCHASE_CREDIT/SERVER_REWARD. Left out of the ledger, this would
  // be a real gap in "what happened to this WC after it was credited."
  STORE_PURCHASE
}

enum WalletLedgerStatus {
  SETTLED
  REVERSED
}

model WalletLedgerEntry {
  id                            String                @id @default(uuid())
  // Enforces NO_DUPLICATE_FEE_ON_IDEMPOTENT_RETRY at the database level,
  // not just in application logic -- a retry with the same key can only
  // ever produce one row.
  idempotencyKey                String                @unique @db.VarChar(191)
  type                          WalletTransactionType
  currency                      CurrencyCode
  // Nullable + SetNull, matching the existing AccountModeration/AuditEvent/
  // GameBridgeJob pattern in this schema: a ledger row is audit history
  // and must outlive the account it was about (relevant to Beta account
  // deletion later) rather than cascade-deleting with it.
  accountId                     String?
  counterpartyAccountId         String?
  grossAmount                   Int
  // Whole-unit fee actually collected (balance-deducted) in THIS
  // transaction -- can be 0 for a small transaction whose fee obligation
  // is still accruing in the accumulator, not yet a whole unit.
  taxAmount                     Int                   @default(0)
  netAmount                     Int
  // The EXACT fee obligation this transaction contributed, in subunits
  // (1 currency unit = 10,000 subunits) -- always precise even when
  // taxAmount is 0, so EXACT_CUMULATIVE_10_PERCENT is directly verifiable
  // from ledger rows alone without reconstructing it from accumulator
  // deltas.
  feeObligationSubunits         Int                   @default(0)
  feeAccumulatorSubunitsBefore  Int?
  feeAccumulatorSubunitsAfter   Int?
  sourceType                    String?               @db.VarChar(80)
  sourceId                      String?
  // e.g. a RechargeIntent.id, when this entry is traceable to a real
  // payment -- the Part E/F chargeback-traceability link.
  paymentProvenanceRef          String?
  status                        WalletLedgerStatus    @default(SETTLED)
  metadata                      Json?
  createdAt                     DateTime              @default(now())
  account                       Account?              @relation("WalletLedgerOwner", fields: [accountId], references: [id], onDelete: SetNull)
  counterparty                  Account?              @relation("WalletLedgerCounterparty", fields: [counterpartyAccountId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([counterpartyAccountId, createdAt])
  @@index([type, createdAt])
  @@index([sourceType, sourceId])
}

// ===================================================================
// Open Beta P0 foundation -- Beta reward entitlement (Part K). Deliberately
// decoupled from Account: survives Beta account deletion by design (a
// hashed, normalized email is the durability anchor, not a live FK).
// ===================================================================

enum BetaRewardEntitlementStatus {
  PENDING
  ELIGIBLE
  REJECTED
  CLAIMED
  REVOKED
}

model BetaRewardEntitlement {
  id                   String                       @id @default(uuid())
  betaCycleId          String                       @db.VarChar(80)
  // Hashed, never plaintext -- "do not store more personal data than
  // necessary" (Part K). Claim-time lookup hashes the new account's own
  // normalized email the same way and compares hashes, never storing or
  // querying a plaintext email against this table.
  normalizedEmailHash  String                       @db.VarChar(191)
  // Kept only as long as legally/technically appropriate; nullable so it
  // can be cleared post-deletion without invalidating the row (Part J).
  originalAccountId    String?
  rewardType           String                       @db.VarChar(80)
  rewardAmount         Int
  reason               String                       @db.Text
  sourceType           String                       @db.VarChar(80)
  sourceId             String?
  status               BetaRewardEntitlementStatus  @default(PENDING)
  createdAt            DateTime                     @default(now())
  claimedAt            DateTime?
  claimedByAccountId   String?

  @@index([normalizedEmailHash, betaCycleId])
  @@index([status])
}

// Phase Z -- ELIGIBILITY FACT, deliberately separate from
// BetaRewardEntitlement's own REWARD DEFINITION above. A row here records
// only "this normalized email is confirmed eligible for a reward, for
// this reason" -- never a reward type or amount. Staff (or a future
// reviewed-import) creates these explicitly; nothing here is ever
// inferred from accountPhase or createdAt alone (Part 2/4's explicit
// rule). A separate, later, staff-initiated generation step (see
// BetaRewardsService) turns RECORDED rows into real BetaRewardEntitlement
// rows -- that step is where a reward type/amount finally gets attached,
// keeping "why is this account eligible" and "what do they get" as two
// independently auditable decisions.
enum BetaParticipationSourceType {
  OPEN_BETA_PARTICIPATION
  BUG_HUNTER_CONTRIBUTION
  EVENT_PARTICIPATION
  MANUAL_STAFF_GRANT
  IMPORTED_REVIEWED_LIST
}

enum BetaParticipationRecordStatus {
  RECORDED
  REJECTED
  CONVERTED
}

model BetaParticipationRecord {
  id                     String                         @id @default(uuid())
  betaCycleId            String                         @db.VarChar(80)
  // Same normalization/hash as BetaRewardEntitlement -- computed with the
  // same normalizeEmail/hashNormalizedEmail helpers from
  // beta-lifecycle.service.ts, never re-derived independently.
  normalizedEmailHash    String                         @db.VarChar(191)
  // Best-effort convenience reference to the account this fact was
  // recorded against at the time -- NOT the durability anchor (that's
  // normalizedEmailHash, matching BetaRewardEntitlement's own design), so
  // deliberately not a hard FK: an account being anonymized/purged later
  // must never be blocked by, or silently cascade into deleting, its own
  // participation history.
  accountId              String?
  sourceType             BetaParticipationSourceType
  // Free-form pointer into whatever produced this fact -- e.g. a
  // BugReport.id when sourceType=BUG_HUNTER_CONTRIBUTION. Loosely typed
  // like BetaRewardEntitlement.sourceId for the same reason: the source
  // domain can evolve without a schema migration here.
  sourceId               String?                        @db.VarChar(191)
  // Required, human-readable -- the auditable "why" a reviewer can read
  // months later without reverse-engineering sourceType/sourceId.
  justification          String                         @db.Text
  status                 BetaParticipationRecordStatus  @default(RECORDED)
  recordedById           String
  recordedAt             DateTime                       @default(now())
  // Set once the generation step actually creates a BetaRewardEntitlement
  // from this record -- the idempotency guard: a record already carrying
  // a value here is never converted again.
  convertedEntitlementId String?
  convertedAt            DateTime?

  recordedBy Account @relation("BetaParticipationRecordedBy", fields: [recordedById], references: [id])

  @@unique([normalizedEmailHash, betaCycleId, sourceType, sourceId], name: "uniqueParticipationSource")
  @@index([status])
  @@index([sourceType, sourceId])
  @@index([accountId])
}

// ===================================================================
// Open Beta P0 foundation -- VIP (Parts F/G/H). One VipEntitlement row
// per account (current state, extend-in-place); VipGrant is the
// append-only history of every purchase/extension, mirroring the
// WalletLedgerEntry idempotency pattern.
// ===================================================================

enum VipTier {
  BRONZE
  SILVER
  GOLD
}

enum VipEntitlementStatus {
  INACTIVE
  ACTIVE
  EXPIRED
}

model VipEntitlement {
  id               String                @id @default(uuid())
  accountId        String                @unique
  tier             VipTier?
  activatedAt      DateTime?
  expiresAt        DateTime?
  // Cumulative days ever granted -- audit/analytics only, never used to
  // compute current status (expiresAt is the only source of truth for
  // "is VIP active right now").
  totalDaysGranted Int                   @default(0)
  status           VipEntitlementStatus  @default(INACTIVE)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  account          Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  grants           VipGrant[]
}

model VipGrant {
  id                 String          @id @default(uuid())
  vipEntitlementId   String
  accountId          String
  tier               VipTier
  durationDays       Int
  sourceType         String          @db.VarChar(80)
  sourceId           String?
  idempotencyKey     String          @unique @db.VarChar(191)
  grantedAt          DateTime        @default(now())
  previousExpiresAt  DateTime?
  newExpiresAt       DateTime
  vipEntitlement     VipEntitlement  @relation(fields: [vipEntitlementId], references: [id], onDelete: Cascade)

  @@index([accountId, grantedAt])
}

// GameBridge extension plan (docs/gamebridge/gamebridge-agent-extension-plan.md)
// Part 3B, decision E. The Portal's own memory of "what did we last
// successfully tell the GameServer" -- deliberately separate from
// VipEntitlement, which represents commercial truth, not sync status. This
// separation is what lets the reconciler answer "is there a divergence"
// without re-deriving it from GameBridge command history every time.
model VipSyncState {
  id                String    @id @default(uuid())
  accountId         String    @unique
  // Last AccountLevel (0-3) the reconciler successfully synced to the
  // GameServer. Null means "never synced" -- always a divergence.
  lastSyncedLevel   Int?
  lastSyncedAt      DateTime?
  lastSyncCommandId String?
  // The desiredLevel sent with lastSyncCommandId -- promoted to
  // lastSyncedLevel only once that command is confirmed SUCCEEDED. Kept
  // separate so a stuck/expired in-flight command never gets mistaken for
  // a confirmed sync (the two are only ever merged by reconcileInFlight()).
  pendingDesiredLevel Int?
  // CREATED/QUEUED/.../SUCCEEDED/FAILED_FINAL -- mirrors GameCommandState's
  // status vocabulary so a pending command in flight is distinguishable
  // from one that actually completed.
  lastSyncStatus    String?   @db.VarChar(32)
  // PURCHASE / EXPIRY / RECONCILIATION_DIVERGENCE / MANUAL_ADMIN (plan Part
  // 2's SYNC_VIP_TIER auditoria row) -- lives here, not in the GameServer
  // payload, mirroring GRANT_VIP's "never carry the why across the boundary" rule.
  lastSyncReason    String?   @db.VarChar(32)
  // PHASE L DECISION CLOSURE, Decision 2 (2026-08-31): VIP native drift
  // observability. dbo.bm_SyncVipTier's @PreviousLevel OUTPUT reports the
  // true AccountLevel found on the GameServer immediately before this
  // sync's own unconditional overwrite -- if that doesn't match
  // lastSyncedLevel (the level the Portal itself last confirmed synced),
  // something else wrote AccountLevel in between (native WZ_SetAccountLevel
  // coexistence, a legacy writer, manual DBA action, etc.). driftCount/
  // lastDriftAt track repeated divergence for the SAME account so a
  // one-off (a single native write, corrected once) stays a WARN-level log
  // line, while a pattern (this account diverging again and again) becomes
  // distinguishable and investigable rather than silently re-logged at the
  // same severity forever. Reset is deliberately never automatic -- only
  // vip-sync.service.ts's own drift-handling code clears it, and only when
  // a sync completes with zero divergence, so the count survives across
  // ticks/restarts and genuinely reflects "how many times in a row".
  driftCount        Int       @default(0)
  lastDriftAt       DateTime?
  updatedAt         DateTime  @updatedAt
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// All bonus values default to 0/disabled per explicit instruction ("leave
// unapproved bonuses disabled/zero" / "Do NOT define Bronze +X XP... yet").
// `enabled` is a master switch, also off by default -- flipping individual
// bonus numbers alone is never enough to activate a benefit.
model VipBenefitConfig {
  tier                     VipTier  @id
  xpBonusPercent           Int      @default(0)
  dropBonusPercent         Int      @default(0)
  chaosMachineBonusPercent Int      @default(0)
  resetBenefitEnabled      Boolean  @default(false)
  // Phase 15. Bryan approved exactly two benefit categories as
  // non-power "convenience": extra warehouse storage, and reduced Zen
  // cost on utility commands (PK-clear, stat respec, mail). Both are
  // portal-defined abstractions -- NOT a raw copy of the GameServer's
  // CommandWareNumber_AL* or CommandPKClearMoney_AL*/CommandReAddMoney_AL*
  // values (see docs/vip/vip-benefit-decisions.md "Portal abstraction
  // boundary"). Everything else (xpBonusPercent/dropBonusPercent/
  // chaosMachineBonusPercent/resetBenefitEnabled, and any future field)
  // stays hard-clamped to 0/false in vip.service.ts#upsertBenefitConfig
  // until each is explicitly approved with real numbers -- these two are
  // the only fields that escape that clamp.
  warehouseBonusPages         Int     @default(0)
  commandCostReductionPercent Int     @default(0)
  enabled                  Boolean  @default(false)
  updatedBy                String?  @db.VarChar(191)
  updatedAt                DateTime @updatedAt
}

// Dedicated, lightweight VIP catalog -- deliberately NOT reusing
// ShopProduct/StoreDelivery. That pipeline's delivery step is
// admin-manually processed today (store-admin.service.ts, no automatic
// worker exists yet) and is item-shaped, not time-entitlement-shaped;
// forcing a VIP grant through it would either block on a human clicking
// "process" for every purchase or require deep changes to a system this
// phase shouldn't be touching. A VIP purchase completes synchronously
// instead: debit -> extend VipEntitlement -> VipGrant row, all in one
// transaction (see vip.service.ts) -- apps/api is the source of truth
// for entitlement state (Option C from the audit), with GameServer sync
// queued separately via GRANT_VIP.
// `enabled: false` and `price: 0` by default on every seeded row -- per
// explicit instruction, nothing is purchasable until priced and approved.
model VipProductConfig {
  id           String       @id @default(uuid())
  tier         VipTier
  durationDays Int
  price        Int          @default(0)
  currency     CurrencyCode @default(WCOIN)
  enabled      Boolean      @default(false)
  updatedBy    String?      @db.VarChar(191)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([tier, durationDays])
}

model CommunityProfile {
  id                     String                      @id @default(uuid())
  accountId              String                      @unique
  displayName            String                      @db.VarChar(100)
  bio                    String?                     @db.Text
  avatarUrl              String?                     @db.VarChar(512)
  coverUrl               String?                     @db.VarChar(512)
  isPublic               Boolean                     @default(true)
  mainCharacterName      String?                     @db.VarChar(100)
  mainCharacterClass     String?                     @db.VarChar(100)
  guildName              String?                     @db.VarChar(100)
  featuredAchievementIds Json?
  profileVisibility      String                      @default("PUBLIC") @db.VarChar(20)
  charactersVisibility   String                      @default("MAIN_ONLY") @db.VarChar(20)
  equipmentVisibility    String                      @default("VISIBLE") @db.VarChar(20)
  statisticsVisibility   String                      @default("PRIVATE") @db.VarChar(20)
  guildVisibility        String                      @default("VISIBLE") @db.VarChar(20)
  activityVisibility     String                      @default("VISIBLE") @db.VarChar(20)
  socialSuspendedUntil   DateTime?
  postBlockedUntil       DateTime?
  commentBlockedUntil    DateTime?
  messagesLimitedUntil   DateTime?
  reachLimitedUntil      DateTime?
  warningCount           Int                         @default(0)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  account                Account                     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  moderationActions      CommunityModerationAction[]

  @@index([displayName])
  @@index([socialSuspendedUntil])

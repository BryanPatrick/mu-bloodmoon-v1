// Multi-reaction is deliberate, confirmed by this model's own design
// (Community Step 3 audit): the unique constraints below key on
// (accountId, postId/commentId, TYPE) -- if the intent had been "one
// reaction per account per post", type would not be part of the key. A
// user having both LIKE and HONOR active on the same post at once is
// therefore correct, existing behavior, not a bug -- toggleReaction() in
// community.service.ts toggles each type independently by design.
// The frontend's reaction picker (a single dropdown, one aggregate count
// with no per-type breakdown) doesn't fully expose this multi-type
// semantics -- registered as a P2 product/UX decision (a more granular
// per-type display), not something this audit changes.
model CommunityReaction {
  id        String            @id @default(uuid())
  accountId String
  postId    String?
  commentId String?
  type      String            @default("LIKE") @db.VarChar(40)
  createdAt DateTime          @default(now())
  account   Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  post      CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([accountId, postId, type])
  @@unique([accountId, commentId, type])
  @@index([postId, type])
  @@index([commentId, type])
}


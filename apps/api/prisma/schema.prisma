  disclaimer           String?            @db.Text
  cancelledAt          DateTime?
  cancelledBy          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  guild                Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)


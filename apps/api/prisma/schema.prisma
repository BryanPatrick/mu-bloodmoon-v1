model CommunityProfile {
  id                   String                      @id @default(uuid())
  accountId            String                      @unique
  displayName          String                      @db.VarChar(100)
  bio                  String?                     @db.Text
  avatarUrl            String?                     @db.VarChar(512)
  coverUrl             String?                     @db.VarChar(512)
  isPublic             Boolean                     @default(true)
  mainCharacterName    String?                     @db.VarChar(100)
  mainCharacterClass   String?                     @db.VarChar(100)
  guildName            String?                     @db.VarChar(100)
  featuredAchievementIds Json?
  profileVisibility    String                      @default("PUBLIC") @db.VarChar(20)
  charactersVisibility String                      @default("MAIN_ONLY") @db.VarChar(20)
  equipmentVisibility  String                      @default("VISIBLE") @db.VarChar(20)
  statisticsVisibility String                      @default("PRIVATE") @db.VarChar(20)
  guildVisibility      String                      @default("VISIBLE") @db.VarChar(20)
  activityVisibility   String                      @default("VISIBLE") @db.VarChar(20)
  socialSuspendedUntil DateTime?
  postBlockedUntil     DateTime?
  commentBlockedUntil  DateTime?
  messagesLimitedUntil DateTime?
  reachLimitedUntil    DateTime?
  warningCount         Int                         @default(0)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  account              Account                     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  moderationActions    CommunityModerationAction[]

  @@index([displayName])
  @@index([socialSuspendedUntil])
}

model CommunityFollow {
  id          String   @id @default(uuid())
  followerId  String   @db.VarChar(191)
  followingId String   @db.VarChar(191)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model CommunityUsernameHistory {
  id          String   @id @default(uuid())
  accountId   String   @db.VarChar(191)
  oldUsername String   @db.VarChar(191)
  newUsername String   @db.VarChar(191)
  changedBy   String   @db.VarChar(191)
  reason      String   @db.Text
  createdAt   DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([newUsername])
}

model CommunityPost {
  id                 String                  @id @default(uuid())
  authorId           String
  title              String?                 @db.VarChar(191)
  content            String                  @db.LongText
  type               CommunityPostType       @default(TEXT)
  visibility         CommunityPostVisibility @default(PUBLIC)
  media              Json?
  tags               Json?
  mentions           Json?
  status             CommunityPostStatus     @default(PUBLISHED)
  edited             Boolean                 @default(false)
  editedAt            DateTime?
  sponsored          Boolean                 @default(false)
  official           Boolean                 @default(false)
  sourceType         String?                 @db.VarChar(80)
  sourceId           String?                 @db.VarChar(191)
  isPinned           Boolean                 @default(false)
  isFeatured         Boolean                 @default(false)
  reachLimited       Boolean                 @default(false)
  administrativeEdit Boolean                 @default(false)
  administrativeNote String?                 @db.Text
  editedBy           String?                 @db.VarChar(191)
  hiddenBy           String?                 @db.VarChar(191)
  hiddenAt           DateTime?
  removedBy          String?                 @db.VarChar(191)
  removedAt          DateTime?
  deletionReason     String?                 @db.Text
  publishedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  author             Account                 @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments           CommunityComment[]
  reactions          CommunityReaction[]
  reports            CommunityReport[]
  revisions          CommunityPostRevision[]
  mediaAssets        CommunityMedia[]
  saves              CommunityPostSave[]
  reposts            CommunityRepost[]

  @@index([status, publishedAt])
  @@index([authorId, createdAt])
  @@index([isPinned, isFeatured, createdAt])
  @@index([type, visibility, status, createdAt])
  @@index([sourceType, sourceId])
}

model CommunityMedia {
  id           String               @id @default(uuid())
  ownerId      String
  postId       String?
  kind         CommunityMediaKind
  status       CommunityMediaStatus @default(TEMPORARY)
  url          String               @db.VarChar(512)
  storagePath  String               @db.VarChar(512)
  originalName String               @db.VarChar(255)
  mimeType     String               @db.VarChar(100)
  extension    String               @db.VarChar(12)
  sizeBytes    Int
  width        Int
  height       Int
  sha256       String               @db.VarChar(64)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  removedAt    DateTime?
  post         CommunityPost?       @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([ownerId, status, createdAt])
  @@index([postId])
  @@index([sha256])
}

model CommunityPostRevision {
  id         String                  @id @default(uuid())
  postId     String
  title      String?                 @db.VarChar(191)
  content    String                  @db.LongText
  type       CommunityPostType
  visibility CommunityPostVisibility
  media      Json?
  tags       Json?
  mentions   Json?
  editedBy   String                  @db.VarChar(191)
  editorRole String                  @db.VarChar(40)
  reason     String                  @db.Text
  createdAt  DateTime                @default(now())
  post       CommunityPost           @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model CommunityComment {
  id        String              @id @default(uuid())
  postId    String
  authorId  String
  parentId  String?
  content   String              @db.Text
  status    CommunityPostStatus @default(PUBLISHED)
  hiddenBy  String?             @db.VarChar(191)
  hiddenAt  DateTime?
  removedBy String?             @db.VarChar(191)
  removedAt DateTime?
  reason    String?             @db.Text
  edited    Boolean             @default(false)
  editedAt  DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  post      CommunityPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    Account             @relation("CommunityCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent    CommunityComment?   @relation("CommunityCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CommunityComment[]  @relation("CommunityCommentReplies")
  reactions CommunityReaction[]
  reports   CommunityReport[]
  revisions CommunityCommentRevision[]

  @@index([postId, status, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId])
}

model CommunityCommentRevision {
  id         String           @id @default(uuid())
  commentId  String
  content    String           @db.Text
  editedBy   String           @db.VarChar(191)
  editorRole String           @db.VarChar(40)
  reason     String           @db.Text
  createdAt  DateTime         @default(now())
  comment    CommunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId, createdAt])
}

model CommunityReaction {
  id        String            @id @default(uuid())
  accountId String
  postId    String?
  commentId String?
  type      String            @default("LIKE") @db.VarChar(40)
  createdAt DateTime          @default(now())
  account   Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  post      CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([accountId, postId, type])
  @@unique([accountId, commentId, type])
  @@index([postId, type])
  @@index([commentId, type])
}

model CommunityPostSave {
  id           String        @id @default(uuid())
  accountId    String        @db.VarChar(191)
  postId       String
  collectionId String?       @db.VarChar(191)
  createdAt    DateTime      @default(now())
  post         CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([accountId, postId])
  @@index([accountId, createdAt])
  @@index([accountId, collectionId, createdAt])
  @@index([postId])
}

model CommunityRepost {
  id        String        @id @default(uuid())
  accountId String        @db.VarChar(191)
  postId    String
  comment   String?       @db.VarChar(500)
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([accountId, postId])
  @@index([accountId, createdAt])
  @@index([postId, createdAt])
}

model CommunitySocialRelation {
  id        String                      @id @default(uuid())
  actorId   String                      @db.VarChar(191)
  targetId  String                      @db.VarChar(191)
  type      CommunitySocialRelationType
  createdAt DateTime                    @default(now())

  @@unique([actorId, targetId, type])
  @@index([actorId, type, createdAt])
  @@index([targetId, type, createdAt])
}

model CommunityReport {
  id             String                  @id @default(uuid())
  reporterId     String
  reportedUserId String?
  postId         String?
  commentId      String?
  reason         String                  @db.VarChar(191)
  description    String?                 @db.Text
  evidence       Json?
  priority       CommunityReportPriority @default(NORMAL)
  status         CommunityReportStatus   @default(NEW)
  assigneeId     String?                 @db.VarChar(191)
  decision       String?                 @db.Text
  internalNotes  String?                 @db.Text
  dueAt          DateTime?
  resolvedBy     String?                 @db.VarChar(191)
  resolvedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  reporter       Account                 @relation("CommunityReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   Account?                @relation("CommunityReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  post           CommunityPost?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment        CommunityComment?       @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([status, priority, createdAt])
  @@index([assigneeId, status])
  @@index([reportedUserId, createdAt])
}

model CommunityModerationAction {
  id         String                  @id @default(uuid())
  profileId  String
  actorId    String                  @db.VarChar(191)
  type       CommunityModerationType
  reason     String                  @db.Text
  expiresAt  DateTime?
  restoredAt DateTime?
  restoredBy String?                 @db.VarChar(191)
  evidence   Json?
  createdAt  DateTime                @default(now())
  profile    CommunityProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, type, createdAt])
  @@index([actorId, createdAt])
}

model CommunityAchievement {
  id          String                      @id @default(uuid())
  name        String                      @db.VarChar(191)
  slug        String                      @unique @db.VarChar(191)
  description String                      @db.Text
  category    String                      @db.VarChar(100)
  rarity      CommunityAchievementRarity  @default(COMMON)
  points      Int                         @default(0)
  condition   Json?
  imageUrl    String?                     @db.VarChar(512)
  isActive    Boolean                     @default(false)
  createdBy   String                      @db.VarChar(191)
  updatedBy   String                      @db.VarChar(191)
  deletedAt   DateTime?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  grants      CommunityAchievementGrant[]

  @@index([isActive, category])
  @@index([deletedAt])
}

model CommunityAchievementGrant {
  id            String               @id @default(uuid())
  achievementId String
  accountId     String
  grantedBy     String?              @db.VarChar(191)
  reason        String?              @db.Text
  progressData  Json?
  grantedAt     DateTime             @default(now())
  revokedAt     DateTime?
  revokedBy     String?              @db.VarChar(191)
  revokeReason  String?              @db.Text
  achievement   CommunityAchievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  account       Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([achievementId, accountId])
  @@index([accountId, grantedAt])
}

model CommunityQuest {
  id               String                      @id @default(uuid())
  name             String                      @db.VarChar(191)
  slug             String                      @unique @db.VarChar(191)
  description      String                      @db.Text
  objective        Json
  reward           Json
  audience         Json?
  participantLimit Int?
  startsAt         DateTime?
  endsAt           DateTime?
  status           CommunityQuestStatus        @default(DRAFT)
  createdBy        String                      @db.VarChar(191)
  updatedBy        String                      @db.VarChar(191)
  publishedBy      String?                     @db.VarChar(191)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  participants     CommunityQuestParticipant[]

  @@index([status, startsAt, endsAt])
}

model CommunityQuestParticipant {
  id           String         @id @default(uuid())
  questId      String
  accountId    String
  progress     Int            @default(0)
  progressData Json?
  completedAt  DateTime?
  rewardedAt   DateTime?
  validatedBy  String?        @db.VarChar(191)
  joinedAt     DateTime       @default(now())
  quest        CommunityQuest @relation(fields: [questId], references: [id], onDelete: Cascade)
  account      Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([questId, accountId])
  @@index([questId, completedAt])
}

model CommunityBadge {
  id          String                @id @default(uuid())
  name        String                @db.VarChar(191)
  slug        String                @unique @db.VarChar(191)
  description String                @db.Text
  imageUrl    String?               @db.VarChar(512)
  visibility  String                @default("PUBLIC") @db.VarChar(40)
  maxGrants   Int?
  validDays   Int?
  isActive    Boolean               @default(true)
  createdBy   String                @db.VarChar(191)
  updatedBy   String                @db.VarChar(191)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  grants      CommunityBadgeGrant[]

  @@index([isActive, visibility])
}

model CommunityBadgeGrant {
  id        String         @id @default(uuid())
  badgeId   String
  accountId String
  grantedBy String         @db.VarChar(191)
  reason    String         @db.Text
  grantedAt DateTime       @default(now())
  expiresAt DateTime?
  removedAt DateTime?
  removedBy String?        @db.VarChar(191)
  badge     CommunityBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  account   Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([badgeId, accountId])
  @@index([accountId, expiresAt])
}

model CommunityPolicy {
  id                     String   @id @default("default")
  blockedWords           Json?
  allowedDomains         Json?
  blockedDomains         Json?
  spamRules              Json?
  maxPostsPerHour        Int      @default(10)
  maxCommentsPerHour     Int      @default(40)
  postCooldownSeconds    Int      @default(30)
  commentCooldownSeconds Int      @default(10)
  usernameCooldownDays   Int      @default(30)
  updatedBy              String?  @db.VarChar(191)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model CommunityTask {
  id          String                  @id @default(uuid())
  title       String                  @db.VarChar(191)
  description String?                 @db.Text
  entityType  String                  @db.VarChar(100)
  entityId    String?                 @db.VarChar(191)
  status      CommunityTaskStatus     @default(PENDING)
  priority    CommunityReportPriority @default(NORMAL)
  assigneeId  String?                 @db.VarChar(191)
  dueAt       DateTime?
  evidence    Json?
  createdBy   String                  @db.VarChar(191)
  updatedBy   String                  @db.VarChar(191)
  completedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([assigneeId, status])
  @@index([entityType, entityId])
  @@index([dueAt, status])
}

model GameBridgeJob {
  id             String               @id @default(uuid())
  accountId      String?
  listingId      String?
  orderId        String?
  operation      GameBridgeOperation
  status         GameBridgeStatus     @default(PENDING)
  idempotencyKey String               @unique
  attempts       Int                  @default(0)
  payload        Json
  result         Json?
  error          String?              @db.Text
  availableAt    DateTime             @default(now())
  processedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  account        Account?             @relation(fields: [accountId], references: [id], onDelete: SetNull)
  listing        PlayerMarketListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  order          PlayerMarketOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([listingId])
  @@index([orderId])
  @@index([operation])
  @@index([status])
  @@index([availableAt])
}

model GuildMedia {
  id                  String           @id @default(uuid())
  guildId             String
  uploadedByAccountId String
  kind                GuildMediaKind
  status              GuildMediaStatus @default(READY)
  url                 String           @db.VarChar(512)
  storagePath         String           @db.VarChar(512)
  originalName        String           @db.VarChar(255)
  mimeType            String           @db.VarChar(100)
  extension           String           @db.VarChar(10)
  sizeBytes           Int
  width               Int
  height              Int
  sha256              String           @db.VarChar(64)
  removedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  guild               Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, kind])
}

// ---- Guilds: Tier B (real model, zero reachable write endpoint this round) ----

model GuildTreasury {
  id        String                 @id @default(uuid())
  guildId   String                 @unique
  createdAt DateTime               @default(now())
  guild     Guild                  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  balances  GuildTreasuryBalance[]
}

// Normalized, not a Json blob -- the resource catalog is genuinely
// open-ended (currencies, jewels, materials, seasonal resources, future
// Alliance transfers). resourceType/resourceKey are free text on purpose:
// the seed rows created at guild-creation (ZEN, WCOIN, GOBLIN_POINT,
// HUNT_POINT, JEWEL_BLESS, JEWEL_SOUL, JEWEL_CHAOS) are a minimal demo seed,
// not a definitive catalog -- more keys (Life/Creation/Harmony/Guardian/
// Gemstone jewels, materials, seasonal currencies, ...) must be addable with
// zero schema change. No endpoint ever updates availableAmount/
// reservedAmount this round; a deposit never grants guildXp (see module
// header) and reservedAmount stays 0 until a future project/request hold.
model GuildTreasuryBalance {
  id              String        @id @default(uuid())
  guildTreasuryId String
  resourceType    String        @db.VarChar(40)
  resourceKey     String        @db.VarChar(60)
  availableAmount BigInt        @default(0)
  reservedAmount  BigInt        @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  treasury        GuildTreasury @relation(fields: [guildTreasuryId], references: [id], onDelete: Cascade)

  @@unique([guildTreasuryId, resourceKey])
}

model GuildVault {
  id        String           @id @default(uuid())
  guildId   String           @unique
  createdAt DateTime         @default(now())
  guild     Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  items     GuildVaultItem[]
}

model GuildVaultItem {
  id           String     @id @default(uuid())
  guildVaultId String
  itemRef      String     @db.VarChar(191)
  quantity     Int        @default(1)
  metadata     Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  vault        GuildVault @relation(fields: [guildVaultId], references: [id], onDelete: Cascade)

  @@index([guildVaultId])
}

// The only conceptual path anything will ever move resources/items through
// in a future round -- no direct balance mutation is ever modeled, closing
// off the deposit->withdraw->deposit (or guild A->B->A) double-credit shape.
// Deliberately NOT wired into Guild's relation graph (no `guild Guild
// @relation` field, plain guildId scalar only) -- only reachable by raw
// guildId, so it stays structurally obvious nothing in the service touches
// these rows yet. No endpoint creates or reads these this round.
model GuildMovement {
  id                   String                  @id @default(uuid())
  guildId              String
  type                 GuildMovementType
  status               GuildApprovalStatus     @default(PENDING)
  resourceKey          String                  @db.VarChar(60)
  amount               BigInt
  requestedByAccountId String
  reason               String?                 @db.Text
  beforeBalance        Json?
  afterBalance         Json?
  correlationId        String?                 @db.VarChar(80)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  approvals            GuildMovementApproval[]

  @@index([guildId, status])
  @@index([resourceKey])
}

model GuildMovementApproval {
  id                String              @id @default(uuid())
  guildMovementId   String
  approverAccountId String
  status            GuildApprovalStatus @default(PENDING)
  note              String?             @db.Text
  decidedAt         DateTime?
  createdAt         DateTime            @default(now())
  movement          GuildMovement       @relation(fields: [guildMovementId], references: [id], onDelete: Cascade)

  @@index([guildMovementId])
}

// GM operational occurrences foundation (Etapa 3). Deliberately generic --
// a row can represent a report, an event incident, suspicious behaviour, a
// dispute, or anything else a GM needs to track and hand off. No automatic
// punishment is ever derived from this model; it is a tracking/handoff tool
// only. type/targetType are free text (not enums) for the same open-ended
// reason as OperationalEvent.module.
enum GmOccurrenceStatus {
  OPEN
  IN_REVIEW
  ACTION_REQUIRED
  RESOLVED
  DISMISSED
}

model GmOccurrence {
  id           String               @id @default(uuid())
  type         String               @db.VarChar(100)
  priority     GmOccurrencePriority @default(MEDIUM)
  description  String               @db.Text
  targetType   String?              @db.VarChar(100)
  targetId     String?              @db.VarChar(191)
  status       GmOccurrenceStatus   @default(OPEN)
  createdById  String
  assignedToId String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  resolvedAt   DateTime?
  createdBy    Account              @relation("GmOccurrenceCreatedBy", fields: [createdById], references: [id])
  assignedTo   Account?             @relation("GmOccurrenceAssignedTo", fields: [assignedToId], references: [id])
  notes        GmOccurrenceNote[]

  @@index([status, createdAt])
  @@index([priority, status])
  @@index([targetType, targetId])
  @@index([assignedToId])
}

// Fixed, small set that drives SLA computation and sort order in the GM UI
// -- unlike GmOccurrence.type (free text, open-ended categories), the set of
// priority tiers is deliberately closed, so an enum instead of free text.
enum GmOccurrencePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model GmOccurrenceNote {
  id           String       @id @default(uuid())
  occurrenceId String
  authorId     String
  note         String       @db.Text
  createdAt    DateTime     @default(now())
  occurrence   GmOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  author       Account      @relation(fields: [authorId], references: [id])

  @@index([occurrenceId, createdAt])
}

// GM events MVP (Etapa 4). Four deliberately separate concepts, per the
// audit confirming no existing model covers this (CommunityQuest is social
// gamification; RoadmapItem is the changelog; OperationalEvent is a log;
// GmOccurrence is a ticket -- none of them are schedulable game events):
//   GmEventDefinition -- the configured/reusable event (what it is)
//   GmEventSchedule    -- when it is meant to happen
//   GmEventRun         -- one specific execution/occurrence
//   GmEventResult      -- the outcome of that execution, GM-validated
// executionMode distinguishes who is expected to drive a run: the system
// (AUTOMATED), a GM by hand (MANUAL_GM), or both (HYBRID, system prepares,
// GM confirms/accompanies) -- see gm-events.service.ts header for how this
// is enforced today (MANUAL_GM/HYBRID only; AUTOMATED has no driver yet).
// origin stays a free-text string, not an enum, deliberately: the audit
// confirmed there is no live connection to the MU game server today
// (MU_BRIDGE_ENABLED=false, game-integration.contract.ts is a types-only
// stub) so every run this round is "PORTAL_ONLY" -- the portal recorded
// the operation without confirming the game server did anything. A future
// real integration adds a new origin value, not a schema migration,
// matching the same free-text precedent as OperationalEvent.module and
// GmOccurrence.type.
enum GmEventExecutionMode {
  AUTOMATED
  MANUAL_GM
  HYBRID
}

enum GmEventDefinitionStatus {
  ACTIVE
  INACTIVE
}

model GmEventDefinition {
  id            String                  @id @default(uuid())
  key           String                  @unique @db.VarChar(100)
  name          String                  @db.VarChar(191)
  description   String?                 @db.Text
  category      String                  @db.VarChar(100)
  executionMode GmEventExecutionMode    @default(MANUAL_GM)
  status        GmEventDefinitionStatus @default(ACTIVE)
  createdById   String
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  createdBy     Account                 @relation("GmEventDefinitionCreatedBy", fields: [createdById], references: [id])
  schedules     GmEventSchedule[]
  runs          GmEventRun[]

  @@index([status])
}

model GmEventSchedule {
  id             String            @id @default(uuid())
  definitionId   String
  startsAt       DateTime
  endsAt         DateTime?
  recurrenceNote String?           @db.VarChar(191)
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  definition     GmEventDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  runs           GmEventRun[]

  @@index([definitionId, startsAt])
}

enum GmEventRunStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
  PROBLEM_REPORTED
}

model GmEventRun {
  id             String            @id @default(uuid())
  definitionId   String
  scheduleId     String?
  status         GmEventRunStatus  @default(SCHEDULED)
  // "PORTAL_ONLY" today (no live game-server connection exists -- see the
  // header comment above), plus three reserved-but-unused values a future
  // real GameBridge connection will actually produce: "GAMEBRIDGE_PENDING"
  // (call in flight), "GAMEBRIDGE_CONNECTED" (call succeeded),
  // "GAMEBRIDGE_ERROR" (call attempted and honestly failed -- never a fake
  // success). Free text, not an enum, for the same reason as
  // GmOccurrence.type: the value set is expected to grow without a schema
  // migration. See gm/event-executors/ for the abstraction that produces it.
  origin         String            @default("PORTAL_ONLY") @db.VarChar(40)
  // Doubles as the future GameBridge call's idempotency key (mirrors
  // GameBridgeJob.idempotencyKey's role for marketplace escrow) and as the
  // cross-system trace id (mirrors the correlationId convention already used
  // by SystemError/OperationalEvent/SystemAlert/PlayerMarketOrder). Set once
  // at run creation, before any executor is invoked.
  correlationId  String            @unique @default(uuid())
  // How many times an executor was actually invoked for this run -- prepared
  // for a future retry policy; today every run attempts exactly once.
  bridgeAttempts Int               @default(0)
  // Raw payload/message from whichever executor ran (Portal or, later,
  // GameBridge). Both stay null for the Portal path today since there is
  // nothing external to report.
  externalResult Json?
  externalError  String?           @db.Text
  startedById    String?
  startedAt      DateTime?
  endedById      String?
  endedAt        DateTime?
  cancelledById  String?
  cancelledAt    DateTime?
  cancelReason   String?           @db.Text
  problemNote    String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  definition     GmEventDefinition @relation(fields: [definitionId], references: [id])
  schedule       GmEventSchedule?  @relation(fields: [scheduleId], references: [id])
  startedBy      Account?          @relation("GmEventRunStartedBy", fields: [startedById], references: [id])
  endedBy        Account?          @relation("GmEventRunEndedBy", fields: [endedById], references: [id])
  cancelledBy    Account?          @relation("GmEventRunCancelledBy", fields: [cancelledById], references: [id])
  result         GmEventResult?

  @@index([definitionId, status])
  @@index([status, createdAt])
}

enum GmEventResultStatus {
  PENDING_VALIDATION
  VALIDATED
  INVALIDATED
}

model GmEventResult {
  id               String              @id @default(uuid())
  runId            String              @unique
  summary          String              @db.Text
  participantCount Int?
  status           GmEventResultStatus @default(PENDING_VALIDATION)
  validatedById    String?
  validatedAt      DateTime?
  invalidateReason String?             @db.Text
  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  run              GmEventRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdBy        Account             @relation("GmEventResultCreatedBy", fields: [createdById], references: [id])
  validatedBy      Account?            @relation("GmEventResultValidatedBy", fields: [validatedById], references: [id])
}

// Phase 3D-B. An append-only log of every automatic dispatch/reconcile
// attempt the reconciliation worker makes for a GameAccountIdentity, used
// for exponential backoff, the automatic-attempt ceiling, and the admin
// operational view (Part AN/AO). Deliberately has NO Prisma relation to
// GameAccountIdentity/GameAccountCredential (Phase 3D-A, owned by a
// concurrent workstream) -- accountId/provisioningRequestId are plain
// columns, joined by value only, so this model never requires touching
// either of those files. Never stores ciphertext, raw SQL errors, or any
// credential material -- errorCode mirrors the same safe, structured codes
// GameAccountIdentity.lastErrorCode already uses.
model GameProvisioningAttempt {
  id                    String   @id @default(uuid())
  accountId             String   @db.VarChar(191)
  provisioningRequestId String   @db.VarChar(191)
  attemptNumber         Int
  outcome               String   @db.VarChar(40)
  errorCode             String?  @db.VarChar(191)
  attemptedAt           DateTime @default(now())

  @@index([accountId])
  @@index([provisioningRequestId])
  @@index([attemptedAt])
}

// Launcher CMS Studio phase. STRUCTURE (which slots exist, where they sit,
// what type/constraints each has) is a static TypeScript catalog --
// launcher-studio/slot-registry.ts -- never a database row, so the CMS can
// never introduce a slot the compiled Launcher doesn't already know how to
// render. These models hold only the CONTENT an operator puts into an
// already-declared slot. slotId always matches a live slot-registry id;
// there is no FK to enforce that (the registry isn't a table) so the
// service layer validates it on every write.
//
// Deliberately separate from the existing SiteSetting-JSON-blob pattern
// launcher.service.ts already uses for campaign/socials/utilities -- that
// pattern has exactly one row per key with a single status, so a draft can
// never sit alongside a still-live published value (see LauncherSlotContent
// below). Reusing SiteSetting here would mean writing a slot's edit
// straight over its live value, which Part AE (edit must not immediately
// affect clients) explicitly rules out. The existing SiteSetting-backed
// bootstrap fields are untouched -- this is an additive parallel path for
// the slots newly declared by the registry.
model LauncherSlotContent {
  id                 String             @id @default(uuid())
  slotId             String             @unique @db.VarChar(191)
  pageKey            String             @db.VarChar(60)
  status             LauncherSlotStatus @default(DRAFT)
  draftValue         Json
  publishedValue     Json?
  publishedInVersion Int?
  updatedBy          String?
  publishedBy        String?
  publishedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([pageKey])
  @@index([status])
}

// One row per publish (Part AF: contentVersion the Launcher can key
// cache/update off) and one row per rollback (Part AG) -- rollback is
// always a new, forward-moving publish that restores older per-slot
// snapshots, never a destructive rewrite of history.
model LauncherContentPublish {
  id          String   @id @default(uuid())
  version     Int      @unique @default(autoincrement())
  kind        String   @default("PUBLISH") @db.VarChar(20) // PUBLISH | ROLLBACK
  note        String?  @db.Text
  publishedBy String?
  publishedAt DateTime @default(now())

  @@index([publishedAt])
}

// Per-slot snapshot captured at every publish/rollback, keyed by the
// LauncherContentPublish.version it belongs to -- how rollback finds "what
// was this slot's published value as of version N" without ever deleting a
// prior value.
model LauncherSlotContentRevision {
  id        String   @id @default(uuid())
  slotId    String   @db.VarChar(191)
  version   Int
  value     Json
  createdAt DateTime @default(now())

  @@unique([slotId, version])
  @@index([slotId])
}

// Central asset library (Part M/N/O). One asset, many consumers (Launcher
// slot content, future Website/Discord/Game reuse) -- content should
// reference an id here rather than duplicate a URL. Deliberately separate
// from ReferenceAsset: that model's shape (sourceUrl/duplicateOf/
// ReferenceSource/KnowledgeEntryAsset.role) is purpose-built for the
// web-scraped knowledge-base pipeline, not a general editorial asset
// library with consumer categories -- reusing it here would conflate two
// different domains rather than avoid a duplicate one.
model LauncherAsset {
  id              String                       @id @default(uuid())
  name            String                       @db.VarChar(191)
  category        LauncherAssetCategory
  mimeType        String                       @db.VarChar(80)
  width           Int?
  height          Int?
  sizeBytes       Int
  sha256          String                       @db.VarChar(64)
  storageProvider LauncherAssetStorageProvider @default(LOCAL)
  storageKey      String                       @db.VarChar(512)
  publicUrl       String?                      @db.VarChar(512)
  status          EditorialStatus              @default(PUBLISHED)
  createdBy       String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([category])
  @@index([sha256])
  @@index([status])
}

// Part V/W -- purchase-terms versions and the backend-recorded acceptance
// on PurchaseIntent below. The backend, not the frontend checkbox, is the
// source of truth for which version an account accepted.
model StorePurchaseTerms {
  id          String   @id @default(uuid())
  version     Int      @unique @default(autoincrement())
  title       String   @db.VarChar(191)
  content     String   @db.Text
  effectiveAt DateTime @default(now())
  active      Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([active])
}

enum LauncherSlotStatus {
  DRAFT
  PUBLISHED
}

enum LauncherAssetCategory {
  LAUNCHER
  WEBSITE
  GAME
  CLASSES
  ITEMS
  EVENTS
  NEWS
  CAMPAIGNS
  BRANDING
  SYSTEM
}

enum LauncherAssetStorageProvider {
  LOCAL
  R2
}

// ============================================================
// Player preferences foundation (Phase K, "Player preferences
// foundation" instruction, 2026-08-30). Reusable notification/visibility
// preference architecture -- no UI built against this yet. The
// ESSENTIAL/OPTIONAL split is a hard constraint: PlayerPreferenceCategory
// is a property of the DEFINITION (the catalog entry), not something a
// player or admin can flip per-row -- a definition seeded as ESSENTIAL
// has no player-facing toggle in this design at all, so security/
// account-critical/required-service messages are never modeled as
// something a player COULD disable in the first place.
// ============================================================

enum PlayerPreferenceCategory {
  ESSENTIAL
  OPTIONAL
}

// The catalog of preference keys. Seeded by product/engineering, not
// player-created. `category` is fixed per key -- see the constraint note
// above.
model PlayerPreferenceDefinition {
  key         String                   @id @db.VarChar(64)
  label       String                   @db.VarChar(200)
  description String?                  @db.VarChar(500)
  category    PlayerPreferenceCategory
  createdAt   DateTime                 @default(now())

  preferences PlayerPreference[]
}

// One row per (account, definition) the player has an explicit choice
// recorded for. Absence of a row means "use the definition's default"
// (not modeled here -- a UI-layer concern), not "disabled."
model PlayerPreference {
  id             String   @id @default(uuid())
  accountId      String
  definitionKey  String
  enabled        Boolean
  updatedAt      DateTime @updatedAt

  definition PlayerPreferenceDefinition @relation(fields: [definitionKey], references: [key], onDelete: Cascade)

  @@unique([accountId, definitionKey])
  @@index([accountId])
}

// PHASE U (2026-09-03) -- Progression control plane (XP/Drop/Reset/
// Master Reset). Same desired-state/effective-state/drift shape as
// LegacyCatalogItem (ADR-0024) -- see docs/decisions/0025-progression-
// control-plane.md for the full design and docs/progression/
// progression-config-field-matrix.md for the real, hash-verified
// GameServer config values each row traces back to.
enum ProgressionDomain {
  EXPERIENCE
  DROP
  RESET
  MASTER_RESET
}

enum ProgressionDriftStatus {
  NOT_CHECKED
  IN_SYNC
  DRIFT_DETECTED
  CHECK_FAILED
  NOT_MANAGED
}

enum ProgressionRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ===================================================================
// Phase P (2026-08-31) -- payment antifraud foundation
// (PaymentRiskSignal/PaymentRiskCase/PaymentRiskCaseAction) and a formal
// chargeback case model (ChargebackCase), replacing the previously-
// informal MANUAL_REVIEW + "charged_back:" prefix convention. Every
// signal carries a human-readable `reason` and structured `evidence` --
// there is no opaque score anywhere in this design. accountId is
// nullable and NOT a hard-required relation on PaymentRiskSignal/
// PaymentRiskCase/ChargebackCase on purpose: these rows must be able to
// outlive the account they were about. See
// docs/decisions/0019-payment-operational-closure-phase-p.md.
// ===================================================================

enum PaymentRiskSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// PHASE V (2026-09-04) -- distinct from driftStatus (a TECHNICAL axis:
// does desired match effective) and from desiredValue (the Portal's
// own target). This is a BUSINESS axis: has this specific effective
// value ever received real Bryan/product approval as an intentional
// VIP/progression benefit, independent of whether the Portal has an
// opinion about it. Bryan's own explicit instruction this phase: "current
// effective config values are NOT automatically approved Blood Moon VIP
// benefits" -- most rows seed as EFFECTIVE_BUT_UNAPPROVED for exactly
// this reason, never APPROVED by default.
enum ProgressionPolicyStatus {
  NOT_EVALUATED
  APPROVED
  EFFECTIVE_BUT_UNAPPROVED
  POLICY_DRIFT
  DISABLED
  UNKNOWN
}

model ProgressionConfigItem {
  id            String            @id @default(uuid())
  domain        ProgressionDomain
  // Business-facing key (e.g. "xp.rate", "reset.cap") -- deliberately
  // NOT the raw GameServer config key (e.g. "AddExperienceRate_AL0-3")
  // per Part 12's explicit instruction not to expose only cryptic
  // config keys. The raw key(s) live in technicalSource below, always
  // visible in the detail view.
  key           String
  friendlyLabel String
  description   String?           @db.Text
  // Deliberately nullable and free-text, never "x"/"%" unless the real
  // unit is proven (Part 13, mandatory) -- see
  // docs/progression/xp-stacking-investigation.md for why most XP
  // fields carry an explicit "unidade nao confirmada" unit rather than
  // a percent sign.
  unit          String?
  // { file, key, shape: 'flat'|'perTier' } -- the exact source this row
  // was generated from, always traceable back to a real config line.
  technicalSource Json
  riskLevel     ProgressionRiskLevel @default(MEDIUM)
  // null = Portal has no opinion yet (never a false drift, same rule
  // LegacyCatalogEffectiveStateService already established). A flat
  // number here against a perTier effectiveValue means "one target
  // applies to every tier" (e.g. reset.cap's policy target = 20).
  desiredValue    Json?
  desiredReason   String?          @db.Text
  effectiveValue  Json?
  driftStatus     ProgressionDriftStatus @default(NOT_CHECKED)
  // PHASE V -- see ProgressionPolicyStatus's own comment for the
  // driftStatus/policyStatus distinction. Set from real product
  // classification (this phase's own VIP policy drift matrix), reset on
  // every reseed alongside riskLevel/description -- this is analysis
  // truth, not an individual admin's desired-state opinion, so it is
  // NOT protected from reseed the way desiredValue is.
  policyStatus    ProgressionPolicyStatus @default(NOT_EVALUATED)
  sourceLastReadAt DateTime?
  sourceFingerprint String?
  internalNotes   String?          @db.Text
  version         Int              @default(1)
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([domain, key])
  @@index([driftStatus])
  @@index([riskLevel])
  @@index([policyStatus])
}

enum PaymentRiskSignalType {
  // Wired to a real detector this phase (payment-risk.service.ts).
  NEW_ACCOUNT_HIGH_VALUE_PURCHASE
  MULTIPLE_FAILED_PAYMENTS
  REPEATED_CHARGEBACK
  RAPID_PURCHASE_SEQUENCE
  DELIVERY_ANOMALY
  PROVIDER_REVIEW_STATE
  // Wired this phase too, from wallet-transfer.service.ts's own
  // evaluateTransferRiskSignals() -- the direct-WC-transfer feature this
  // phase built specifically because these signals had no real P2P
  // movement to observe before.
  IMMEDIATE_WCOIN_TRANSFER
  NEAR_FULL_BALANCE_TRANSFER
  MANY_RECIPIENTS_AFTER_PURCHASE
  REPEATED_RECIPIENT_NETWORK
  // Deliberately UNSUPPORTED: Mercado Pago's real Orders API response
  // never returns a payer identifier on GET/webhook (only sent in the
  // CREATE request, never echoed back) -- there is no reliable field to
  // compare against the account's registered email, and this codebase
  // does not use fragile proxies (payer display name, etc.) for a fraud
  // signal. Kept in the enum (not omitted) so a future phase extends
  // additively if a reliable provider identifier ever becomes available.
  PAYMENT_ACCOUNT_MISMATCH
}

enum PaymentRiskCaseStatus {
  OPEN
  UNDER_REVIEW
  CLEARED
  CONFIRMED_FRAUD
  CLOSED
}

// Explicit, configurable actions a reviewer can record against a case --
// never an automatic consequence of a signal firing on its own.
// MANUAL_REVIEW here is a case-workflow marker, distinct from
// RechargeIntentStatus.MANUAL_REVIEW.
enum PaymentRiskAction {
  MANUAL_REVIEW
  PAYMENT_RESTRICTION
  TRANSFER_RESTRICTION
  ACCOUNT_RESTRICTION
}

model PaymentRiskSignal {
  id         String                @id @default(uuid())
  accountId  String?
  signalType PaymentRiskSignalType
  severity   PaymentRiskSeverity
  sourceType String?               @db.VarChar(80)
  sourceId   String?
  // Human-readable WHY this signal fired -- always present, "no black-box
  // score without evidence." evidence carries the concrete numbers/ids a
  // reviewer needs to verify the reason themselves.
  reason     String                @db.Text
  evidence   Json?
  riskCaseId String?
  detectedAt DateTime              @default(now())
  account    Account?              @relation(fields: [accountId], references: [id], onDelete: SetNull)
  riskCase   PaymentRiskCase?      @relation(fields: [riskCaseId], references: [id], onDelete: SetNull)

  @@index([accountId, detectedAt])
  @@index([signalType])
  @@index([riskCaseId])
}

model PaymentRiskCase {
  id                   String                  @id @default(uuid())
  accountId            String?
  status               PaymentRiskCaseStatus   @default(OPEN)
  highestSeverity      PaymentRiskSeverity
  summary              String                  @db.Text
  reviewNotes          String?                 @db.Text
  resolution           String?                 @db.Text
  openedAt             DateTime                @default(now())
  resolvedAt           DateTime?
  resolvedByAccountId  String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  account              Account?                @relation(fields: [accountId], references: [id], onDelete: SetNull)
  signals              PaymentRiskSignal[]
  actions              PaymentRiskCaseAction[]

  @@index([accountId])
  @@index([status])
}

model PaymentRiskCaseAction {
  id                    String            @id @default(uuid())
  riskCaseId            String
  action                PaymentRiskAction
  reason                String            @db.Text
  performedByAccountId  String
  performedByUsername   String
  performedAt           DateTime          @default(now())
  liftedAt              DateTime?
  liftedByAccountId     String?
  riskCase              PaymentRiskCase   @relation(fields: [riskCaseId], references: [id], onDelete: Cascade)

  @@index([riskCaseId])
}

enum ChargebackCaseStatus {
  OPEN
  UNDER_REVIEW
  CLEARED
  CONFIRMED_FRAUD
  CLOSED
}

// Replaces the previously-informal "MANUAL_REVIEW status + failureReason
// prefixed 'charged_back:'" convention (still the trigger -- see
// mercadopago.status-map.ts) with an explicit, structured case. Primary
// responsibility is always the purchase originator; dispersalTraceSnapshot
// exists for investigation, never for automatic clawback against
// downstream recipients (docs/decisions/0016-rmt-policy-gap.md Decision 2,
// reaffirmed by Phase P's own instruction).
model ChargebackCase {
  id                       String               @id @default(uuid())
  rechargeIntentId         String               @unique
  accountId                String?
  provider                 String               @db.VarChar(40)
  externalOrderId          String?              @db.VarChar(191)
  currency                 CurrencyCode
  originalAmountCredited   Int
  // The account's live WC balance at the moment this case was opened --
  // a real, honest fact. NOT an exact "how much of THIS specific credit
  // remains" figure: WC is fungible once merged into a balance, and this
  // codebase does not pretend to FIFO-trace individual coins. Use this
  // together with dispersalTraceSnapshot (the actual, ledger-verified
  // forward-transfer trail) for investigation.
  accountBalanceAtCaseOpen Int?
  dispersalTraceSnapshot   Json?
  providerChargebackReason String?              @db.Text
  sourceWebhookEventId     String?
  chargebackDate           DateTime?
  status                   ChargebackCaseStatus @default(OPEN)
  reviewNotes              String?              @db.Text
  resolution               String?              @db.Text
  resolvedAt               DateTime?
  resolvedByAccountId      String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  account                  Account?             @relation(fields: [accountId], references: [id], onDelete: SetNull)
  rechargeIntent           RechargeIntent       @relation(fields: [rechargeIntentId], references: [id])

  @@index([accountId])
  @@index([status])
}

// ============================================================
// Survey foundation (Phase K, Part 15, 2026-08-30). Architecture only --
// no UI is built against this yet, per Bryan's explicit "do not build an
// unnecessarily huge frontend now." Modeled for the future periodic
// player-questionnaire system discussed with Bryan, reusing the same
// no-hard-FK-on-accountId precedent as AccountDeletionFeedback for any
// response that may need to survive/outlive the account, and the same
// campaign/trigger/audience shape a future survey admin UI can build on.
// ============================================================

enum SurveyStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum SurveyQuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  RATING
  FREE_TEXT
}

// Set per Survey, not per response -- a survey is either anonymous or
// identified by design, never mixed (avoids a response silently
// reintroducing identity into a survey meant to be anonymous).
enum SurveyParticipationMode {
  ANONYMOUS
  IDENTIFIED
}

enum SurveyTriggerType {
  ACCOUNT_AGE
  FIRST_RESET
  POST_EVENT
  POST_SUPPORT
  POST_PURCHASE
  OPEN_BETA
  MANUAL_CAMPAIGN
  PERIODIC
}

model Survey {
  id                String                  @id @default(uuid())
  title             String                  @db.VarChar(200)
  description       String?                 @db.VarChar(2000)
  status            SurveyStatus            @default(DRAFT)
  participationMode SurveyParticipationMode @default(ANONYMOUS)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  questions SurveyQuestion[]
  campaigns SurveyCampaign[]
  responses SurveyResponse[]
}

model SurveyQuestion {
  id       String             @id @default(uuid())
  surveyId String
  order    Int
  text     String             @db.VarChar(500)
  type     SurveyQuestionType
  required Boolean            @default(false)

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  options SurveyOption[]
  answers SurveyAnswer[]

  @@index([surveyId])
}

model SurveyOption {
  id         String @id @default(uuid())
  questionId String
  label      String @db.VarChar(200)
  order      Int

  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  SurveyAnswer[]

  @@index([questionId])
}

// A named run of a Survey against a specific SurveyAudience, on a
// specific SurveyTriggerType. Kept separate from Survey itself so the
// same question set can be reused across multiple campaigns (e.g. the
// same satisfaction survey triggered both POST_EVENT and PERIODIC).
model SurveyCampaign {
  id          String            @id @default(uuid())
  surveyId    String
  name        String            @db.VarChar(200)
  triggerType SurveyTriggerType
  status      SurveyStatus      @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime          @default(now())

  survey    Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  audiences SurveyAudience[]
  responses SurveyResponse[]

  @@index([surveyId])
}

// Deliberately minimal/generic (ruleType+ruleValue) rather than a rigid
// per-criterion schema -- audience targeting rules are a product decision
// not yet made; this just reserves the shape so a future admin UI has
// somewhere real to write to instead of inventing its own table.
model SurveyAudience {
  id         String   @id @default(uuid())
  campaignId String
  ruleType   String   @db.VarChar(100)
  ruleValue  String   @db.VarChar(500)
  createdAt  DateTime @default(now())

  campaign SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// accountId is nullable and NOT a relation field on purpose, mirroring
// AccountDeletionFeedback's precedent -- an IDENTIFIED-mode response may
// still need to outlive the account (anonymized rather than cascaded);
// an ANONYMOUS-mode response never populates accountId at all.
model SurveyResponse {
  id          String    @id @default(uuid())
  surveyId    String
  campaignId  String?
  accountId   String?
  submittedAt DateTime  @default(now())
  anonymizedAt DateTime?

  survey   Survey          @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  campaign SurveyCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  answers  SurveyAnswer[]

  @@index([surveyId])
  @@index([campaignId])
  @@index([accountId])
}

model SurveyAnswer {
  id         String  @id @default(uuid())
  responseId String
  questionId String
  optionId   String?
  freeText   String? @db.VarChar(2000)

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   SurveyOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([responseId])
  @@index([questionId])
  @@index([optionId])
}

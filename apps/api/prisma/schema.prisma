model Account {
  id                   String                      @id @default(uuid())
  username             String                      @unique
  name                 String
  email                String                      @unique
  passwordHash         String
  personalIdHash       String?
  sessionVersion       Int                         @default(0)
  twoFactorEnabled     Boolean                     @default(false)
  twoFactorSecret      String?                     @db.Text
  twoFactorPending     String?                     @db.Text
  role                 Role                        @default(PLAYER)
  status               AccountStatus               @default(PENDING)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  currencies           AccountCurrency[]
  auditEvents          AuditEvent[]                @relation("AuditActor")
  purchases            PurchaseIntent[]
  recharges            RechargeIntent[]
  characters           AccountCharacter[]
  marketListings       PlayerMarketListing[]       @relation("MarketplaceSeller")
  marketOrders         PlayerMarketOrder[]         @relation("MarketplaceBuyer")
  marketplaceReports   MarketplaceReport[]         @relation("MarketplaceReporter")
  communityProfile     CommunityProfile?
  communityPosts       CommunityPost[]             @relation("CommunityPostAuthor")
  communityComments    CommunityComment[]          @relation("CommunityCommentAuthor")
  communityReactions   CommunityReaction[]
  communityReports     CommunityReport[]           @relation("CommunityReporter")
  reportedCommunity    CommunityReport[]           @relation("CommunityReportedUser")
  achievementGrants    CommunityAchievementGrant[]
  badgeGrants          CommunityBadgeGrant[]
  questProgress        CommunityQuestParticipant[]
  bridgeJobs           GameBridgeJob[]
  permissions          AccountPermission[]
  supportTickets       SupportTicket[]             @relation("TicketOwner")
  assignedTickets      SupportTicket[]             @relation("TicketAssignee")
  moderationActions    AccountModeration[]         @relation("ModerationTarget")
  moderationIssued     AccountModeration[]         @relation("ModerationActor")
  sessions             AccountSession[]
  adminTasksAssigned   AdminTask[]                 @relation("AdminTaskAssignee")
  adminTasksAssignedBy AdminTask[]                 @relation("AdminTaskAssigner")
  adminTasksCreated    AdminTask[]                 @relation("AdminTaskCreator")
  adminTaskComments    AdminTaskComment[]
  adminTaskEvidence    AdminTaskEvidence[]
}

model AdminTask {
  id               String              @id @default(uuid())
  title            String              @db.VarChar(191)
  description      String              @db.LongText
  module           String              @db.VarChar(100)
  type             String              @db.VarChar(100)
  priority         AdminTaskPriority   @default(NORMAL)
  complexity       AdminTaskComplexity @default(STANDARD)
  status           AdminTaskStatus     @default(OPEN)
  assignedTo       String?
  assignedBy       String?
  createdBy        String
  dueAt            DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  estimatedMinutes Int?
  actualMinutes    Int?
  entityType       String?             @db.VarChar(191)
  entityId         String?             @db.VarChar(191)
  errorId          String?             @db.VarChar(191)
  reportId         String?             @db.VarChar(191)
  internalNotes    String?             @db.LongText
  result           String?             @db.LongText
  approvalRequired Boolean             @default(false)
  reviewedBy       String?             @db.VarChar(191)
  reviewedAt       DateTime?
  reviewReason     String?             @db.Text
  reopenedCount    Int                 @default(0)
  rejectedCount    Int                 @default(0)
  sourceTaskType   String?             @db.VarChar(100)
  sourceTaskId     String?             @db.VarChar(191)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  assignee         Account?            @relation("AdminTaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  assigner         Account?            @relation("AdminTaskAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)
  creator          Account             @relation("AdminTaskCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  comments         AdminTaskComment[]
  evidence         AdminTaskEvidence[]
  links            AdminTaskLink[]
  history          AdminTaskHistory[]

  @@unique([sourceTaskType, sourceTaskId])
  @@index([assignedTo, status, dueAt])
  @@index([module, status, priority])
  @@index([entityType, entityId])
  @@index([errorId])
  @@index([reportId])
  @@index([createdAt])
}

model AdminTaskComment {
  id          String    @id @default(uuid())
  taskId      String
  authorId    String
  content     String    @db.LongText
  attachments Json?
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  task        AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      Account   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([authorId, createdAt])
}

model AdminTaskEvidence {
  id          String                @id @default(uuid())
  taskId      String
  authorId    String
  type        AdminTaskEvidenceType
  title       String                @db.VarChar(191)
  description String?               @db.Text
  url         String?               @db.VarChar(1024)
  entityType  String?               @db.VarChar(191)
  entityId    String?               @db.VarChar(191)
  beforeData  Json?
  afterData   Json?
  metadata    Json?
  createdAt   DateTime              @default(now())
  task        AdminTask             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      Account               @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([authorId, createdAt])
  @@index([entityType, entityId])
}

model AdminTaskLink {
  id         String    @id @default(uuid())
  taskId     String
  module     String    @db.VarChar(100)
  entityType String    @db.VarChar(191)
  entityId   String    @db.VarChar(191)
  label      String?   @db.VarChar(191)
  createdBy  String    @db.VarChar(191)
  createdAt  DateTime  @default(now())
  task       AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, entityType, entityId])
  @@index([module, entityType, entityId])
}

model AdminTaskHistory {
  id            String           @id @default(uuid())
  taskId        String
  actorId       String           @db.VarChar(191)
  action        String           @db.VarChar(100)
  fromStatus    AdminTaskStatus?
  toStatus      AdminTaskStatus?
  description   String           @db.Text
  beforeData    Json?
  afterData     Json?
  correlationId String?          @db.VarChar(80)
  createdAt     DateTime         @default(now())
  task          AdminTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([actorId, createdAt])
  @@index([correlationId])
}

model RoadmapItem {
  id                 String                @id @default(uuid())
  title              String                @db.VarChar(191)
  slug               String                @unique @db.VarChar(191)
  summary            String                @db.Text
  description        String                @db.LongText
  objective          String?               @db.Text
  problem            String?               @db.Text
  playerBenefit      String?               @db.Text
  scopeIncluded      Json?
  scopeExcluded      Json?
  category           String                @db.VarChar(100)
  horizon            RoadmapHorizon
  status             RoadmapStatus
  priority           RoadmapPriority       @default(MEDIUM)
  progress           Int                   @default(0)
  estimatedPeriod    String?               @db.VarChar(100)
  completedAt        DateTime?
  image              String?               @db.VarChar(512)
  icon               String?               @db.VarChar(100)
  tags               Json?
  dependencies       Json?
  visibility         RoadmapVisibility     @default(PUBLIC)
  sortOrder          Int                   @default(0)
  ownerId            String?               @db.VarChar(191)
  internalDeadline   DateTime?
  lastWorkAt         DateTime?
  workSituation      RoadmapWorkSituation  @default(ON_TRACK)
  workflowStatus     RoadmapWorkflowStatus @default(DRAFT)
  createdBy          String                @db.VarChar(191)
  updatedBy          String                @db.VarChar(191)
  reviewedBy         String?               @db.VarChar(191)
  approvedBy         String?               @db.VarChar(191)
  publishedBy        String?               @db.VarChar(191)
  internalNotes      String?               @db.Text
  publicNotes        String?               @db.Text
  revisionReason     String?               @db.Text
  version            Int                   @default(1)
  reviewedAt         DateTime?
  approvedAt         DateTime?
  publishedAt        DateTime?
  scheduledPublishAt DateTime?
  archivedAt         DateTime?
  deletedAt          DateTime?
  deletedBy          String?               @db.VarChar(191)
  deletionReason     String?               @db.Text
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  updates            RoadmapUpdate[]
  tasks              RoadmapTask[]
  relations          RoadmapRelation[]

  @@index([workflowStatus, visibility, publishedAt])
  @@index([horizon, status, sortOrder])
  @@index([category, priority])
  @@index([ownerId, internalDeadline])
  @@index([deletedAt])
}

model RoadmapUpdate {
  id              String            @id @default(uuid())
  roadmapItemId   String
  title           String            @db.VarChar(191)
  content         String            @db.LongText
  updateType      RoadmapUpdateType @default(GENERAL)
  oldStatus       RoadmapStatus?
  newStatus       RoadmapStatus?
  oldProgress     Int?
  newProgress     Int?
  createdBy       String            @db.VarChar(191)
  visibility      RoadmapVisibility @default(PUBLIC)
  evidence        Json?
  durationMinutes Int?
  createdAt       DateTime          @default(now())
  roadmapItem     RoadmapItem       @relation(fields: [roadmapItemId], references: [id], onDelete: Cascade)

  @@index([roadmapItemId, createdAt])
  @@index([visibility, createdAt])
}

model RoadmapTask {
  id            String            @id @default(uuid())
  roadmapItemId String
  title         String            @db.VarChar(191)
  description   String?           @db.Text
  status        RoadmapTaskStatus @default(PENDING)
  assigneeId    String?           @db.VarChar(191)
  dueAt         DateTime?
  completedAt   DateTime?
  createdBy     String            @db.VarChar(191)
  updatedBy     String            @db.VarChar(191)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  roadmapItem   RoadmapItem       @relation(fields: [roadmapItemId], references: [id], onDelete: Cascade)

  @@index([roadmapItemId, status])
  @@index([assigneeId, status])
  @@index([dueAt, status])
}

model RoadmapRelation {
  id            String              @id @default(uuid())
  roadmapItemId String
  type          RoadmapRelationType
  entityId      String              @db.VarChar(191)
  label         String?             @db.VarChar(191)
  createdBy     String              @db.VarChar(191)
  createdAt     DateTime            @default(now())
  roadmapItem   RoadmapItem         @relation(fields: [roadmapItemId], references: [id], onDelete: Cascade)

  @@unique([roadmapItemId, type, entityId])
  @@index([type, entityId])
}

model AccountSession {
  id           String    @id @default(uuid())
  accountId    String
  ipAddress    String?   @db.VarChar(80)
  userAgent    String?   @db.VarChar(255)
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?   @db.VarChar(191)
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([accountId, revokedAt])
  @@index([expiresAt])
}

model SupportTicket {
  id         String              @id @default(uuid())
  accountId  String
  assigneeId String?
  subject    String              @db.VarChar(191)
  category   String              @default("support") @db.VarChar(80)
  message    String              @db.Text
  response   String?             @db.Text
  status     SupportTicketStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  account    Account             @relation("TicketOwner", fields: [accountId], references: [id], onDelete: Cascade)
  assignee   Account?            @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([assigneeId])
  @@index([status])
}

model AccountModeration {
  id        String               @id @default(uuid())
  accountId String
  actorId   String?
  type      ModerationActionType
  reason    String               @db.Text
  expiresAt DateTime?
  createdAt DateTime             @default(now())
  account   Account              @relation("ModerationTarget", fields: [accountId], references: [id], onDelete: Cascade)
  actor     Account?             @relation("ModerationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([actorId])
  @@index([type])
}

model AccountPermission {
  id        String   @id @default(uuid())
  accountId String
  key       String   @db.VarChar(191)
  granted   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, key])
  @@index([accountId])
  @@index([key])
}

model AccountCurrency {
  id        String       @id @default(uuid())
  accountId String
  currency  CurrencyCode
  balance   Int          @default(0)
  account   Account      @relation(fields: [accountId], references: [id])

  @@unique([accountId, currency])
}

model AccountCharacter {
  id             String                 @id @default(uuid())
  accountId      String
  key            String                 @unique
  name           String                 @unique
  className      String
  level          Int                    @default(1)
  reset          Int                    @default(0)
  masterReset    Int                    @default(0)
  map            String                 @default("Lorencia")
  guild          String                 @default("-")
  pkStatus       String                 @default("Commoner")
  status         CharacterRuntimeStatus @default(OFFLINE)
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  account        Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  marketListings PlayerMarketListing[]

  @@index([accountId])
  @@index([className])
  @@index([status])
}

model AuditEvent {
  id            String      @id @default(uuid())
  module        String      @default("system") @db.VarChar(100)
  action        String      @db.VarChar(191)
  targetType    String      @db.VarChar(191)
  targetId      String?     @db.VarChar(191)
  actorId       String?
  actorUsername String?     @db.VarChar(191)
  actorRole     String?     @db.VarChar(40)
  targetUserId  String?     @db.VarChar(191)
  beforeData    Json?
  afterData     Json?
  reason        String?     @db.Text
  result        AuditResult @default(SUCCESS)
  severity      String      @default("info") @db.VarChar(40)
  ipAddress     String?     @db.VarChar(80)
  userAgent     String?     @db.VarChar(512)
  sessionId     String?     @db.VarChar(191)
  correlationId String?     @db.VarChar(80)
  metadata      Json?
  createdAt     DateTime    @default(now())
  actor         Account?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([module, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([correlationId])
  @@index([result, createdAt])
}

model AdminWorkLog {
  id              String        @id @default(uuid())
  userId          String
  username        String?       @db.VarChar(191)
  module          String        @db.VarChar(100)
  action          String        @db.VarChar(191)
  entityType      String        @db.VarChar(191)
  entityId        String?       @db.VarChar(191)
  taskId          String?       @db.VarChar(191)
  description     String        @db.Text
  startedAt       DateTime
  completedAt     DateTime?
  durationMinutes Int?
  evidence        Json?
  result          WorkLogResult @default(SUCCESS)
  correlationId   String?       @db.VarChar(80)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([module, createdAt])
  @@index([taskId])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@index([result, createdAt])
}

model SystemError {
  id              String                  @id @default(uuid())
  fingerprint     String                  @unique @db.VarChar(191)
  module          String                  @db.VarChar(100)
  severity        SystemErrorSeverity     @default(ERROR)
  errorCode       String?                 @db.VarChar(191)
  publicMessage   String                  @db.Text
  internalMessage String                  @db.Text
  stackTrace      String?                 @db.LongText
  correlationId   String?                 @db.VarChar(80)
  userId          String?                 @db.VarChar(191)
  accountId       String?                 @db.VarChar(191)
  entityType      String?                 @db.VarChar(191)
  entityId        String?                 @db.VarChar(191)
  requestPath     String?                 @db.VarChar(512)
  requestMethod   String?                 @db.VarChar(20)
  environment     String                  @default("production") @db.VarChar(40)
  occurrenceCount Int                     @default(1)
  firstOccurredAt DateTime                @default(now())
  lastOccurredAt  DateTime                @default(now())
  status          SystemErrorStatus       @default(NEW)
  assignedTo      String?                 @db.VarChar(191)
  resolution      String?                 @db.Text

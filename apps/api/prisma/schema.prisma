// Phase Z -- Bug Hunters MVP. Deliberately separate from SupportTicket
// (an account/personal issue) -- this is a reproducible product/game
// defect for Beta triage. No automatic conversion either way; staff
// redirect/close manually if a report turns out to be a support matter.
enum BugReportCategory {
  LAUNCHER
  LOGIN_ACCOUNT
  GAMEPLAY
  MAP_MONSTER
  ITEM
  EVENT
  QUEST
  VIP
  STORE_PAYMENT
  MARKETPLACE
  GUILD
  COMMUNITY
  PORTAL
  PERFORMANCE
  OTHER
}

enum BugReportSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugReportStatus {
  OPEN
  TRIAGE
  NEEDS_INFO
  CONFIRMED
  IN_PROGRESS
  RESOLVED
  CLOSED
  DUPLICATE
  NOT_A_BUG
}

enum BugReportEventType {
  CREATED
  STATUS_CHANGED
  STAFF_SEVERITY_SET
  ASSIGNED
  STAFF_REPLY
  INTERNAL_NOTE
  PLAYER_INFO_ADDED
  REWARD_ELIGIBILITY_RECORDED
}

model BugReport {
  id               String             @id @default(uuid())
  accountId        String
  category         BugReportCategory
  title            String             @db.VarChar(191)
  description      String             @db.Text
  stepsToReproduce String             @db.Text
  expectedBehavior String             @db.Text
  actualBehavior   String             @db.Text
  // Player's own severity assessment -- kept distinct from staffSeverity
  // below, never overwritten by it. Staff triage records their own
  // judgment independently; both remain visible for comparison.
  playerSeverity   BugReportSeverity
  staffSeverity    BugReportSeverity?
  status           BugReportStatus    @default(OPEN)
  characterName    String?            @db.VarChar(80)
  contextNote      String?            @db.Text
  // Reference only (e.g. an already-uploaded asset id/URL) -- this model
  // never receives or stores a raw file upload itself.
  attachmentRef    String?            @db.VarChar(500)
  consentAcknowledgedAt DateTime
  assignedToAccountId   String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  resolvedAt       DateTime?
  closedAt         DateTime?

  account  Account          @relation("BugReportOwner", fields: [accountId], references: [id], onDelete: Cascade)
  assignee Account?         @relation("BugReportAssignee", fields: [assignedToAccountId], references: [id], onDelete: SetNull)
  events   BugReportEvent[]

  @@index([accountId])
  @@index([status])
  @@index([category])
  @@index([assignedToAccountId])
}


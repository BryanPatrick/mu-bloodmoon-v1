model CommunityFollow {
  id          String   @id @default(uuid())
  followerId  String   @db.VarChar(191)
  followingId String   @db.VarChar(191)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model CommunityUsernameHistory {
  id          String   @id @default(uuid())
  accountId   String   @db.VarChar(191)
  oldUsername String   @db.VarChar(191)
  newUsername String   @db.VarChar(191)
  changedBy   String   @db.VarChar(191)
  reason      String   @db.Text
  createdAt   DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([newUsername])
}

model CommunityPost {
  id                 String                  @id @default(uuid())
  authorId           String
  title              String?                 @db.VarChar(191)
  content            String                  @db.LongText
  type               CommunityPostType       @default(TEXT)
  visibility         CommunityPostVisibility @default(PUBLIC)
  media              Json?
  tags               Json?
  mentions           Json?
  status             CommunityPostStatus     @default(PUBLISHED)
  edited             Boolean                 @default(false)
  editedAt           DateTime?
  sponsored          Boolean                 @default(false)
  official           Boolean                 @default(false)
  sourceType         String?                 @db.VarChar(80)
  sourceId           String?                 @db.VarChar(191)
  isPinned           Boolean                 @default(false)
  isFeatured         Boolean                 @default(false)
  reachLimited       Boolean                 @default(false)
  administrativeEdit Boolean                 @default(false)
  administrativeNote String?                 @db.Text
  editedBy           String?                 @db.VarChar(191)
  hiddenBy           String?                 @db.VarChar(191)
  hiddenAt           DateTime?
  removedBy          String?                 @db.VarChar(191)
  removedAt          DateTime?
  deletionReason     String?                 @db.Text
  publishedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  author             Account                 @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments           CommunityComment[]
  reactions          CommunityReaction[]
  reports            CommunityReport[]
  revisions          CommunityPostRevision[]
  mediaAssets        CommunityMedia[]
  saves              CommunityPostSave[]
  reposts            CommunityRepost[]

  @@index([status, publishedAt])
  @@index([authorId, createdAt])
  @@index([isPinned, isFeatured, createdAt])
  @@index([type, visibility, status, createdAt])
  @@index([sourceType, sourceId])
}

model CommunityMedia {
  id               String               @id @default(uuid())
  ownerId          String
  postId           String?
  kind             CommunityMediaKind
  status           CommunityMediaStatus @default(TEMPORARY)
  // Null until promoted out of quarantine -- a TEMPORARY/REJECTED row has no
  // publicly resolvable location yet.
  url              String?              @db.VarChar(512)
  storagePath      String               @db.VarChar(512)
  // Which StorageProvider actually holds this object -- rows written before
  // a provider migration keep whatever they were created with, so this is
  // per-row, not a single global setting.
  storageProvider  String               @default("local") @db.VarChar(20)
  originalName     String               @db.VarChar(255)
  // What Multer/the client claimed the file was, captured at quarantine time
  // -- kept separate from `mimeType` (the server-detected, validated,
  // post-re-encode type) specifically so a REJECTED row still records the
  // mismatch for abuse-pattern review.
  declaredMimeType String?              @db.VarChar(100)
  // Null until validation actually determines a real format/size -- a
  // REJECTED row (corrupt bytes, undecodable content) may never reach that
  // point.
  mimeType         String?              @db.VarChar(100)
  extension        String?              @db.VarChar(12)
  sizeBytes        Int
  width            Int?
  height           Int?
  sha256           String               @db.VarChar(64)
  rejectionReason  String?              @db.Text
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  removedAt        DateTime?
  post             CommunityPost?       @relation(fields: [postId], references: [id], onDelete: SetNull)


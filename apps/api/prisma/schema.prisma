  correlationId  String                 @unique @db.VarChar(80)
  paidAt         DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  listing        PlayerMarketListing    @relation(fields: [listingId], references: [id])
  buyer          Account                @relation("MarketplaceBuyer", fields: [buyerAccountId], references: [id], onDelete: Cascade)
  bridgeJobs     GameBridgeJob[]
  reports        MarketplaceReport[]
  tasks          MarketplaceTask[]

  @@index([listingId])
  @@index([buyerAccountId])
  @@index([currency])
  @@index([status])
  @@index([createdAt])
}


enum GameBridgeOperation {
  LOCK_ITEM
  RELEASE_ITEM
  TRANSFER_ITEM
  DELIVER_ITEM
  CREDIT_CURRENCY
  SYNC_INVENTORY
  // Open Beta P0 foundation. apps/api owns the VIP entitlement's expiry
  // as the source of truth (VipEntitlement) -- this job is the sync
  // trigger toward GameServer, queued on every grant/extension, exactly
  // like LOCK_ITEM/CREDIT_CURRENCY are queued today. No worker-side
  // handler is implemented this phase (foundation only, per the P0
  // scope) -- jobs of this type accumulate PENDING until a real handler
  // exists, the same state every other operation type would be in if
  // MU_BRIDGE_ENABLED were never turned on.
  GRANT_VIP
  // Phase 14 Part D. Two intentionally narrow, allowlisted operations --
  // never a generic "run this SQL against the GameServer" capability.
  // Payloads are fixed shapes ({accountId, legacyLogin[, betaCycleId]}),
  // enforced by account-deletion.service.ts, not by this enum alone.
  // GameBridge extension plan (docs/gamebridge/gamebridge-agent-extension-plan.md):
  // both now have a real sender, AccountLifecycleBridgeService
  // (apps/api/src/modules/accounts/account-lifecycle-bridge.service.ts),
  // gated behind ACCOUNT_LIFECYCLE_BRIDGE_ENABLED (default off) and the
  // Agent's own GAME_BRIDGE_ANONYMIZE_ENABLED/GAME_BRIDGE_PURGE_ENABLED
  // kill switches (also default off) -- the stored procedures themselves
  // remain reviewed but unexecuted pending a real SQL Server test
  // environment (docs/environment/sql-server-test-environment.md).
  ANONYMIZE_GAME_ACCOUNT
  PURGE_GAME_ACCOUNT
}


// ---- Guilds ----
// Greenfield domain (Etapa "Guilds MVP"). See docs/handoff/guilds-mvp.md for
// the full tier breakdown. Three-way XP/contribution split is intentional
// and must never be collapsed: GuildMember.memberXp (personal progression),
// GuildMember.contributionScore (reputational contribution), Guild.guildXp
// (organization progression). A deposit into GuildTreasuryBalance never
// grants guildXp -- only a future, irreversible GuildXpConversionRule
// execution would (none runs yet; active defaults to false). Depositing may
// later grant memberXp/contributionScore once an audited, antifarm
// contribution policy exists -- not implemented this round either.

enum GuildSource {
  PORTAL
  GAME
  IMPORTED
}

enum GuildSyncStatus {
  NOT_LINKED
  PENDING
  LINKED
  ERROR
}

enum GuildStatus {
  ACTIVE
  DISBANDED
  SUSPENDED
}

enum GuildRecruitmentStatus {
  OPEN
  APPROVAL_REQUIRED
  INVITE_ONLY
  CLOSED
}

enum GuildFocusTag {
  PVP
  PVE
  CASTLE_SIEGE
  BOSS
  FARM
  EVENTS
  CASUAL
  COMPETITIVE
}

enum GuildJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

// No expiresAt/TTL: GuildJoinRequest's own EXPIRED status has never been
// wired to a TTL either (nothing in guilds.service.ts sets it), so this
// domain has no existing expiration precedent to follow. Not inventing one
// here -- an invite stays PENDING until accepted, declined, or cancelled.
enum GuildInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum GuildRequestType {
  ITEM
  JEWEL
  ZEN
  WCOIN
  GOBLIN_POINT
  HUNT_POINT
  INVESTMENT
  EQUIPMENT
  LOOKING_FOR_ITEM
  OTHER
}

enum GuildRequestStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  FULFILLED
  CANCELLED
  EXPIRED
}

enum GuildProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum GuildMovementType {
  DONATION
  ALLOCATION
  LOAN
  REWARD
  EVENT
  SALE
  PROJECT
  OTHER
}

enum GuildApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum GuildMediaKind {
  EMBLEM
  BANNER
}

enum GuildMediaStatus {
  READY
  REMOVED
}

model Guild {
  id                 String                 @id @default(uuid())
  slug               String                 @unique @db.VarChar(60)
  name               String                 @db.VarChar(100)
  tag                String                 @db.VarChar(10)
  description        String?                @db.Text
  emblemUrl          String?                @db.VarChar(512)
  bannerUrl          String?                @db.VarChar(512)
  recruitment        GuildRecruitmentStatus @default(APPROVAL_REQUIRED)
  guildLevel         Int                    @default(1)
  guildXp            Int                    @default(0)
  // Denormalized convenience pointer to the current LEADER's GuildMember.id,
  // kept in sync by the service layer -- deliberately not a Prisma relation
  // (Guild <-> GuildMember already has one FK direction via
  // GuildMember.guildId; a second one back here would be a relation cycle
  // for a value that's fully derivable from GuildMember.roleKey anyway).
  leaderMemberId     String?
  // Nullable: a GAME/IMPORTED-sourced guild may have no portal founder until
  // claimed (future "Reivindicar perfil da Guild" flow, flow C).
  foundedByAccountId String?
  status             GuildStatus            @default(ACTIVE)
  // Game guild sync is NOT implemented yet -- these fields are schema-only
  // future-proofing so a real sync bridge can be added later without a
  // migration. Every guild created this round is source: PORTAL,
  // syncStatus: NOT_LINKED. See the module header comment above.
  source             GuildSource            @default(PORTAL)
  gameGuildId        String?                @db.VarChar(100)
  gameGuildName      String?                @db.VarChar(100)
  gameGuildTag       String?                @db.VarChar(10)
  syncStatus         GuildSyncStatus        @default(NOT_LINKED)
  lastSyncedAt       DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  foundedByAccount   Account?               @relation("GuildFounder", fields: [foundedByAccountId], references: [id], onDelete: SetNull)
  members            GuildMember[]
  joinRequests       GuildJoinRequest[]
  invites            GuildInvite[]
  focusTags          GuildFocusAssignment[]
  requests           GuildRequest[]
  projects           GuildProject[]
  media              GuildMedia[]
  treasury           GuildTreasury?
  vault              GuildVault?

  @@index([status])
  @@index([recruitment])
  @@index([source, syncStatus])
}

model GuildMember {
  id                String           @id @default(uuid())
  guildId           String
  // Membership is per-character, not per-account -- an Account can hold
  // several AccountCharacters, and each character may belong to at most one
  // guild at a time (characterId is globally unique here, not just unique
  // per guild). Never assume the whole Account belongs to one guild.
  characterId       String           @unique
  accountId         String
  // Free-text, not a Prisma enum -- a per-guild custom role/permission
  // system is a documented future admin feature ("Guild Roles"); an enum
  // would need a migration per vocabulary change. MVP vocabulary is
  // enforced in the service layer only: LEADER | OFFICER | TREASURER |
  // MEMBER | RECRUIT.
  roleKey           String           @default("MEMBER") @db.VarChar(20)
  // Personal progression of this member within the guild -- separate axis
  // from contributionScore and from Guild.guildXp. See module header.
  memberXp          Int              @default(0)
  // Historical/reputational contribution -- separate axis from memberXp.
  contributionScore Int              @default(0)
  joinedAt          DateTime         @default(now())
  invitedBy         String?
  removedAt         DateTime?
  removedBy         String?
  removedReason     String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  guild             Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  character         AccountCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  account           Account          @relation("GuildMemberAccount", fields: [accountId], references: [id], onDelete: Cascade)

  @@index([guildId, roleKey])
  @@index([accountId])
  @@index([removedAt])
}

model GuildJoinRequest {
  id           String                 @id @default(uuid())
  guildId      String
  characterId  String
  accountId    String
  message      String?                @db.Text
  status       GuildJoinRequestStatus @default(PENDING)
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?                @db.Text
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  guild        Guild                  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  // Not @@unique -- a character can rejoin after leaving/being kicked
  // (guilds.service.ts join()/leave()), which would create a second row
  // whose (guildId, characterId, status='APPROVED'/'REJECTED') repeats an
  // earlier decided request. MySQL has no partial/filtered unique index, so
  // "at most one live PENDING request per character per guild" is enforced
  // in the service layer (check-then-write in join()) instead of the DB.
  @@index([guildId, characterId, status])
  @@index([accountId])
  @@index([status])
}

model GuildFocusAssignment {
  id        String        @id @default(uuid())
  guildId   String
  tag       GuildFocusTag
  createdAt DateTime      @default(now())
  guild     Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, tag])
}

// Guild-initiated counterpart to GuildJoinRequest (player-initiated). Fixes
// the INVITE_ONLY dead end: join() rejects self-service entry for
// INVITE_ONLY guilds, and until this model existed there was no other way
// in. Same shape/conventions as GuildJoinRequest deliberately, including the
// "no DB unique index for PENDING" choice -- MySQL has no partial/filtered
// unique index, so "at most one live PENDING invite per character per
// guild" is enforced in the service layer (check-then-write in
// inviteToGuild()), not the DB.
model GuildInvite {
  id           String            @id @default(uuid())
  guildId      String
  characterId  String
  accountId    String
  invitedBy    String
  message      String?           @db.Text
  status       GuildInviteStatus @default(PENDING)
  decidedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  guild        Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, characterId, status])
  @@index([accountId, status])
  @@index([status])
}

// Admin-managed catalog, not per-guild -- one row per level.
model GuildLevelConfig {
  id         String   @id @default(uuid())
  level      Int      @unique
  // Placeholder round numbers this round, explicitly not balanced.
  xpRequired Int
  title      String   @db.VarChar(100)
  perks      Json?
  active     Boolean  @default(true)
  createdBy  String
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active])
}

// Admin-managed catalog. Nothing ever executes a conversion this round --
// active defaults to false so nothing looks live in a demo. When a future
// round wires execution, it must destroy amountRequired of resourceKey from
// GuildTreasuryBalance (irreversible, audited) in exchange for a fixed
// guildXpGranted -- never derive Guild XP from a live/gross balance.
model GuildXpConversionRule {
  id             String   @id @default(uuid())
  resourceType   String   @db.VarChar(40)
  resourceKey    String   @db.VarChar(60)
  amountRequired BigInt
  guildXpGranted Int
  active         Boolean  @default(false)
  seasonId       String?  @db.VarChar(60)
  perGuildLimit  Int?
  perMemberLimit Int?
  createdBy      String
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active])
  @@index([resourceKey])
}

model GuildRequest {
  id                   String             @id @default(uuid())
  guildId              String
  createdByAccountId   String
  createdByCharacterId String?
  type                 GuildRequestType
  title                String             @db.VarChar(191)
  description          String?            @db.Text
  quantity             Int?
  status               GuildRequestStatus @default(DRAFT)
  // Server-populated for LOOKING_FOR_ITEM: Blood Moon does not guarantee
  // loan repayment between players.
  disclaimer           String?            @db.Text
  cancelledAt          DateTime?
  cancelledBy          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  guild                Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
  @@index([createdByAccountId])
  @@index([type])
}

model GuildProject {
  id                 String             @id @default(uuid())
  guildId            String
  title              String             @db.VarChar(191)
  description        String?            @db.Text
  goal               String?            @db.Text
  ownerAccountId     String
  contributors       Json?
  requiredResources  Json?
  availableResources Json?
  relatedPlayers     Json?
  status             GuildProjectStatus @default(PLANNING)
  deadline           DateTime?
  impact             String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  guild              Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
  @@index([ownerAccountId])
}

model GuildMedia {
  id                  String           @id @default(uuid())
  guildId             String
  uploadedByAccountId String
  kind                GuildMediaKind
  status              GuildMediaStatus @default(READY)
  url                 String           @db.VarChar(512)
  storagePath         String           @db.VarChar(512)
  originalName        String           @db.VarChar(255)
  mimeType            String           @db.VarChar(100)
  extension           String           @db.VarChar(10)
  sizeBytes           Int
  width               Int
  height              Int
  sha256              String           @db.VarChar(64)
  removedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  guild               Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, kind])
}

// ---- Guilds: Tier B (real model, zero reachable write endpoint this round) ----

model GuildTreasury {
  id        String                 @id @default(uuid())
  guildId   String                 @unique
  createdAt DateTime               @default(now())
  guild     Guild                  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  balances  GuildTreasuryBalance[]
}

// Normalized, not a Json blob -- the resource catalog is genuinely
// open-ended (currencies, jewels, materials, seasonal resources, future
// Alliance transfers). resourceType/resourceKey are free text on purpose:
// the seed rows created at guild-creation (ZEN, WCOIN, GOBLIN_POINT,
// HUNT_POINT, JEWEL_BLESS, JEWEL_SOUL, JEWEL_CHAOS) are a minimal demo seed,
// not a definitive catalog -- more keys (Life/Creation/Harmony/Guardian/
// Gemstone jewels, materials, seasonal currencies, ...) must be addable with
// zero schema change. No endpoint ever updates availableAmount/
// reservedAmount this round; a deposit never grants guildXp (see module
// header) and reservedAmount stays 0 until a future project/request hold.
model GuildTreasuryBalance {
  id              String        @id @default(uuid())
  guildTreasuryId String
  resourceType    String        @db.VarChar(40)
  resourceKey     String        @db.VarChar(60)
  availableAmount BigInt        @default(0)
  reservedAmount  BigInt        @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  treasury        GuildTreasury @relation(fields: [guildTreasuryId], references: [id], onDelete: Cascade)

  @@unique([guildTreasuryId, resourceKey])
}

model GuildVault {
  id        String           @id @default(uuid())
  guildId   String           @unique
  createdAt DateTime         @default(now())
  guild     Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  items     GuildVaultItem[]
}

model GuildVaultItem {
  id           String     @id @default(uuid())
  guildVaultId String
  itemRef      String     @db.VarChar(191)
  quantity     Int        @default(1)
  metadata     Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  vault        GuildVault @relation(fields: [guildVaultId], references: [id], onDelete: Cascade)

  @@index([guildVaultId])
}

// The only conceptual path anything will ever move resources/items through
// in a future round -- no direct balance mutation is ever modeled, closing
// off the deposit->withdraw->deposit (or guild A->B->A) double-credit shape.
// Deliberately NOT wired into Guild's relation graph (no `guild Guild
// @relation` field, plain guildId scalar only) -- only reachable by raw
// guildId, so it stays structurally obvious nothing in the service touches
// these rows yet. No endpoint creates or reads these this round.
model GuildMovement {
  id                   String                  @id @default(uuid())
  guildId              String
  type                 GuildMovementType
  status               GuildApprovalStatus     @default(PENDING)
  resourceKey          String                  @db.VarChar(60)
  amount               BigInt
  requestedByAccountId String
  reason               String?                 @db.Text
  beforeBalance        Json?
  afterBalance         Json?
  correlationId        String?                 @db.VarChar(80)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  approvals            GuildMovementApproval[]

  @@index([guildId, status])
  @@index([resourceKey])
}

model GuildMovementApproval {
  id                String              @id @default(uuid())
  guildMovementId   String
  approverAccountId String
  status            GuildApprovalStatus @default(PENDING)
  note              String?             @db.Text
  decidedAt         DateTime?
  createdAt         DateTime            @default(now())
  movement          GuildMovement       @relation(fields: [guildMovementId], references: [id], onDelete: Cascade)

  @@index([guildMovementId])
}

// GM operational occurrences foundation (Etapa 3). Deliberately generic --
// a row can represent a report, an event incident, suspicious behaviour, a
// dispute, or anything else a GM needs to track and hand off. No automatic
// punishment is ever derived from this model; it is a tracking/handoff tool
// only. type/targetType are free text (not enums) for the same open-ended
// reason as OperationalEvent.module.
enum GmOccurrenceStatus {
  OPEN
  IN_REVIEW
  ACTION_REQUIRED
  RESOLVED
  DISMISSED
}

model GmOccurrence {
  id           String               @id @default(uuid())
  type         String               @db.VarChar(100)
  priority     GmOccurrencePriority @default(MEDIUM)
  description  String               @db.Text
  targetType   String?              @db.VarChar(100)
  targetId     String?              @db.VarChar(191)
  status       GmOccurrenceStatus   @default(OPEN)
  createdById  String
  assignedToId String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  resolvedAt   DateTime?
  createdBy    Account              @relation("GmOccurrenceCreatedBy", fields: [createdById], references: [id])
  assignedTo   Account?             @relation("GmOccurrenceAssignedTo", fields: [assignedToId], references: [id])
  notes        GmOccurrenceNote[]

  @@index([status, createdAt])
  @@index([priority, status])
  @@index([targetType, targetId])
  @@index([assignedToId])
}

// Fixed, small set that drives SLA computation and sort order in the GM UI
// -- unlike GmOccurrence.type (free text, open-ended categories), the set of
// priority tiers is deliberately closed, so an enum instead of free text.
enum GmOccurrencePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model GmOccurrenceNote {
  id           String       @id @default(uuid())
  occurrenceId String
  authorId     String
  note         String       @db.Text
  createdAt    DateTime     @default(now())
  occurrence   GmOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  author       Account      @relation(fields: [authorId], references: [id])

  @@index([occurrenceId, createdAt])
}

// GM events MVP (Etapa 4). Four deliberately separate concepts, per the
// audit confirming no existing model covers this (CommunityQuest is social
// gamification; RoadmapItem is the changelog; OperationalEvent is a log;
// GmOccurrence is a ticket -- none of them are schedulable game events):
//   GmEventDefinition -- the configured/reusable event (what it is)
//   GmEventSchedule    -- when it is meant to happen
//   GmEventRun         -- one specific execution/occurrence
//   GmEventResult      -- the outcome of that execution, GM-validated
// executionMode distinguishes who is expected to drive a run: the system
// (AUTOMATED), a GM by hand (MANUAL_GM), or both (HYBRID, system prepares,
// GM confirms/accompanies) -- see gm-events.service.ts header for how this
// is enforced today (MANUAL_GM/HYBRID only; AUTOMATED has no driver yet).
// origin stays a free-text string, not an enum, deliberately: the audit
// confirmed there is no live connection to the MU game server today
// (MU_BRIDGE_ENABLED=false, game-integration.contract.ts is a types-only
// stub) so every run this round is "PORTAL_ONLY" -- the portal recorded
// the operation without confirming the game server did anything. A future
// real integration adds a new origin value, not a schema migration,
// matching the same free-text precedent as OperationalEvent.module and
// GmOccurrence.type.
enum GmEventExecutionMode {
  AUTOMATED
  MANUAL_GM
  HYBRID
}

enum GmEventDefinitionStatus {
  ACTIVE
  INACTIVE
}

model GmEventDefinition {
  id            String                  @id @default(uuid())
  key           String                  @unique @db.VarChar(100)
  name          String                  @db.VarChar(191)
  description   String?                 @db.Text
  category      String                  @db.VarChar(100)
  executionMode GmEventExecutionMode    @default(MANUAL_GM)
  status        GmEventDefinitionStatus @default(ACTIVE)
  createdById   String
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  createdBy     Account                 @relation("GmEventDefinitionCreatedBy", fields: [createdById], references: [id])
  schedules     GmEventSchedule[]
  runs          GmEventRun[]

  @@index([status])
}

model GmEventSchedule {
  id             String            @id @default(uuid())
  definitionId   String
  startsAt       DateTime
  endsAt         DateTime?
  recurrenceNote String?           @db.VarChar(191)
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  definition     GmEventDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  runs           GmEventRun[]

  @@index([definitionId, startsAt])
}

enum GmEventRunStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
  PROBLEM_REPORTED
}

model GmEventRun {
  id            String            @id @default(uuid())
  definitionId  String
  scheduleId    String?
  status        GmEventRunStatus  @default(SCHEDULED)
  // "PORTAL_ONLY" today (no live game-server connection exists -- see the
  // header comment above), plus three reserved-but-unused values a future
  // real GameBridge connection will actually produce: "GAMEBRIDGE_PENDING"
  // (call in flight), "GAMEBRIDGE_CONNECTED" (call succeeded),
  // "GAMEBRIDGE_ERROR" (call attempted and honestly failed -- never a fake
  // success). Free text, not an enum, for the same reason as
  // GmOccurrence.type: the value set is expected to grow without a schema
  // migration. See gm/event-executors/ for the abstraction that produces it.
  origin        String            @default("PORTAL_ONLY") @db.VarChar(40)
  // Doubles as the future GameBridge call's idempotency key (mirrors
  // GameBridgeJob.idempotencyKey's role for marketplace escrow) and as the
  // cross-system trace id (mirrors the correlationId convention already used
  // by SystemError/OperationalEvent/SystemAlert/PlayerMarketOrder). Set once
  // at run creation, before any executor is invoked.
  correlationId String            @unique @default(uuid())
  // How many times an executor was actually invoked for this run -- prepared
  // for a future retry policy; today every run attempts exactly once.
  bridgeAttempts Int              @default(0)
  // Raw payload/message from whichever executor ran (Portal or, later,
  // GameBridge). Both stay null for the Portal path today since there is
  // nothing external to report.
  externalResult Json?
  externalError  String?          @db.Text
  startedById   String?
  startedAt     DateTime?
  endedById     String?
  endedAt       DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  cancelReason  String?           @db.Text
  problemNote   String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  definition    GmEventDefinition @relation(fields: [definitionId], references: [id])
  schedule      GmEventSchedule?  @relation(fields: [scheduleId], references: [id])
  startedBy     Account?          @relation("GmEventRunStartedBy", fields: [startedById], references: [id])
  endedBy       Account?          @relation("GmEventRunEndedBy", fields: [endedById], references: [id])
  cancelledBy   Account?          @relation("GmEventRunCancelledBy", fields: [cancelledById], references: [id])
  result        GmEventResult?

  @@index([definitionId, status])
  @@index([status, createdAt])
}

enum GmEventResultStatus {
  PENDING_VALIDATION
  VALIDATED
  INVALIDATED
}

model GmEventResult {
  id               String              @id @default(uuid())
  runId            String              @unique
  summary          String              @db.Text
  participantCount Int?
  status           GmEventResultStatus @default(PENDING_VALIDATION)
  validatedById    String?
  validatedAt      DateTime?
  invalidateReason String?             @db.Text
  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  run              GmEventRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdBy        Account             @relation("GmEventResultCreatedBy", fields: [createdById], references: [id])
  validatedBy      Account?            @relation("GmEventResultValidatedBy", fields: [validatedById], references: [id])
}

model CommunityReport {
  id             String                  @id @default(uuid())
  reporterId     String
  reportedUserId String?
  postId         String?
  commentId      String?
  // Deterministic, always-non-null encoding of the target ("post:<id>" or
  // "comment:<id>"). Exists solely so the unique index below never touches
  // postId/commentId directly -- MySQL's unique-index semantics never
  // reject a duplicate when any indexed column is NULL, and exactly one of
  // postId/commentId is always NULL here.
  targetKey      String                  @db.VarChar(200)
  // 1 while status is one of the "open" statuses (see OPEN_REPORT_STATUSES
  // in community.service.ts), NULL once RESOLVED/REJECTED. Combined with
  // the unique index, this is what actually makes "at most one open report
  // per reporter+target" atomic at the database level -- a NULL row never
  // collides with anything, which is what leaves closed-report history
  // (and legitimate re-reports after resolution) unlimited.
  openDedupeKey  Int?
  reason         String                  @db.VarChar(191)
  description    String?                 @db.Text
  evidence       Json?
  priority       CommunityReportPriority @default(NORMAL)
  status         CommunityReportStatus   @default(NEW)
  assigneeId     String?                 @db.VarChar(191)
  decision       String?                 @db.Text
  internalNotes  String?                 @db.Text
  dueAt          DateTime?
  resolvedBy     String?                 @db.VarChar(191)
  resolvedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  reporter       Account                 @relation("CommunityReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   Account?                @relation("CommunityReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  post           CommunityPost?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment        CommunityComment?       @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetKey, openDedupeKey])
  @@index([status, priority, createdAt])
  @@index([assigneeId, status])
  @@index([reportedUserId, createdAt])
}


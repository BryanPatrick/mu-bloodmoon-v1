enum AccountStatus {
  ACTIVE
  PENDING
  BLOCKED
}

// Open Beta P0 foundation. Explicitly assigned by the backend at
// registration time (auth.service.ts), keyed off a server-side Open Beta
// window config -- never inferred from createdAt after the fact, and
// never left to a client clock. PRE_BETA is the column default so any
// account-creation path that doesn't explicitly set this (a seed script,
// an admin tool) fails safe toward "not yet trusted as an official
// account" rather than silently defaulting to OFFICIAL.
enum AccountPhase {
  PRE_BETA
  OPEN_BETA
  OFFICIAL
}

// Phase 3B. State machine for GameAccountIdentity.provisioningStatus --
// see docs/game-data/game-account-provisioning-contract.md. Deliberately
// separate from AccountStatus: a Blood Moon Account can be fully ACTIVE
// (site/community usable) while its game identity is still PENDING.
enum GameProvisioningStatus {
  PENDING // requested, not yet dispatched to GameBridge
  PROVISIONING // dispatched, awaiting a real result
  ACTIVE // membGuid confirmed -- this is GAME_READY, no separate flag
  FAILED // a real failure (not a timeout) -- retry re-enters PROVISIONING
}


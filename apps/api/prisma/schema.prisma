model Account {
  id                   String                      @id @default(uuid())
  username             String                      @unique
  name                 String
  email                String                      @unique
  passwordHash         String
  personalIdHash       String?
  sessionVersion       Int                         @default(0)
  twoFactorEnabled     Boolean                     @default(false)
  twoFactorSecret      String?                     @db.Text
  twoFactorPending     String?                     @db.Text
  role                 Role                        @default(PLAYER)
  status               AccountStatus               @default(PENDING)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  currencies           AccountCurrency[]
  auditEvents          AuditEvent[]                @relation("AuditActor")
  purchases            PurchaseIntent[]
  recharges            RechargeIntent[]
  characters           AccountCharacter[]
  guildsFounded        Guild[]                     @relation("GuildFounder")
  guildMemberships     GuildMember[]               @relation("GuildMemberAccount")
  marketListings       PlayerMarketListing[]       @relation("MarketplaceSeller")
  marketOrders         PlayerMarketOrder[]         @relation("MarketplaceBuyer")
  marketplaceReports   MarketplaceReport[]         @relation("MarketplaceReporter")
  communityProfile     CommunityProfile?
  communityPosts       CommunityPost[]             @relation("CommunityPostAuthor")
  communityComments    CommunityComment[]          @relation("CommunityCommentAuthor")
  communityReactions   CommunityReaction[]
  communityReports     CommunityReport[]           @relation("CommunityReporter")
  reportedCommunity    CommunityReport[]           @relation("CommunityReportedUser")
  achievementGrants    CommunityAchievementGrant[]
  badgeGrants          CommunityBadgeGrant[]
  questProgress        CommunityQuestParticipant[]
  bridgeJobs           GameBridgeJob[]
  permissions          AccountPermission[]
  supportTickets       SupportTicket[]             @relation("TicketOwner")
  assignedTickets      SupportTicket[]             @relation("TicketAssignee")
  moderationActions    AccountModeration[]         @relation("ModerationTarget")
  moderationIssued     AccountModeration[]         @relation("ModerationActor")
  sessions             AccountSession[]
  passwordResetTokens  PasswordResetToken[]
  adminTasksAssigned   AdminTask[]                 @relation("AdminTaskAssignee")
  adminTasksAssignedBy AdminTask[]                 @relation("AdminTaskAssigner")
  adminTasksCreated    AdminTask[]                 @relation("AdminTaskCreator")
  adminTaskComments    AdminTaskComment[]
  adminTaskEvidence    AdminTaskEvidence[]
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  gmOccurrencesCreated  GmOccurrence[]          @relation("GmOccurrenceCreatedBy")
  gmOccurrencesAssigned GmOccurrence[]          @relation("GmOccurrenceAssignedTo")
  gmOccurrenceNotes     GmOccurrenceNote[]
  gmEventDefinitionsCreated GmEventDefinition[] @relation("GmEventDefinitionCreatedBy")
  gmEventRunsStarted        GmEventRun[]        @relation("GmEventRunStartedBy")
  gmEventRunsEnded          GmEventRun[]        @relation("GmEventRunEndedBy")
  gmEventRunsCancelled      GmEventRun[]        @relation("GmEventRunCancelledBy")
  gmEventResultsCreated     GmEventResult[]     @relation("GmEventResultCreatedBy")
  gmEventResultsValidated   GmEventResult[]     @relation("GmEventResultValidatedBy")
}

model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  accountId String
  codeHash  String    @db.VarChar(191)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, usedAt])
}

model AdminTask {
  id               String              @id @default(uuid())
  title            String              @db.VarChar(191)
  description      String              @db.LongText
  module           String              @db.VarChar(100)
  type             String              @db.VarChar(100)
  priority         AdminTaskPriority   @default(NORMAL)
  complexity       AdminTaskComplexity @default(STANDARD)
  status           AdminTaskStatus     @default(OPEN)
  assignedTo       String?
  assignedBy       String?
  createdBy        String
  dueAt            DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  estimatedMinutes Int?
  actualMinutes    Int?
  entityType       String?             @db.VarChar(191)
  entityId         String?             @db.VarChar(191)
  errorId          String?             @db.VarChar(191)
  reportId         String?             @db.VarChar(191)
  internalNotes    String?             @db.LongText
  result           String?             @db.LongText
  approvalRequired Boolean             @default(false)
  reviewedBy       String?             @db.VarChar(191)
  reviewedAt       DateTime?
  reviewReason     String?             @db.Text
  reopenedCount    Int                 @default(0)
  rejectedCount    Int                 @default(0)
  sourceTaskType   String?             @db.VarChar(100)
  sourceTaskId     String?             @db.VarChar(191)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  assignee         Account?            @relation("AdminTaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  assigner         Account?            @relation("AdminTaskAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)
  creator          Account             @relation("AdminTaskCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  comments         AdminTaskComment[]
  evidence         AdminTaskEvidence[]
  links            AdminTaskLink[]
  history          AdminTaskHistory[]

  @@unique([sourceTaskType, sourceTaskId])
  @@index([assignedTo, status, dueAt])
  @@index([module, status, priority])
  @@index([entityType, entityId])
  @@index([errorId])
  @@index([reportId])
  @@index([createdAt])
}

model AdminTaskComment {
  id          String    @id @default(uuid())
  taskId      String
  authorId    String
  content     String    @db.LongText
  attachments Json?
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  task        AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      Account   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([authorId, createdAt])
}

model AdminTaskEvidence {
  id          String                @id @default(uuid())
  taskId      String
  authorId    String
  type        AdminTaskEvidenceType
  title       String                @db.VarChar(191)
  description String?               @db.Text
  url         String?               @db.VarChar(1024)
  entityType  String?               @db.VarChar(191)
  entityId    String?               @db.VarChar(191)
  beforeData  Json?
  afterData   Json?
  metadata    Json?
  createdAt   DateTime              @default(now())
  task        AdminTask             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      Account               @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([authorId, createdAt])
  @@index([entityType, entityId])
}

model AdminTaskLink {
  id         String    @id @default(uuid())
  taskId     String
  module     String    @db.VarChar(100)
  entityType String    @db.VarChar(191)
  entityId   String    @db.VarChar(191)
  label      String?   @db.VarChar(191)
  createdBy  String    @db.VarChar(191)
  createdAt  DateTime  @default(now())
  task       AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, entityType, entityId])
  @@index([module, entityType, entityId])
}

model AdminTaskHistory {
  id            String           @id @default(uuid())
  taskId        String
  actorId       String           @db.VarChar(191)
  action        String           @db.VarChar(100)
  fromStatus    AdminTaskStatus?
  toStatus      AdminTaskStatus?
  description   String           @db.Text
  beforeData    Json?
  afterData     Json?
  correlationId String?          @db.VarChar(80)
  createdAt     DateTime         @default(now())
  task          AdminTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([actorId, createdAt])
  @@index([correlationId])
}

model RoadmapItem {
  id                 String                @id @default(uuid())
  title              String                @db.VarChar(191)
  slug               String                @unique @db.VarChar(191)
  summary            String                @db.Text
  description        String                @db.LongText
  objective          String?               @db.Text
  problem            String?               @db.Text
  playerBenefit      String?               @db.Text
  scopeIncluded      Json?
  scopeExcluded      Json?
  category           String                @db.VarChar(100)
  horizon            RoadmapHorizon
  status             RoadmapStatus
  priority           RoadmapPriority       @default(MEDIUM)
  progress           Int                   @default(0)
  estimatedPeriod    String?               @db.VarChar(100)
  completedAt        DateTime?
  image              String?               @db.VarChar(512)
  icon               String?               @db.VarChar(100)
  tags               Json?
  dependencies       Json?
  visibility         RoadmapVisibility     @default(PUBLIC)
  sortOrder          Int                   @default(0)
  ownerId            String?               @db.VarChar(191)
  internalDeadline   DateTime?
  lastWorkAt         DateTime?
  workSituation      RoadmapWorkSituation  @default(ON_TRACK)
  workflowStatus     RoadmapWorkflowStatus @default(DRAFT)
  createdBy          String                @db.VarChar(191)
  updatedBy          String                @db.VarChar(191)
  reviewedBy         String?               @db.VarChar(191)
  approvedBy         String?               @db.VarChar(191)
  publishedBy        String?               @db.VarChar(191)
  internalNotes      String?               @db.Text
  publicNotes        String?               @db.Text
  revisionReason     String?               @db.Text
  version            Int                   @default(1)
  reviewedAt         DateTime?
  approvedAt         DateTime?
  publishedAt        DateTime?
  scheduledPublishAt DateTime?
  archivedAt         DateTime?
  deletedAt          DateTime?
  deletedBy          String?               @db.VarChar(191)
  deletionReason     String?               @db.Text
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  updates            RoadmapUpdate[]
  tasks              RoadmapTask[]
  relations          RoadmapRelation[]

  @@index([workflowStatus, visibility, publishedAt])
  @@index([horizon, status, sortOrder])
  @@index([category, priority])
  @@index([ownerId, internalDeadline])
  @@index([deletedAt])
}

model RoadmapUpdate {
  id              String            @id @default(uuid())
  roadmapItemId   String
  title           String            @db.VarChar(191)
  content         String            @db.LongText
  updateType      RoadmapUpdateType @default(GENERAL)
  oldStatus       RoadmapStatus?
  newStatus       RoadmapStatus?
  oldProgress     Int?
  newProgress     Int?
  createdBy       String            @db.VarChar(191)
  visibility      RoadmapVisibility @default(PUBLIC)
  evidence        Json?
  durationMinutes Int?
  createdAt       DateTime          @default(now())
  roadmapItem     RoadmapItem       @relation(fields: [roadmapItemId], references: [id], onDelete: Cascade)

  @@index([roadmapItemId, createdAt])
  @@index([visibility, createdAt])
}

model RoadmapTask {
  id            String            @id @default(uuid())
  roadmapItemId String
  title         String            @db.VarChar(191)
  description   String?           @db.Text
  status        RoadmapTaskStatus @default(PENDING)
  assigneeId    String?           @db.VarChar(191)
  dueAt         DateTime?
  completedAt   DateTime?
  createdBy     String            @db.VarChar(191)
  updatedBy     String            @db.VarChar(191)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  roadmapItem   RoadmapItem       @relation(fields: [roadmapItemId], references: [id], onDelete: Cascade)

  @@index([roadmapItemId, status])
  @@index([assigneeId, status])
  @@index([dueAt, status])
}

model RoadmapRelation {
  id            String              @id @default(uuid())
  roadmapItemId String
  type          RoadmapRelationType
  entityId      String              @db.VarChar(191)
  label         String?             @db.VarChar(191)
  createdBy     String              @db.VarChar(191)
  createdAt     DateTime            @default(now())
  roadmapItem   RoadmapItem         @relation(fields: [roadmapItemId], references: [id], onDelete: Cascade)

  @@unique([roadmapItemId, type, entityId])
  @@index([type, entityId])
}

model AccountSession {
  id           String    @id @default(uuid())
  accountId    String
  ipAddress    String?   @db.VarChar(80)
  userAgent    String?   @db.VarChar(255)
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?   @db.VarChar(191)
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([accountId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id           String    @id @default(uuid())
  accountId    String
  tokenHash    String    @unique @db.VarChar(191)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?
  requestIp    String?   @db.VarChar(80)
  requestAgent String?   @db.VarChar(255)
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([expiresAt])
}

model SupportTicket {
  id         String              @id @default(uuid())
  accountId  String
  assigneeId String?
  subject    String              @db.VarChar(191)
  category   String              @default("support") @db.VarChar(80)
  message    String              @db.Text
  response   String?             @db.Text
  status     SupportTicketStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  account    Account             @relation("TicketOwner", fields: [accountId], references: [id], onDelete: Cascade)
  assignee   Account?            @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([assigneeId])
  @@index([status])
}

model AccountModeration {
  id        String               @id @default(uuid())
  accountId String
  actorId   String?
  type      ModerationActionType
  reason    String               @db.Text
  expiresAt DateTime?
  createdAt DateTime             @default(now())
  account   Account              @relation("ModerationTarget", fields: [accountId], references: [id], onDelete: Cascade)
  actor     Account?             @relation("ModerationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([actorId])
  @@index([type])
}

model AccountPermission {
  id        String   @id @default(uuid())
  accountId String
  key       String   @db.VarChar(191)
  granted   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, key])
  @@index([accountId])
  @@index([key])
}

model AccountCurrency {
  id        String       @id @default(uuid())
  accountId String
  currency  CurrencyCode
  balance   Int          @default(0)
  account   Account      @relation(fields: [accountId], references: [id])

  @@unique([accountId, currency])
}

model AccountCharacter {
  id              String                 @id @default(uuid())
  accountId       String
  key             String                 @unique
  name            String                 @unique
  className       String
  level           Int                    @default(1)
  reset           Int                    @default(0)
  masterReset     Int                    @default(0)
  map             String                 @default("Lorencia")
  guild           String                 @default("-")
  pkStatus        String                 @default("Commoner")
  status          CharacterRuntimeStatus @default(OFFLINE)
  metadata        Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  account         Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  marketListings  PlayerMarketListing[]
  guildMembership GuildMember?

  @@index([accountId])
  @@index([className])
  @@index([status])
}

model AuditEvent {
  id            String      @id @default(uuid())
  module        String      @default("system") @db.VarChar(100)
  action        String      @db.VarChar(191)
  targetType    String      @db.VarChar(191)
  targetId      String?     @db.VarChar(191)
  actorId       String?
  actorUsername String?     @db.VarChar(191)
  actorRole     String?     @db.VarChar(40)
  targetUserId  String?     @db.VarChar(191)
  beforeData    Json?
  afterData     Json?
  reason        String?     @db.Text
  result        AuditResult @default(SUCCESS)
  severity      String      @default("info") @db.VarChar(40)
  ipAddress     String?     @db.VarChar(80)
  userAgent     String?     @db.VarChar(512)
  sessionId     String?     @db.VarChar(191)
  correlationId String?     @db.VarChar(80)
  metadata      Json?
  createdAt     DateTime    @default(now())
  actor         Account?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([module, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([correlationId])
  @@index([result, createdAt])
}

model AdminWorkLog {
  id              String        @id @default(uuid())
  userId          String
  username        String?       @db.VarChar(191)
  module          String        @db.VarChar(100)
  action          String        @db.VarChar(191)
  entityType      String        @db.VarChar(191)
  entityId        String?       @db.VarChar(191)
  taskId          String?       @db.VarChar(191)
  description     String        @db.Text
  startedAt       DateTime
  completedAt     DateTime?
  durationMinutes Int?
  evidence        Json?
  result          WorkLogResult @default(SUCCESS)
  correlationId   String?       @db.VarChar(80)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([module, createdAt])
  @@index([taskId])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@index([result, createdAt])
}

model SystemError {
  id              String                  @id @default(uuid())
  fingerprint     String                  @unique @db.VarChar(191)
  module          String                  @db.VarChar(100)
  severity        SystemErrorSeverity     @default(ERROR)
  errorCode       String?                 @db.VarChar(191)
  publicMessage   String                  @db.Text
  internalMessage String                  @db.Text
  stackTrace      String?                 @db.LongText
  correlationId   String?                 @db.VarChar(80)
  userId          String?                 @db.VarChar(191)
  accountId       String?                 @db.VarChar(191)
  entityType      String?                 @db.VarChar(191)
  entityId        String?                 @db.VarChar(191)
  requestPath     String?                 @db.VarChar(512)
  requestMethod   String?                 @db.VarChar(20)
  environment     String                  @default("production") @db.VarChar(40)
  occurrenceCount Int                     @default(1)
  firstOccurredAt DateTime                @default(now())
  lastOccurredAt  DateTime                @default(now())
  status          SystemErrorStatus       @default(NEW)
  assignedTo      String?                 @db.VarChar(191)
  resolution      String?                 @db.Text
  resolvedBy      String?                 @db.VarChar(191)
  resolvedAt      DateTime?
  taskId          String?                 @db.VarChar(191)
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  occurrences     SystemErrorOccurrence[]
  timeline        SystemErrorTimeline[]

  @@index([module, lastOccurredAt])
  @@index([severity, status])
  @@index([assignedTo, status])
  @@index([correlationId])
  @@index([entityType, entityId])
  @@index([taskId])
}

model SystemErrorOccurrence {
  id            String      @id @default(uuid())
  systemErrorId String
  correlationId String?     @db.VarChar(80)
  userId        String?     @db.VarChar(191)
  requestPath   String?     @db.VarChar(512)
  requestMethod String?     @db.VarChar(20)
  ipAddress     String?     @db.VarChar(80)
  userAgent     String?     @db.VarChar(512)
  metadata      Json?
  occurredAt    DateTime    @default(now())
  systemError   SystemError @relation(fields: [systemErrorId], references: [id], onDelete: Cascade)

  @@index([systemErrorId, occurredAt])
  @@index([correlationId])
}

model SystemErrorTimeline {
  id            String      @id @default(uuid())
  systemErrorId String
  actorUserId   String?     @db.VarChar(191)
  actorUsername String?     @db.VarChar(191)
  type          String      @db.VarChar(80)
  fromStatus    String?     @db.VarChar(40)
  toStatus      String?     @db.VarChar(40)
  description   String      @db.Text
  evidence      Json?
  createdAt     DateTime    @default(now())
  systemError   SystemError @relation(fields: [systemErrorId], references: [id], onDelete: Cascade)

  @@index([systemErrorId, createdAt])
  @@index([actorUserId, createdAt])
}

model OperationalEvent {
  id            String                   @id @default(uuid())
  module        String                   @db.VarChar(100)
  eventType     String                   @db.VarChar(191)
  severity      OperationalEventSeverity @default(INFO)
  entityType    String?                  @db.VarChar(191)
  entityId      String?                  @db.VarChar(191)
  actorUserId   String?                  @db.VarChar(191)
  targetUserId  String?                  @db.VarChar(191)
  correlationId String?                  @db.VarChar(80)
  description   String                   @db.Text
  data          Json?
  occurredAt    DateTime                 @default(now())

  @@index([module, occurredAt])
  @@index([eventType, occurredAt])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@index([severity, occurredAt])
}

model SystemAlert {
  id             String              @id @default(uuid())
  module         String              @db.VarChar(100)
  alertType      String              @db.VarChar(191)
  severity       SystemErrorSeverity
  title          String              @db.VarChar(255)
  message        String              @db.Text
  sourceType     String?             @db.VarChar(100)
  sourceId       String?             @db.VarChar(191)
  correlationId  String?             @db.VarChar(80)
  status         SystemAlertStatus   @default(OPEN)
  assignedTo     String?             @db.VarChar(191)
  acknowledgedBy String?             @db.VarChar(191)
  acknowledgedAt DateTime?
  resolvedBy     String?             @db.VarChar(191)
  resolvedAt     DateTime?
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, severity, createdAt])
  @@index([module, createdAt])
  @@index([assignedTo, status])
  @@index([sourceType, sourceId])
  @@index([correlationId])
}

model AdminLogExport {
  id              String            @id @default(uuid())
  requestedBy     String            @db.VarChar(191)
  requestedByName String?           @db.VarChar(191)
  source          String            @db.VarChar(80)
  format          String            @default("csv") @db.VarChar(20)
  filters         Json?
  status          AdminExportStatus @default(PENDING)
  recordCount     Int               @default(0)
  fileName        String?           @db.VarChar(255)
  checksum        String?           @db.VarChar(128)
  errorMessage    String?           @db.Text
  correlationId   String?           @db.VarChar(80)
  createdAt       DateTime          @default(now())
  completedAt     DateTime?
  expiresAt       DateTime?

  @@index([requestedBy, createdAt])
  @@index([source, status])
  @@index([correlationId])
}

model ObservabilityRetentionPolicy {
  id                String   @id @default(uuid())
  dataType          String   @unique @db.VarChar(80)
  retentionDays     Int
  immutableForAdmin Boolean  @default(false)
  enabled           Boolean  @default(true)
  updatedBy         String?  @db.VarChar(191)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SiteSetting {
  id          String          @id @default(uuid())
  key         String          @unique @db.VarChar(191)
  category    String          @default("general") @db.VarChar(100)
  label       String          @db.Text
  description String?         @db.Text
  value       Json
  isPublic    Boolean         @default(false)
  status      EditorialStatus @default(PUBLISHED)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category])
  @@index([isPublic])
  @@index([status])
}

model ReferenceSource {
  id        String           @id @default(uuid())
  key       String           @unique
  title     String           @db.Text
  baseUrl   String           @db.VarChar(512)
  publisher String?
  language  String?
  notes     String?          @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  entries   KnowledgeEntry[]
  assets    ReferenceAsset[]
}

model KnowledgeEntry {
  id             String                @id @default(uuid())
  sourceId       String?
  sourceKey      String?
  sourceUrl      String?               @db.Text
  canonicalKey   String                @unique @db.VarChar(512)
  slug           String
  title          String                @db.Text
  kind           KnowledgeEntryKind    @default(UNKNOWN)
  scope          KnowledgeScope        @default(NEEDS_REVIEW)
  status         EditorialStatus       @default(RAW)
  seasonMin      Int?
  seasonMax      Int?
  summary        String?               @db.Text
  rawData        Json?
  normalizedData Json?
  duplicateOfId  String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  source         ReferenceSource?      @relation(fields: [sourceId], references: [id])
  duplicateOf    KnowledgeEntry?       @relation("KnowledgeEntryDuplicates", fields: [duplicateOfId], references: [id])
  duplicates     KnowledgeEntry[]      @relation("KnowledgeEntryDuplicates")
  assets         KnowledgeEntryAsset[]

  @@index([kind])
  @@index([scope])
  @@index([status])
  @@index([sourceKey])
  @@index([slug])
}

model ReferenceAsset {
  id            String                @id @default(uuid())
  sourceId      String?
  sourceUrl     String?               @db.Text
  localPath     String                @db.VarChar(512)
  publicPath    String?               @db.VarChar(512)
  kind          ReferenceAssetKind    @default(IMAGE)
  mimeType      String?
  sha1          String?
  bytes         Int?
  status        EditorialStatus       @default(RAW)
  duplicateOfId String?
  metadata      Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  source        ReferenceSource?      @relation(fields: [sourceId], references: [id])
  duplicateOf   ReferenceAsset?       @relation("ReferenceAssetDuplicates", fields: [duplicateOfId], references: [id])
  duplicates    ReferenceAsset[]      @relation("ReferenceAssetDuplicates")
  entries       KnowledgeEntryAsset[]

  @@unique([localPath])
  @@index([sha1])
  @@index([kind])
  @@index([status])
  @@index([sourceId])
}

model KnowledgeEntryAsset {
  entryId   String
  assetId   String
  role      String         @default("reference")
  sortOrder Int            @default(0)
  entry     KnowledgeEntry @relation(fields: [entryId], references: [id])
  asset     ReferenceAsset @relation(fields: [assetId], references: [id])

  @@id([entryId, assetId, role])
  @@index([assetId])
}

model EquipmentRecord {
  id           String               @id @default(uuid())
  key          String               @unique @db.VarChar(255)
  name         String               @db.Text
  title        String               @db.Text
  category     String
  categorySlug String
  group        EquipmentGroup       @default(MISC)
  baseSetName  String?
  sourceUrl    String?              @db.Text
  minSeason    Int                  @default(1)
  status       EditorialStatus      @default(NORMALIZED)
  rawData      Json?
  remapData    Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  variants     EquipmentVariant[]
  pieces       EquipmentPiece[]
  options      EquipmentOption[]
  classLinks   EquipmentClassLink[]
  seasons      EquipmentSeason[]

  @@index([categorySlug])
  @@index([group])
  @@index([minSeason])
  @@index([status])
}

model GameCharacter {
  id              String               @id @default(uuid())
  key             String               @unique
  name            String
  sortOrder       Int                  @default(0)
  minSeason       Int                  @default(1)
  isSeasonSixBase Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  classes         GameClass[]
  equipmentLinks  EquipmentClassLink[]

  @@index([sortOrder])
  @@index([minSeason])
  @@index([isSeasonSixBase])
}

model GameClass {
  id              String               @id @default(uuid())
  characterId     String
  key             String               @unique
  name            String
  tier            Int                  @default(1)
  minSeason       Int                  @default(1)
  isSeasonSixBase Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  character       GameCharacter        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  equipmentLinks  EquipmentClassLink[]

  @@index([characterId])
  @@index([tier])
  @@index([minSeason])
  @@index([isSeasonSixBase])
}

model EquipmentClassLink {
  equipmentId String
  classId     String
  characterId String
  role        EquipmentClassLinkRole @default(PLAYABLE)
  source      String                 @default("remap")
  createdAt   DateTime               @default(now())
  equipment   EquipmentRecord        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  class       GameClass              @relation(fields: [classId], references: [id], onDelete: Cascade)
  character   GameCharacter          @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([equipmentId, classId, role])
  @@index([classId])
  @@index([characterId])
  @@index([role])
}

model EquipmentSeason {
  id          String          @id @default(uuid())
  equipmentId String
  season      Int
  visibility  KnowledgeScope  @default(NEEDS_REVIEW)
  source      String          @default("remap")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  equipment   EquipmentRecord @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([equipmentId, season])
  @@index([season])
  @@index([visibility])
}

model EquipmentVariant {
  id          String           @id @default(uuid())
  equipmentId String
  quality     EquipmentQuality
  minSeason   Int              @default(1)
  data        Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  equipment   EquipmentRecord  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([equipmentId, quality])
  @@index([quality])
  @@index([minSeason])
}

model EquipmentPiece {
  id          String          @id @default(uuid())
  equipmentId String
  name        String          @db.Text
  slot        String
  imagePath   String?
  data        Json?
  sortOrder   Int             @default(0)
  equipment   EquipmentRecord @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([slot])
}

model EquipmentOption {
  id          String          @id @default(uuid())
  equipmentId String
  scope       String
  label       String          @db.Text
  data        Json?
  sortOrder   Int             @default(0)
  equipment   EquipmentRecord @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([scope])
}

model ShopProduct {
  id                 String               @id @default(uuid())
  key                String               @unique
  slug               String               @unique
  name               String
  short              String
  category           String
  categoryId         String?
  summary            String?              @db.Text
  description        String               @db.LongText
  price              Int                  @default(0)
  currency           CurrencyCode
  status             ShopProductStatus    @default(DRAFT)
  stock              Int?
  images             Json?
  featured           Boolean              @default(false)
  deliveryTarget     StoreDeliveryTarget  @default(ACCOUNT)
  accountLimit       Int?
  periodLimit        Int?
  periodDays         Int?
  saleStartsAt       DateTime?
  saleEndsAt         DateTime?
  scheduledPublishAt DateTime?
  publishedAt        DateTime?
  archivedAt         DateTime?
  deletedAt          DateTime?
  deletedBy          String?
  deletionReason     String?              @db.Text
  technicalCode      String?
  sourceOrigin       String?
  ambiguous          Boolean              @default(false)
  internalNotes      String?              @db.Text
  revisionReason     String?              @db.Text
  createdBy          String?
  updatedBy          String?
  reviewedBy         String?
  approvedBy         String?
  publishedBy        String?
  reviewedAt         DateTime?
  approvedAt         DateTime?
  version            Int                  @default(1)
  sortOrder          Int                  @default(0)
  metadata           Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  categoryRecord     StoreCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants           ShopProductVariant[]
  purchases          PurchaseIntent[]

  @@index([category])
  @@index([categoryId])
  @@index([currency])
  @@index([status, publishedAt])
  @@index([featured, status])
  @@index([status, sortOrder])
  @@index([deletedAt])
}

model StoreCategory {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?       @db.Text
  image       String?
  sortOrder   Int           @default(0)
  active      Boolean       @default(true)
  archivedAt  DateTime?
  deletedAt   DateTime?
  deletedBy   String?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  products    ShopProduct[]

  @@index([active, sortOrder])
  @@index([deletedAt])
}

model ShopProductVariant {
  id              String               @id @default(uuid())
  productId       String
  name            String
  sku             String               @unique
  durationSeconds Int?
  quantity        Int                  @default(1)
  itemLevel       Int?
  options         Json?
  price           Int
  currency        CurrencyCode
  stock           Int?
  available       Boolean              @default(true)
  accountLimit    Int?
  periodLimit     Int?
  periodDays      Int?
  deliveryTarget  StoreDeliveryTarget?
  sortOrder       Int                  @default(0)
  technicalData   Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  product         ShopProduct          @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchases       PurchaseIntent[]

  @@index([productId, available, sortOrder])
  @@index([currency])
}

model RechargePackage {
  id        String           @id @default(uuid())
  key       String           @unique
  currency  CurrencyCode
  amount    Int
  bonus     Int              @default(0)
  price     String
  highlight Boolean          @default(false)
  active    Boolean          @default(true)
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  recharges RechargeIntent[]

  @@index([currency])
  @@index([active])
}

model PurchaseIntent {
  id                     String               @id @default(uuid())
  accountId              String
  productId              String
  variantId              String?
  destinationCharacterId String?
  quantity               Int                  @default(1)
  price                  Int
  currency               CurrencyCode
  status                 PurchaseIntentStatus @default(PREPARED)
  correlationId          String               @unique
  internalNotes          String?              @db.Text
  manualReviewReason     String?              @db.Text
  refundReason           String?              @db.Text
  refundedBy             String?
  refundedAt             DateTime?
  cancelledBy            String?
  cancelledAt            DateTime?
  completedAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  account                Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product                ShopProduct          @relation(fields: [productId], references: [id])
  variant                ShopProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  deliveries             StoreDelivery[]
  notes                  StoreOrderNote[]

  @@index([accountId])
  @@index([productId])
  @@index([variantId])
  @@index([status])
  @@index([createdAt])
}

model StoreDelivery {
  id            String              @id @default(uuid())
  purchaseId    String
  status        StoreDeliveryStatus @default(WAITING)
  target        StoreDeliveryTarget
  accountId     String
  characterId   String?
  itemCode      String?
  itemName      String
  quantity      Int                 @default(1)
  attempts      Int                 @default(0)
  maxAttempts   Int                 @default(3)
  lastError     String?             @db.Text
  correlationId String              @unique
  assignedTo    String?
  reprocessedBy String?
  processingAt  DateTime?
  completedAt   DateTime?
  failedAt      DateTime?
  refundedAt    DateTime?
  evidence      Json?
  metadata      Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  purchase      PurchaseIntent      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([purchaseId])
  @@index([accountId])
  @@index([assignedTo, status])
}

model StoreOrderNote {
  id         String         @id @default(uuid())
  purchaseId String
  authorId   String
  authorName String
  content    String         @db.Text
  evidence   Json?
  createdAt  DateTime       @default(now())
  purchase   PurchaseIntent @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId, createdAt])
}

model StoreProductTest {
  id            String    @id @default(uuid())
  productId     String
  variantId     String?
  testAccountId String
  testCharacter String?
  environment   String
  status        String
  result        Json?
  rollbackData  Json?
  correlationId String    @unique
  createdBy     String
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([productId, createdAt])
  @@index([testAccountId, createdAt])
}

model RechargeIntent {
  id                    String                @id @default(uuid())
  accountId             String
  packageId             String
  currency              CurrencyCode
  amount                Int
  bonus                 Int                   @default(0)
  price                 String
  status                RechargeIntentStatus  @default(PREPARED)
  provider              String                @default("mercadopago") @db.VarChar(40)
  // Audit-chain id for the whole Blood Moon operation. Kept deliberately
  // separate from externalReference/paymentIdempotencyKey below -- their
  // values coincide today but they are different concepts (see those
  // fields' comments) so retries/refunds/other providers don't need a
  // schema change later.
  correlationId         String?               @unique @db.VarChar(80)
  // Value sent to the payment provider as external_reference and matched
  // back against on webhook receipt.
  externalReference     String?               @unique @db.VarChar(191)
  // Value sent as X-Idempotency-Key for the create-order call specifically.
  paymentIdempotencyKey String?               @unique @db.VarChar(191)
  externalOrderId       String?               @db.VarChar(191)
  externalStatus        String?               @db.VarChar(80)
  externalStatusDetail  String?               @db.VarChar(191)
  paymentMethod         String?               @db.VarChar(60)
  failureReason         String?               @db.VarChar(191)
  manualReviewReason    String?               @db.Text
  refundReason          String?               @db.Text
  lastWebhookAt         DateTime?
  approvedAt            DateTime?
  refundedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  account               Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  package               RechargePackage       @relation(fields: [packageId], references: [id])
  webhookEvents         PaymentWebhookEvent[]

  @@index([accountId])
  @@index([packageId])
  @@index([status])
  @@index([externalOrderId])
}

model PaymentWebhookEvent {
  id               String          @id @default(uuid())
  provider         String          @db.VarChar(40)
  topic            String          @db.VarChar(80)
  eventId          String          @db.VarChar(191)
  externalOrderId  String?         @db.VarChar(191)
  rechargeIntentId String?
  signatureValid   Boolean
  signatureHeader  String?         @db.Text
  status           String          @default("RECEIVED") @db.VarChar(40)
  rawPayload       Json
  processingError  String?         @db.Text
  receivedAt       DateTime        @default(now())
  processedAt      DateTime?
  rechargeIntent   RechargeIntent? @relation(fields: [rechargeIntentId], references: [id], onDelete: SetNull)

  @@unique([provider, topic, eventId])
  @@index([externalOrderId])
  @@index([rechargeIntentId])
  @@index([status, receivedAt])
}

model PlayerMarketListing {
  id                String                   @id @default(uuid())
  sellerAccountId   String
  sellerCharacterId String?
  gameItemRef       String                   @db.VarChar(255)
  itemName          String
  itemCategory      String
  itemData          Json
  price             Int
  currency          CurrencyCode
  status            MarketplaceListingStatus @default(ESCROW_PENDING)
  lockJobId         String?
  lockedAt          DateTime?
  expiresAt         DateTime?
  soldAt            DateTime?
  cancelledAt       DateTime?
  metadata          Json?
  adminNotes        String?                  @db.Text
  moderationReason  String?                  @db.Text
  suspendedBy       String?                  @db.VarChar(191)
  suspendedAt       DateTime?
  returnedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  seller            Account                  @relation("MarketplaceSeller", fields: [sellerAccountId], references: [id], onDelete: Cascade)
  sellerCharacter   AccountCharacter?        @relation(fields: [sellerCharacterId], references: [id])
  orders            PlayerMarketOrder[]
  bridgeJobs        GameBridgeJob[]
  escrow            MarketplaceEscrow?
  reports           MarketplaceReport[]
  tasks             MarketplaceTask[]

  @@unique([gameItemRef])
  @@index([sellerAccountId])
  @@index([sellerCharacterId])
  @@index([currency])
  @@index([status])
  @@index([createdAt])
}

model PlayerMarketOrder {
  id             String                 @id @default(uuid())
  listingId      String
  buyerAccountId String
  price          Int
  currency       CurrencyCode
  status         MarketplaceOrderStatus @default(PREPARED)
  fee            Int                    @default(0)
  sellerAmount   Int                    @default(0)
  correlationId  String                 @unique @db.VarChar(80)
  paidAt         DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  listing        PlayerMarketListing    @relation(fields: [listingId], references: [id])
  buyer          Account                @relation("MarketplaceBuyer", fields: [buyerAccountId], references: [id], onDelete: Cascade)
  bridgeJobs     GameBridgeJob[]
  reports        MarketplaceReport[]
  tasks          MarketplaceTask[]

  @@index([listingId])
  @@index([buyerAccountId])
  @@index([currency])
  @@index([status])
  @@index([createdAt])
}

model MarketplaceEscrow {

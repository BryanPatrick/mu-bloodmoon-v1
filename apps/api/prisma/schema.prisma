model RechargeIntent {
  id                    String                @id @default(uuid())
  accountId             String
  packageId             String
  currency              CurrencyCode
  amount                Int
  bonus                 Int                   @default(0)
  price                 String
  status                RechargeIntentStatus  @default(PREPARED)
  provider              String                @default("mercadopago") @db.VarChar(40)
  providerEnvironment   String                @default("production") @db.VarChar(20)
  providerCreateState   ProviderCreateState   @default(NONE)
  // Audit-chain id for the whole Blood Moon operation. Kept deliberately
  // separate from externalReference/paymentIdempotencyKey below -- their
  // values coincide today but they are different concepts (see those
  // fields' comments) so retries/refunds/other providers don't need a
  // schema change later.
  correlationId         String?               @unique @db.VarChar(80)
  // Value sent to the payment provider as external_reference and matched
  // back against on webhook receipt.
  externalReference     String?               @unique @db.VarChar(191)
  // Value sent as X-Idempotency-Key for the create-order call specifically.
  paymentIdempotencyKey String?               @unique @db.VarChar(191)
  externalOrderId       String?               @db.VarChar(191)
  externalStatus        String?               @db.VarChar(80)
  externalStatusDetail  String?               @db.VarChar(191)
  paymentMethod         String?               @db.VarChar(60)
  failureReason         String?               @db.VarChar(191)
  manualReviewReason    String?               @db.Text
  refundReason          String?               @db.Text
  lastWebhookAt         DateTime?
  approvedAt            DateTime?
  refundedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  account               Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  package               RechargePackage       @relation(fields: [packageId], references: [id])
  webhookEvents         PaymentWebhookEvent[]
  chargebackCase        ChargebackCase?

  @@index([accountId])
  @@index([packageId])
  @@index([status])
  @@unique([provider, providerEnvironment, externalOrderId])
}


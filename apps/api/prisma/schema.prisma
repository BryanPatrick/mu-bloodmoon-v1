  @@unique([provider, topic, eventId])
  @@index([externalOrderId])
  @@index([rechargeIntentId])
  @@index([status, receivedAt])
  @@index([provider, status, nextAttemptAt, leaseExpiresAt], map: "PaymentWebhookEvent_inbox_claim_idx")

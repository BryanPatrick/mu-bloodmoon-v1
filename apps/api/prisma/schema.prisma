model Account {
  id                        String                      @id @default(uuid())
  username                  String                      @unique
  name                      String
  email                     String                      @unique
  passwordHash              String
  personalIdHash            String?
  sessionVersion            Int                         @default(0)
  twoFactorEnabled          Boolean                     @default(false)
  twoFactorSecret           String?                     @db.Text
  twoFactorPending          String?                     @db.Text
  role                      Role                        @default(PLAYER)
  status                    AccountStatus               @default(PENDING)
  accountPhase              AccountPhase                @default(PRE_BETA)
  // Phase 14 Part D. Set only by NORMAL_ACCOUNT_DELETION (account-deletion.service.ts),
  // alongside status=BLOCKED, to distinguish "deleted/anonymized" from an
  // ordinary moderation block without a schema-wide AccountStatus.DELETED
  // migration -- deliberate minimal choice, documented in
  // docs/accounts/account-deletion-architecture.md's "Schema additions" section.
  deletedAt                 DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  currencies                AccountCurrency[]
  auditEvents               AuditEvent[]                @relation("AuditActor")
  purchases                 PurchaseIntent[]
  recharges                 RechargeIntent[]
  billingProfile            BillingProfile?
  providerCustomers         ProviderCustomer[]
  characters                AccountCharacter[]
  guildsFounded             Guild[]                     @relation("GuildFounder")
  guildMemberships          GuildMember[]               @relation("GuildMemberAccount")
  marketListings            PlayerMarketListing[]       @relation("MarketplaceSeller")
  marketOrders              PlayerMarketOrder[]         @relation("MarketplaceBuyer")
  marketplaceReports        MarketplaceReport[]         @relation("MarketplaceReporter")
  communityProfile          CommunityProfile?
  communityPosts            CommunityPost[]             @relation("CommunityPostAuthor")
  communityComments         CommunityComment[]          @relation("CommunityCommentAuthor")
  communityReactions        CommunityReaction[]
  communityReports          CommunityReport[]           @relation("CommunityReporter")
  reportedCommunity         CommunityReport[]           @relation("CommunityReportedUser")
  achievementGrants         CommunityAchievementGrant[]
  badgeGrants               CommunityBadgeGrant[]
  questProgress             CommunityQuestParticipant[]
  bridgeJobs                GameBridgeJob[]
  permissions               AccountPermission[]
  supportTickets            SupportTicket[]             @relation("TicketOwner")
  assignedTickets           SupportTicket[]             @relation("TicketAssignee")
  moderationActions         AccountModeration[]         @relation("ModerationTarget")
  moderationIssued          AccountModeration[]         @relation("ModerationActor")
  sessions                  AccountSession[]
  passwordResetTokens       PasswordResetToken[]
  adminTasksAssigned        AdminTask[]                 @relation("AdminTaskAssignee")
  adminTasksAssignedBy      AdminTask[]                 @relation("AdminTaskAssigner")
  adminTasksCreated         AdminTask[]                 @relation("AdminTaskCreator")
  adminTaskComments         AdminTaskComment[]
  adminTaskEvidence         AdminTaskEvidence[]
  twoFactorRecoveryCodes    TwoFactorRecoveryCode[]
  gmOccurrencesCreated      GmOccurrence[]              @relation("GmOccurrenceCreatedBy")
  gmOccurrencesAssigned     GmOccurrence[]              @relation("GmOccurrenceAssignedTo")
  gmOccurrenceNotes         GmOccurrenceNote[]
  betaParticipationRecordsRecorded BetaParticipationRecord[] @relation("BetaParticipationRecordedBy")
  bugReportsOwned           BugReport[]                 @relation("BugReportOwner")
  bugReportsAssigned        BugReport[]                 @relation("BugReportAssignee")
  bugReportEvents           BugReportEvent[]            @relation("BugReportEventActor")
  gmEventDefinitionsCreated GmEventDefinition[]         @relation("GmEventDefinitionCreatedBy")
  gmEventRunsStarted        GmEventRun[]                @relation("GmEventRunStartedBy")
  gmEventRunsEnded          GmEventRun[]                @relation("GmEventRunEndedBy")
  gmEventRunsCancelled      GmEventRun[]                @relation("GmEventRunCancelledBy")
  gmEventResultsCreated     GmEventResult[]             @relation("GmEventResultCreatedBy")
  gmEventResultsValidated   GmEventResult[]             @relation("GmEventResultValidatedBy")
  gameIdentity              GameAccountIdentity?
  gameCredential            GameAccountCredential?
  termsAcceptances          AccountTermsAcceptance[]
  vipEntitlement            VipEntitlement?
  vipSyncState              VipSyncState?
  walletLedgerEntries       WalletLedgerEntry[]         @relation("WalletLedgerOwner")
  walletLedgerCounterparty  WalletLedgerEntry[]         @relation("WalletLedgerCounterparty")
  paymentRiskSignals        PaymentRiskSignal[]
  paymentRiskCases          PaymentRiskCase[]
  chargebackCases           ChargebackCase[]
}

// Phase 14 Part D. NORMAL_ACCOUNT_DELETION's tombstone metadata --
// deliberately NOT a relation field on Account (same no-hard-FK pattern
// BetaRewardEntitlement.originalAccountId already established in Phase 13),
// since the Account row it describes is never deleted, only anonymized in
// place. Never carries passwordHash, twoFactorSecret, session tokens, or
// 2FA recovery codes -- those are deleted outright by
// account-deletion.service.ts, not tombstoned here in any form, hashed or
// otherwise. See docs/accounts/account-deletion-architecture.md.
model AccountDeletionRecord {
  id                String   @id @default(uuid())
  accountId         String   @unique
  deletionMode      String   @db.VarChar(40) // always "NORMAL_ACCOUNT_DELETION" -- kept as a string, not sharing PurgeBatchRecord's enum-of-one, so the two models never get confused for each other
  requestedBy       String
  requestedAt       DateTime @default(now())
  completedAt       DateTime?
  reason            String?  @db.Text
  originalUsernameHash String @db.VarChar(191)
  originalEmailHash String   @db.VarChar(191)

  @@index([originalEmailHash])
}

// Phase 15. Self-service account deletion for real (OPEN_BETA/OFFICIAL)
// players: request -> strong confirmation (emailed token, same pattern as
// PasswordResetToken) -> grace period -> execution via the existing
// NORMAL_ACCOUNT_DELETION path (account-deletion.service.ts), never a new
// deletion mechanism. Per Bryan: "fluxo de solicitacao -> confirmacao
// forte -> periodo/estado de exclusao -> execucao." Deliberately NOT a
// relation field on Account (same no-hard-FK precedent as
// AccountDeletionRecord/BetaRewardEntitlement) -- accountId is unique so
// only one active request can exist per account at a time.
enum AccountDeletionRequestStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  EXECUTED
}

model AccountDeletionRequest {
  id                   String                       @id @default(uuid())
  accountId            String                       @unique
  tokenHash            String                       @unique @db.VarChar(191)
  status               AccountDeletionRequestStatus @default(REQUESTED)
  requestedAt          DateTime                     @default(now())
  requestIp            String?                      @db.VarChar(80)
  requestAgent         String?                      @db.VarChar(255)
  confirmedAt          DateTime?
  scheduledExecutionAt DateTime?
  executedAt           DateTime?
  cancelledAt          DateTime?

  @@index([status, scheduledExecutionAt])
}

// Bryan's 2026-08-30 follow-up: structured exit feedback for the
// self-service account deletion flow (docs/accounts/account-deletion-architecture.md).
// accountId is nullable and unindexed as a FK on purpose -- this row must
// survive account anonymization (see AccountDeletionService.executeNormalDeletion,
// which unlinks accountId to null and stamps anonymizedAt rather than
// deleting the row). No @relation to Account by design -- PRE_BETA_PURGE's
// real hard `account.delete()` must never be blocked by a dangling
// reference from analytics data that carries zero financial/legal weight.
model AccountDeletionFeedback {
  id                  String    @id @default(uuid())
  accountId           String?
  reasons             Json
  otherText           String?   @db.VarChar(2000)
  // Phase K (2026-08-30) Part 12: ExitRetentionInteraction shape
  // (account-deletion.contract.ts) -- observational only, never read back
  // to gate anything; survives anonymization the same way `reasons` does.
  retentionInteraction Json?
  submittedAt         DateTime  @default(now())
  anonymizedAt        DateTime?

  @@index([accountId])
}

// Phase 14 Part D. PRE_BETA_PURGE's operational record -- intentionally a
// DIFFERENT shape from AccountDeletionRecord: batch-level only, no
// per-user tombstone, because purged accounts were never real players
// (eligibility already required zero financial/legal weight before this
// row is ever written). accountIdsPurged is safe to keep verbatim (not
// hashed) precisely because these were disposable pre-Beta identifiers,
// not real player PII.
model PurgeBatchRecord {
  id               String   @id @default(uuid())
  betaCycleId      String   @db.VarChar(80)
  requestedBy      String
  executedAt       DateTime @default(now())
  accountCount     Int
  accountIdsPurged Json

  @@index([betaCycleId])
}

// Open Beta P0 foundation (Part L). Versioned, auditable acceptance record
// -- deliberately NOT a bare `acceptedTerms: Boolean` on Account, since
// that can't answer "which version, when." `termsKey` distinguishes
// different documents (the Open Beta notice vs. a future general ToS)
// that may each version independently. ipAddress is optional and kept
// minimal -- exactly the same discipline AccountSession already applies
// elsewhere in this schema (real, precedented pattern, not a new one).
model AccountTermsAcceptance {
  id           String   @id @default(uuid())
  accountId    String
  termsKey     String   @db.VarChar(80)
  termsVersion Int
  acceptedAt   DateTime @default(now())
  ipAddress    String?  @db.VarChar(80)
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, termsKey])
}

// Phase 3B. The Portal-side half of the Unified Blood Moon Account model
// (docs/game-data/unified-account.md,
// docs/game-data/game-account-provisioning-contract.md). Maps a
// canonical Account to its representation in the legacy MU game
// database -- never a second account, never an authority in its own
// right (see unified-account.md's "Identity authority" section).
//
// No GameBridge command is implemented yet (Phase 3C+) -- this model is
// pure Portal-side scaffolding, safe to create with zero rows ever
// reaching ACTIVE. GAME_WRITES_PERFORMED stays 0.
//
// Never stores a game password/credential in any form -- see
// unified-account.md's Password strategy section for why a generated
// game credential (if one is ever needed) must live in its own,
// separately-scoped, rotatable store, never here.
model GameAccountIdentity {
  id                    String                 @id @default(uuid())
  accountId             String                 @unique
  membGuid              Int?                   @unique
  legacyLogin           String?                @unique @db.VarChar(10)
  provisioningStatus    GameProvisioningStatus @default(PENDING)
  provisioningRequestId String                 @unique
  provisionedAt         DateTime?
  lastErrorCode         String?                @db.VarChar(191)
  lastAttemptAt         DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  account               Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([provisioningStatus])
}

// Phase 3D-A. Encrypted MU-only technical credential. This relation is never
// selected by player/Admin/Discord/Launcher DTOs. Key material is external;
// only the authenticated AES-GCM envelope is persisted here.
model GameAccountCredential {
  id                String    @id @default(uuid())
  accountId         String    @unique
  commandId         String    @unique
  legacyLogin       String    @unique @db.VarChar(10)
  ciphertext        String    @db.Text
  nonce             String    @db.VarChar(64)
  tag               String    @db.VarChar(64)
  keyVersion        String    @db.VarChar(20)
  algorithm         String    @db.VarChar(40)
  envelopeCreatedAt DateTime
  commandExpiresAt  DateTime
  createdAt         DateTime  @default(now())
  rotatedAt         DateTime?
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([keyVersion])
}

// Phase 3B Part L/W. Launcher remote content already has a real home:
// SiteSetting (category launcher/server/social) + KnowledgeEntry (kind
// NEWS/EVENT) -- see LauncherService.bootstrap(), already shipped before
// this phase. No new content models are added here; reusing what exists
// beats a parallel CMS (docs/launcher/remote-content-contract.md
// documents the existing shape instead of inventing a second one).

// Phase 3B Part R/S. A dedicated, revocable service credential for the
// Discord read-only integration -- never the Launcher's user session,
// never a SUPER_ADMIN JWT, never the GameBridge HMAC secret
// (docs/integrations/discord-read-api.md). Only a hash is ever stored,
// matching PasswordResetToken's existing pattern -- the raw key is shown
// to the operator exactly once, at creation, and never again.
model DiscordServiceCredential {
  id         String    @id @default(uuid())
  label      String    @db.VarChar(191) // operator-facing name, e.g. "prod-bot-2026"
  keyHash    String    @unique @db.VarChar(191)
  scopes     String    @db.VarChar(191) // comma-separated: discord:server:read,discord:events:read,...
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([revokedAt])
}

model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  accountId String
  codeHash  String    @db.VarChar(191)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, usedAt])
}

model AdminTask {
  id               String              @id @default(uuid())
  title            String              @db.VarChar(191)
  description      String              @db.LongText
  module           String              @db.VarChar(100)
  type             String              @db.VarChar(100)
  priority         AdminTaskPriority   @default(NORMAL)
  complexity       AdminTaskComplexity @default(STANDARD)
  status           AdminTaskStatus     @default(OPEN)
  assignedTo       String?
  assignedBy       String?
  createdBy        String
  dueAt            DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  estimatedMinutes Int?
  actualMinutes    Int?
  entityType       String?             @db.VarChar(191)
  entityId         String?             @db.VarChar(191)
  errorId          String?             @db.VarChar(191)
  reportId         String?             @db.VarChar(191)
  internalNotes    String?             @db.LongText
  result           String?             @db.LongText
  approvalRequired Boolean             @default(false)
  reviewedBy       String?             @db.VarChar(191)
  reviewedAt       DateTime?
  reviewReason     String?             @db.Text
  reopenedCount    Int                 @default(0)
  rejectedCount    Int                 @default(0)
  sourceTaskType   String?             @db.VarChar(100)
  sourceTaskId     String?             @db.VarChar(191)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  assignee         Account?            @relation("AdminTaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

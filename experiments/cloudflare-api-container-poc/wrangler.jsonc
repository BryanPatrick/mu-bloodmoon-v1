{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "blood-moon-api-container-poc",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "containers": [
    {
      "class_name": "BloodMoonApiContainer",
      "image": "../../Dockerfile.cloudflare-poc",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BLOOD_MOON_API",
        "class_name": "BloodMoonApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BloodMoonApiContainer"]
    }
  ]
}

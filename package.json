{
  "name": "blood-moon-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "nuxt dev apps/web",
    "build": "nuxt build apps/web && node scripts/patch-nitro-output.mjs",
    "generate": "nuxt generate apps/web",
    "preview": "nuxt preview apps/web/.output",
    "web:dev": "nuxt dev apps/web",
    "web:build": "nuxt build apps/web && node scripts/patch-nitro-output.mjs",
    "web:generate": "nuxt generate apps/web",
    "web:preview": "nuxt preview apps/web/.output",
    "web:test:error": "node --test apps/web/test/error-presentation.test.mjs",
    "web:test:smoke": "node --test apps/web/test/commercial-experience.test.mjs apps/web/test/error-presentation.test.mjs apps/web/test/public-pages-smoke.test.mjs apps/web/test/community-left-rail-view.test.mjs apps/web/test/community-auth-ssr.test.mjs apps/web/test/rbac-gm-role.test.mjs",
    "dev:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "dev:full:import": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev.ps1 -ImportData",
    "api:check": "npm --workspace @blood-moon/api run check",
    "api:build": "npm --workspace @blood-moon/api run build",
    "api:dev": "npm --workspace @blood-moon/api run dev",
    "api:test:e2e": "npm --workspace @blood-moon/api run test:e2e",
    "api:test:beta": "npm --workspace @blood-moon/api run test:beta",
    "test:beta": "npm run web:build && npm run api:test:beta && npm run web:test:smoke",
    "launcher:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-launcher.ps1",
    "launcher:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-launcher.ps1 -Publish",
    "launcher:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-launcher.ps1 -Preview",
    "game-bridge-agent:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-game-bridge-agent.ps1",
    "game-bridge-agent:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-game-bridge-agent.ps1 -Test",
    "game-bridge-agent:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-game-bridge-agent.ps1 -Publish",
    "game-data-worker:dev": "npm run dev --workspace=apps/game-data-worker",
    "game-data-worker:test": "npm run test --workspace=apps/game-data-worker",
    "game-data-worker:typecheck": "npm run typecheck --workspace=apps/game-data-worker",
    "patch:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Publish-BloodMoonPatch.ps1",
    "db:setup": "node scripts/setup-mysql.mjs",
    "db:import": "node apps/api/scripts/import-prepared-data.mjs",
    "data:remap-equipment": "node scripts/extract-guiamu-ancient-sets.mjs && node scripts/remap-equipment-database.mjs && node apps/api/scripts/prepare-equipment-import.mjs",
    "data:check-equipment": "node scripts/check-equipment-catalog.mjs",
    "data:import-muserver": "node scripts/import-muserver-backup.mjs",
    "data:prepare-source-import": "node apps/api/scripts/prepare-source-harvest-import.mjs",
    "web-source:catalog": "node scripts/catalog-web-source-backup.mjs",
    "web-source:normalize": "node scripts/normalize-web-source-catalog.mjs",
    "figma:manifest": "node scripts/build-figma-asset-manifest.mjs",
    "deploy:cpanel:package": "npm run api:build && npm run web:build && node scripts/package-cpanel-deploy.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality:changed": "node scripts/quality-changed.mjs",
    "check": "npm run lint && npm run format:check && npm run data:check-equipment && npm run api:check && npm run web:build",
    "postinstall": "nuxt prepare apps/web"
  },
  "dependencies": {
    "@nuxt/ui": "^4.0.0",
    "@pinia/nuxt": "^1.0.1",
    "lucide-vue-next": "^0.468.0",
    "nuxt": "^4.4.8",
    "pinia": "^4.0.2",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.114",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.66.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "unrs-resolver@1.12.2": true,
    "vue-demi@0.14.10": true,
    "@nestjs/core@10.4.22": true,
    "@parcel/watcher@2.5.6": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "workerd@1.20241230.0": true,
    "workerd@1.20250718.0": true,
    "esbuild@0.17.19": true,
    "esbuild@0.21.5": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "sharp@0.33.5": true,
    "sharp@0.34.5": true
  }
}
